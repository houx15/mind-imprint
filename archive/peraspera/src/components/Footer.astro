---
import Icon from "./Icon.astro";
import { getLang, t, localePath } from "../i18n/utils";
import { brand, nav, footer } from "../content/site";

const lang = getLang(Astro.currentLocale);
---
<footer class="site-foot">
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="brand" href={localePath(lang, "/")}>{t(lang, brand.zh, brand.en)}</a>
      <p class="foot-disclaimer">{t(lang, footer.disclaimer.zh, footer.disclaimer.en)}</p>
    </div>
    <div class="foot-cols">
      <div class="foot-col">
        <h5>{t(lang, "导航", "Navigate")}</h5>
        <a href={localePath(lang, "/coaching")}>{t(lang, nav.coaching.zh, nav.coaching.en)}</a>
        <a href={localePath(lang, "/academy")}>{t(lang, nav.academy.zh, nav.academy.en)}</a>
        <a href={localePath(lang, "/partnership")}>{t(lang, nav.partnership.zh, nav.partnership.en)}</a>
        <a href={localePath(lang, "/about")}>{t(lang, nav.about.zh, nav.about.en)}</a>
        <a href={localePath(lang, "/contact")}>{t(lang, nav.contact.zh, nav.contact.en)}</a>
      </div>
      <div class="foot-col">
        <h5>{t(lang, "联系", "Contact")}</h5>
        <a class="foot-contact" href="mailto:hello@peraspera.org"><Icon name="mail" /> {t(lang, footer.contact.zh, footer.contact.en)}</a>
        <div class="foot-social" aria-label={t(lang, "社交媒体", "Social")}>
          <a href="#" class="soc">Instagram</a>
          <a href="#" class="soc">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
  <div class="foot-bottom">
    <span>{t(lang, footer.copyright.zh, footer.copyright.en)}</span>
  </div>
</footer>
