{
  "id": "corpus-hook",
  "category": "溯源与多视角",
  "name": "语料钩子卡（含精问阅读推荐）",
  "name_en": "Corpus Hooks & Curated Reading",
  "purpose": "教师/课程设计者提前在语料里「埋钩子」：学生读/看到特定位置，AI 自动触发追问；并按学生兴趣，从预设语料库推荐精问阅读卡片",
  "trigger_condition": "学生在教师预设的语料（视频/音频/文本）中阅读到特定位置，或需要在语料边界内深入",
  "trigger_keywords": ["阅读材料", "视频到这", "读到这里", "推荐", "还有什么可读", "语料"],
  "priority": "P1",
  "disclosure_tier": "tier-2",
  "age_band": ["MYP", "DP"],
  "interaction_type": "步骤引导卡",
  "rubric_dims": ["D1", "D5"],
  "related": ["multimodal-decode", "source-map", "rabbit-hole"],
  "body_status": "full",
  "rubric_tags": ["D1", "D5"],
  "steps": [
    {
      "key": "main",
      "title": "语料钩子与精问阅读",
      "disclose": "always",
      "methodology_note": "语料的关键节点预埋追问，帮学生在停下来思考；从课程语料库推荐精问卡片，每张含材料、问题、证据、反方、延伸、写作角度。",
      "methodology": {
        "why": "读视频或文章时人很容易**一路滑过去**，看完却没真正想过任何一处；在关键节点埋一个问题，能逼你**停下来思考**，而不是被信息带着走。",
        "how": "在材料里标出**锚点位置**（如 `video@0:25` / 第3段），写下这里该问的问题并作答；再从课程语料库挑 **1-3 张精问卡**，每张补齐材料、核心问题、证据点、反方、延伸与写作角度。",
        "when": "当你在老师预设的语料里读到某个关键点、想再深入，或在问「还有什么可读」「这段到底想说什么」的时候。"
      },
      "fields": [
        { "type": "repeatable_group", "key": "hooks", "label": "锚点与钩子问题", "item_fields": [
          { "type": "text", "key": "locator", "label": "锚点位置（如 video@0:25 / 第3段）" },
          { "type": "textarea", "key": "q", "label": "这里的预埋问题" },
          { "type": "textarea", "key": "answer", "label": "你的回答" }
        ] },
        { "type": "repeatable_group", "key": "reading_cards", "label": "推荐的精问阅读卡（1-3 张）", "item_fields": [
          { "type": "text", "key": "material", "label": "材料" },
          { "type": "textarea", "key": "key_q", "label": "核心问题" },
          { "type": "textarea", "key": "evidence_point", "label": "证据点" },
          { "type": "textarea", "key": "counter", "label": "反方" },
          { "type": "textarea", "key": "extension", "label": "延伸" },
          { "type": "textarea", "key": "essay_angle", "label": "写作角度" }
        ] },
        { "type": "textarea", "key": "direction", "label": "你想往哪个方向深入？" }
      ]
    }
  ]
}
