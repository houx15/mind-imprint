{
  "id": "aok-methods",
  "category": "AOK",
  "name": "其他学科方法卡集（数学·人文社科·艺术）",
  "name_en": "AOK Methods (Math / Human Sciences / Arts)",
  "purpose": "三个学科各有一套「怎么算知道」，按任务学科调出对应子卡：数学靠证明、人文社科靠有限度的科学、艺术靠有据解读",
  "trigger_condition": "学生在数学/人文社科/艺术任务中，需要该学科特有的「怎么算知道」",
  "priority": "P2",
  "disclosure_tier": "tier-2",
  "age_band": ["DP"],
  "trigger_keywords": ["证明", "反例", "相关因果", "样本", "解读", "这首诗", "这幅画"],
  "interaction_type": "步骤引导卡",
  "rubric_dims": ["D2", "D5"],
  "related": ["certainty-spectrum", "data-literacy", "opcvl"],
  "body_status": "full",
  "rubric_tags": ["D2", "D5"],
  "steps": [
    {
      "key": "main",
      "title": "学科方法子卡",
      "disclose": "always",
      "methodology_note": "选一个学科，按它「怎么算知道」的标准逐条过——数学要证明不是举例，社科有五个问，艺术要文本依据。",
      "fields": [
        { "type": "single_choice", "key": "subject", "label": "你在用哪个学科的方法？", "options": ["数学", "人文社科", "艺术"] },
        { "type": "textarea", "key": "math_proof", "label": "区分「看了很多例子」（证据）和「证明了」——这条是哪种？", "show_if": { "key": "subject", "equals": "数学" } },
        { "type": "textarea", "key": "math_counter", "label": "试着找一个反例", "show_if": { "key": "subject", "equals": "数学" } },
        { "type": "textarea", "key": "math_axiom", "label": "它在什么公理 / 前提下成立？", "show_if": { "key": "subject", "equals": "数学" } },
        { "type": "textarea", "key": "human_five_q", "label": "对这个社科结论逐条过「五个问」：因果还是相关？样本？观察效应？测量？能否复制？", "show_if": { "key": "subject", "equals": "人文社科" } },
        { "type": "textarea", "key": "arts_evidence", "label": "作品里哪句 / 哪个细节支持这个解读？还是你脑补的？", "show_if": { "key": "subject", "equals": "艺术" } }
      ]
    }
  ]
}
