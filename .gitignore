# =============================================================================
# AI CODING ASSISTANTS
# =============================================================================

# Claude Code - local settings contain personal preferences and may include tokens
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/*.local.*
CLAUDE.local.md

# Codex CLI - local files (sessions, logs, config)
.codex/*
!.codex/skills/
!.codex/prompts/

# Gemini CLI - local files (settings, tmp)
.gemini/*
!.gemini/skills/
!.gemini/commands/

# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================

# Environment files often contain API keys, database credentials, etc.
.env
.env.*
!.env.example              # Keep example files for documentation

# Private keys and certificates
*.pem
*.key

# Credential files
credentials.json
secrets.json

# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS - Finder metadata
.DS_Store

# Windows - thumbnail cache
Thumbs.db

# =============================================================================
# EDITORS & IDEs
# =============================================================================

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/

# Visual Studio Code
.vscode/

# Vim/Neovim swap and backup files
*.swp
*.swo
*~

# =============================================================================
# DEPENDENCIES
# =============================================================================

# Node.js
node_modules/

# PHP (Composer)
vendor/

# Python
__pycache__/
*.pyc
.venv/
venv/

# =============================================================================
# BUILD OUTPUTS
# =============================================================================

# Common build directories
dist/
build/

# Local evalbench binary (use `go run` or write builds outside the source tree)
/apps/api/evalbench

# Python package build
*.egg-info/

# Rust/Cargo
target/

# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================

*.log
logs/

# =============================================================================
# TEST COVERAGE
# =============================================================================

# JavaScript/TypeScript
coverage/
.nyc_output/

# Python
htmlcov/

# Subagent worktrees (never commit)
.claude/worktrees/

# Playwright MCP scratch (screenshots / console logs from live E2E runs)
.playwright-mcp/

# Playwright E2E run artifacts (traces, screenshots, reports)
apps/web/test-results/
apps/web/playwright-report/

# Superpowers brainstorm visual-companion scratch (mockups, session state)
.superpowers/

# Local deploy secrets (SSH creds, keys) — never commit
.deploy-local/

# =============================================================================
# REFERENCE REPOS (colleague demos, external code we study but do not ship)
# =============================================================================
docs/reference/

# =============================================================================
# WORKING / SCRATCH FILES — NOT part of the repo (2026-08-10 cleanup: these were
# accidentally committed via `git add -A`; they live only in the working tree)
# =============================================================================
# Root-level scratch (my test screenshots + graph/config experiments dumped in
# the top folder). Targeted patterns, NOT a blanket /*.png /*.yml — test
# artifacts should go under a scratch/tmp dir, not the repo root.
/verify-*.png
/*-prod.png
/gv2-*.yml
/gv3-*.yml
/dig*.yml
/map.yml
/proj.yml
/edges.yml
# Course-authoring source docs (kept locally, not shipped)
/docs/03_课程库_单课设计/
# Unrelated sibling project drafts
/docs/astranova/
# Design handoffs / teacher-end mockups (large binaries)
/docs/design/
# Misc one-off working docs
/docs/2026-07-06-spec.md
/docs/2026-07-29-interaction-mock.csv
/docs/EVALUATION-*.html

# Marketing-site media. Object storage (the mind-open bucket, served via
# mind-assets.uni-robot.cn) is the store of record — see docs/deploy/site.md.
# Keeping the originals out of git stops large binaries bloating the history;
# `deploy/upload-site-assets.sh` syncs this directory up.
apps/site/assets/*
!apps/site/assets/README.md

# apps/site-v2 的本地产物（2026-09-16）。
# node_modules 是一条指向 ../site/node_modules 的**符号链接** —— 上面那条
# `node_modules/` 带斜杠，只匹配目录，匹配不到符号链接，于是它一直露在
# git status 里。.astro 是 Astro 的内容缓存，每次 build 重新生成。
apps/site-v2/node_modules
apps/site-v2/.astro/

# 上一轮跑 agent 时倒出来的一份日志，不是源码。
.claude-tmp-*.json

# arm64 sqlc, downloaded because the x86 one stopped running on macOS 27
.tooling/
