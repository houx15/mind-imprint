---
import '../styles/global.css';import Icon from '../components/Icon.astro';import {features} from '../data/features';import {t,path,proUrl,type Lang} from '../config';
interface Props{lang:Lang;title?:string;description?:string;slug?:string}
const {lang,title,description=t(lang,['思维印记：面向学校与教育工作者的 AI 学习空间。支持阅读、写作、项目式学习与过程评估。','Mind Imprint: an AI learning space for schools and educators. Support reading, writing, inquiry and process assessment.']),slug=''}=Astro.props;
const fullTitle=title?`${title} · ${t(lang,['思维印记','Mind Imprint'])}`:t(lang,['思维印记 · 为深度学习而设计的 AI','Mind Imprint · AI for deeper learning']);
const canonical=new URL(path(lang,slug),Astro.site);
const isProductSection=slug==='product'||(
  slug.startsWith('product/')&&
  slug!=='product/courses'&&
  slug!=='product/assessment'
);
---
<!doctype html><html lang={lang==='zh'?'zh-CN':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{fullTitle}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="zh-CN" href={new URL(path('zh',slug),Astro.site)}/><link rel="alternate" hreflang="en" href={new URL(path('en',slug),Astro.site)}/><link rel="alternate" hreflang="x-default" href={new URL(path('en',slug),Astro.site)}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="theme-color" content="#f7f7f2"/></head><body>
<a class="skip" href="#main">{t(lang,['跳转到正文','Skip to content'])}</a>
<div class="announcement"><span>{t(lang,['为学校与教育工作者设计的 AI 学习空间','An AI learning space for schools & educators'])}</span><a href={path(lang,'schools')}>{t(lang,['了解教学应用','Explore classroom possibilities'])}<span aria-hidden="true"> ↗</span></a></div>
<header class="header"><div class="nav-wrap"><a class="brand" href={path(lang)} aria-label={t(lang,['思维印记首页','Mind Imprint home'])}><span class="brand-mark"><Icon name="mark"/></span><span>Mind Imprint<small>思维印记</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label={t(lang,['打开导航菜单','Open navigation menu'])}><span></span><span></span></button><nav id="primary-nav" aria-label={t(lang,['主导航','Main navigation'])}>
<details class:list={['nav-product',{ 'is-current':isProductSection }]}><summary aria-current={isProductSection?'page':undefined}>{t(lang,['产品','Product'])}<span class="chevron">⌄</span></summary><div class="mega-menu"><div class="mega-intro"><span class="eyebrow">{t(lang,['为思考而设计','MADE FOR THINKING'])}</span><strong>{t(lang,['让每一步学习，\n都有思考的参与。','Thinking, at every\nstep of learning.'])}</strong><a class="text-link" href={path(lang,'product')}>{t(lang,['产品全览','Explore the platform'])}<Icon name="arrow"/></a></div><div class="mega-links">{features.map(f=><a href={path(lang,`product/${f.id}`)}><span class={`icon-box ${f.tone}`}><Icon name={f.icon}/></span><span><b>{t(lang,f.name)}</b><small>{t(lang,f.action)}</small></span></a>)}</div></div></details>
<a href={path(lang,'schools')} aria-current={slug==='schools'?'page':undefined}>{t(lang,['学校与教师','Schools & educators'])}</a><a href={path(lang,'product/courses')} aria-current={slug==='product/courses'||slug.startsWith('courses/')?'page':undefined}>{t(lang,['课程体系','Curriculum'])}</a><a href={path(lang,'product/assessment')} aria-current={slug==='product/assessment'?'page':undefined}>{t(lang,['过程评估','Assessment'])}</a><a href={path(lang,'research-studio')} aria-current={slug==='research-studio'?'page':undefined}>{t(lang,['研究空间','Research Studio'])}</a><div class="nav-actions"><a class="language" href={path(lang==='zh'?'en':'zh',slug)} lang={lang==='zh'?'en':'zh-CN'}>{lang==='zh'?'EN':'中文'}</a><a class="login" href={proUrl}>{t(lang,['登录','Log in'])}</a><a class="button small" href={path(lang,'schools')}>{t(lang,['为学校了解','Explore for your school'])}<Icon name="arrow"/></a></div></nav></div></header>
<main id="main"><slot/></main>
<footer class="footer"><div class="wrap footer-grid"><div class="footer-brand"><a class="brand" href={path(lang)}><span class="brand-mark"><Icon name="mark"/></span><span>Mind Imprint<small>思维印记</small></span></a><p>{t(lang,['与 AI 协作，发展自己的思考。\n为阅读、写作与真实项目提供支持。','Work with AI. Develop your own thinking.\nSupport for reading, writing and real projects.'])}</p></div><div><h3>{t(lang,['学习空间','Learning spaces'])}</h3>{features.slice(0,4).map(f=><a href={path(lang,`product/${f.id}`)}>{t(lang,f.name)}</a>)}</div><div><h3>{t(lang,['教学与方法','Teaching & practice'])}</h3><a href={path(lang,'product/courses')}>{t(lang,['互动课程','Interactive courses'])}</a><a href={path(lang,'resources')}>{t(lang,['思维工具与资源','Thinking tools & resources'])}</a><a href={path(lang,'product/assessment')}>{t(lang,['过程评估','Process assessment'])}</a><a href={path(lang,'schools')}>{t(lang,['教师视角','For educators'])}</a></div><div><h3>{t(lang,['了解更多','Discover more'])}</h3><a href={path(lang,'research-studio')}>Research Studio</a><a href={path(lang,'about')}>{t(lang,['关于思维印记','About Mind Imprint'])}</a><a href={path(lang,'schools')+'#faq'}>{t(lang,['常见问题','Common questions'])}</a><a href={path(lang,'product')}>{t(lang,['产品全览','Product overview'])}</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Mind Imprint · 思维印记</span><span>{t(lang,['学生自主思考 · AI 协作支持 · 过程可回顾','Student agency · AI collaboration · Visible learning'])}</span><a href={path(lang==='zh'?'en':'zh',slug)}>{lang==='zh'?'English version ↗':'中文版本 ↗'}</a></div></footer>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('#primary-nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelectorAll<HTMLDetailsElement>('details.nav-product[open]').forEach(d=>d.open=false);if(menu?.getAttribute('aria-expanded')==='true'){menu.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');menu.focus()}}});
document.addEventListener('click',e=>{const d=document.querySelector<HTMLDetailsElement>('.nav-product');if(d?.open&&e.target instanceof Node&&!d.contains(e.target))d.open=false});

const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)');
const revealTargets=Array.from(document.querySelectorAll<HTMLElement>('.section-head,.feature-card,.resource-tile,.teacher-visual,.edition-pair article'));
if(!reducedMotion.matches&&'IntersectionObserver' in window){
  const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
    if(entry.isIntersecting){entry.target.removeAttribute('data-waiting');observer.unobserve(entry.target)}
  }),{threshold:0.08,rootMargin:'0px 0px 30px 0px'});
  revealTargets.forEach(el=>{if(el.getBoundingClientRect().top>innerHeight){el.classList.add('motion-enter');el.setAttribute('data-waiting','');observer.observe(el)}});
  reducedMotion.addEventListener('change',()=>{if(reducedMotion.matches){revealTargets.forEach(el=>el.removeAttribute('data-waiting'));observer.disconnect()}});
  window.addEventListener('beforeprint',()=>revealTargets.forEach(el=>el.removeAttribute('data-waiting')));
}
const heroImage=document.querySelector<HTMLElement>('.hero-image');
let heroFrame=false;
function moveHero(){heroFrame=false;if(!heroImage)return;if(reducedMotion.matches||innerWidth<1000){heroImage.style.transform='';return}const rect=heroImage.getBoundingClientRect();if(rect.bottom<0)return;heroImage.style.transform=`translateY(${Math.min(scrollY,600)*.06}px)`}
window.addEventListener('scroll',()=>{if(heroImage&&!heroFrame){heroFrame=true;requestAnimationFrame(moveHero)}},{passive:true});
reducedMotion.addEventListener('change',moveHero);
</script>
</body></html>
