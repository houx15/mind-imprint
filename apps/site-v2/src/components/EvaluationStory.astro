---
import {t,path,asset,type Lang} from '../config';import {depth,autonomy,reportParts} from '../data/evaluation';const {lang,compact=false}=Astro.props as {lang:Lang;compact?:boolean};
---
<section class="section evaluation-story"><div class="wrap"><div class="section-head"><div><span class="eyebrow">ASSESSMENT GROUNDED IN THE PROCESS</span><h2>{t(lang,['思考有多深入？\n判断有多自主？','How deeply did they think?\nHow independently did they judge?'])}</h2></div><p>{t(lang,['同一次核查，既可以看学生怎样处理证据，也可以看核查是谁发起的。过程评估分别呈现认知深度与智识自主，并回到具体学习记录。','The same source check can reveal how a student handles evidence and who initiated the check. Process assessment considers cognitive depth and intellectual autonomy separately, grounded in learning records.'])}</p></div><div class="evaluation-axes">{[[depth,['认知深度','Cognitive depth'],['关注思考的质量','Examine the quality of thinking']],[autonomy,['智识自主','Intellectual autonomy'],['关注判断与行动的发起','Examine agency in judgments and actions']]].map(([dimensions,title,subtitle])=><article><span class="eyebrow">{t(lang,subtitle as [string,string])}</span><h3>{t(lang,title as [string,string])}</h3>{compact?<p>{(dimensions as typeof depth).map(d=>t(lang,[d[1],d[2]])).join(' · ')}</p>:<dl>{(dimensions as typeof depth).map(([code,zh,en,dz,de])=><div><dt><b>{code}</b>{t(lang,[zh,en])}</dt><dd>{t(lang,[dz,de])}</dd></div>)}</dl>}</article>)}</div>{compact?<a class="button outline assessment-link" href={path(lang,'product/assessment')}>{t(lang,['深入了解评估逻辑与完整报告','Explore the assessment approach and full report'])} ↗</a>:<><div class="evidence-example"><span class="eyebrow">ONE EVENT. TWO QUESTIONS.</span><h3>{t(lang,['学生发现了与自己观点冲突的证据。','A student finds evidence that challenges their position.'])}</h3><p>{t(lang,['认知深度：是否理解反证、检查其来源，并据此调整论证？智识自主：是学生主动核查，还是在提示后完成？评价需要结合这次任务中的实际记录。','Depth: did they understand the counter-evidence, check its source and revise their argument? Autonomy: did they initiate the check or respond to a prompt? Interpret both through the records of this task.'])}</p></div><div class="section-head report-parts-heading"><div><span class="eyebrow">INSIDE THE RESEARCH REPORT</span><h2>{t(lang,['九个部分，\n连接过程与反馈。','Nine sections connect\nthe process with feedback.'])}</h2></div><p>{t(lang,['研究报告把活动记录、材料、双轴评估与后续建议组织在一起。查看具体证据，讨论下一步指导。','The research report brings together activity records, materials, the two assessment axes and suggestions. Examine the evidence and discuss the next steps.'])}</p></div><div class="report-parts">{reportParts.map(([zh,en,dz,de],i)=><article><span class="eyebrow">0{i+1}</span><h3>{t(lang,[zh,en])}</h3><p>{t(lang,[dz,de])}</p></article>)}</div><div class="assessment-download"><div><h3>{t(lang,['查看完整报告里的证据。','Read the evidence in a complete report.'])}</h3><p>{t(lang,['报告提供本次学习中的过程描述，供师生结合课堂情境讨论。它不等同于学生的固定能力标签或考试成绩预测。','The report describes the observed learning process for discussion alongside classroom context. It is not a fixed label of ability or a prediction of examination results.'])}</p></div><a class="button" href={asset('evaluation/report-sample-v1.pdf')} target="_blank" rel="noreferrer">{t(lang,['完整报告 · PDF','Full report · PDF'])} ↗</a></div></>}</div></section>
