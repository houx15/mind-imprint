---
import {stations} from '../data/researchCase';import {asset,t,type Lang} from '../config';import ProductVideo from './ProductVideo.astro';
const {lang}=Astro.props as {lang:Lang};
---
<section class="section wrap" id="research-walkthrough"><div class="section-head"><div><span class="eyebrow">WATCH THE RESEARCH PROCESS</span><h2>{t(lang,['一个问题，\n完整的研究过程。','One question.\nThe research process in action.'])}</h2></div><p>{t(lang,['“中国有没有让地球变得更可持续？”沿着旧官网已有的产品案例，查看学生怎样立题、追查来源、阅读、写作并回顾过程。','“Has China made the planet more sustainable?” Follow the recorded product case through framing, tracing sources, reading, writing and reflection.'])}</p></div><div class="research-scroll" data-research-scroll><nav class="research-step-nav" aria-label={t(lang,['研究步骤','Research steps'])}><div class="research-progress" aria-hidden="true"><span></span></div>{stations.map((s,i)=><a href={`#research-step-${i}`} data-step-link={i} aria-current={i===0?'step':undefined}><b>0{i+1}</b><span>{t(lang,s.k)}</span></a>)}</nav><div class="research-recordings">{stations.map((s,i)=><article id={`research-step-${i}`} data-research-step={i}><div class="recording-heading"><span class="eyebrow">0{i+1} / {t(lang,s.k)}</span><h3>{t(lang,s.h)}</h3></div>{s.clip?<ProductVideo lang={lang} clip={s.asset} title={s.alt}/>:<figure class="product-figure"><img src={asset(s.asset)} width="1440" height="900" loading="lazy" alt={t(lang,s.alt)}/><figcaption>{t(lang,s.alt)}</figcaption></figure>}</article>)}</div></div></section>

<script>
for(const story of document.querySelectorAll<HTMLElement>('[data-research-scroll]')){const steps=Array.from(story.querySelectorAll<HTMLElement>('[data-research-step]'));const links=Array.from(story.querySelectorAll<HTMLAnchorElement>('[data-step-link]'));const update=()=>{const line=innerHeight*.48;let active=0;steps.forEach((step,i)=>{if(step.getBoundingClientRect().top<=line)active=i;});steps.forEach((step,i)=>step.classList.toggle('step-current',i===active));links.forEach((link,i)=>{if(i===active)link.setAttribute('aria-current','step');else link.removeAttribute('aria-current');});story.style.setProperty('--research-progress',String((active+1)/steps.length));};let scheduled=false;const queue=()=>{if(scheduled)return;scheduled=true;requestAnimationFrame(()=>{update();scheduled=false;});};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);update();}
</script>
