---
import {t,path,v2Asset,type Lang} from '../config';import Icon from './Icon.astro';
const {lang}=Astro.props as {lang:Lang};
const stops=[
{title:['从“我想知道”开始。','It starts with “I wonder.”'],desc:['一个兴趣、一篇文章、一个还没有答案的问题。学生带着自己的好奇进入学习，探索可以继续追问的方向。','An interest. An article. A question without an answer yet. Students bring their own curiosity and discover where it could take them.'],image:'curious-learner-v2.webp',label:['01 / 追随好奇','01 / FOLLOW CURIOSITY'],link:'product/explore',action:['探索兴趣与问题','Follow the curiosity']},
{title:['理解证据，\n形成自己的判断。','Explore the evidence.\nMake it your own.'],desc:['AI 提供问题和工具。学生检查来源、比较观点、发展论证，让每一次选择都有自己的理由。','AI offers questions and tools. Students check sources, consider different perspectives and develop arguments—with reasons behind their choices.'],image:'learning-together-v3.webp',label:['02 / 深入思考','02 / THINK IT THROUGH'],link:'product/reading',action:['了解阅读与思考','See thinking in action']},
{title:['回顾过程，\n看见下一步。','Look back.\nSee a way forward.'],desc:['把互动与工具使用转化为可回顾的记录。学生反思自己的方法，教师结合具体证据开展下一次对话。','Turn interactions and tool use into a process worth revisiting. Students reflect on their methods. Educators start the next conversation with evidence.'],image:'teacher-dialogue-v2.webp',label:['03 / 让学习过程可见','03 / MAKE LEARNING VISIBLE'],link:'product/assessment',action:['了解过程评估','Explore learning insights']}
];
---
<section class="journey-section" aria-label={t(lang,['跟随一次学习旅程','Follow a learning journey'])}>
<div class="wrap journey-intro"><span class="eyebrow">{t(lang,['一个问题，能带你走得更远','A QUESTION CAN TAKE YOU SOMEWHERE'])}</span><h2>{t(lang,['从好奇，到自己的思考。','From curiosity to a mind of their own.'])}</h2><p>{t(lang,['向下探索，跟随一次学习的过程。','Scroll to follow the learning.'])}<span aria-hidden="true"> ↓</span></p></div>
<div class="wrap journey-route" data-journey>
<svg class="journey-line" viewBox="0 0 1200 1500" preserveAspectRatio="none" aria-hidden="true"><path class="journey-line-track" d="M600 0 C600 100 55 50 55 240 C55 535 1145 350 1145 750 C1145 1040 55 905 55 1240 C55 1475 600 1370 600 1500"/><path class="journey-line-draw" d="M600 0 C600 100 55 50 55 240 C55 535 1145 350 1145 750 C1145 1040 55 905 55 1240 C55 1475 600 1370 600 1500"/><circle class="journey-tip" cx="600" cy="1500" r="11"/></svg>
{stops.map((s,i)=><article class={`journey-stop stop-${i+1}`}><div class="journey-image"><img src={v2Asset(s.image)} width="1536" height="1024" loading="lazy" alt={t(lang,[['学生通过放大镜观察叶片','学生围绕书本交流','教师倾听学生解释学习记录'][i],['A curious learner examines a leaf','Students discuss a book','An educator listens to a student’s reflection'][i]])}/></div><div class="journey-copy"><span class="journey-number">0{i+1}</span><span class="eyebrow">{t(lang,s.label as [string,string])}</span><h3>{t(lang,s.title as [string,string])}</h3><p>{t(lang,s.desc as [string,string])}</p><a class="text-link" href={path(lang,s.link)}>{t(lang,s.action as [string,string])}<Icon name="arrow"/></a></div></article>)}
</div></section>
<script>
const journey=document.querySelector<HTMLElement>('[data-journey]');
const line=journey?.querySelector<SVGPathElement>('.journey-line-draw');
const tip=journey?.querySelector<SVGCircleElement>('.journey-tip');
const motion=matchMedia('(prefers-reduced-motion: reduce)');
if(journey&&line&&tip){
  const length=line.getTotalLength();let queued=false;
  const stops=Array.from(journey.querySelectorAll<HTMLElement>('.journey-stop'));
  function paint(){
    queued=false;
    if(!journey||!line||!tip)return;
    const box=journey.getBoundingClientRect();
    const ratio=motion.matches?1:Math.max(0,Math.min(1,(innerHeight*.65-box.top)/box.height));
    let low=0,high=length;
    for(let i=0;i<14;i++){const mid=(low+high)/2;if(line.getPointAtLength(mid).y<ratio*1500)low=mid;else high=mid}
    const drawn=ratio===1?length:ratio===0?0:(low+high)/2;
    line.style.strokeDasharray=String(length);line.style.strokeDashoffset=String(length-drawn);
    const point=line.getPointAtLength(drawn);tip.setAttribute('cx',String(point.x));tip.setAttribute('cy',String(point.y));
    journey.dataset.progress=ratio.toFixed(3);
    stops.forEach(stop=>{if(motion.matches||stop.getBoundingClientRect().top<innerHeight*.85)stop.removeAttribute('data-unseen')});
  }
  function schedule(){if(!queued){queued=true;requestAnimationFrame(paint)}}
  if(!motion.matches)stops.forEach(stop=>{if(stop.getBoundingClientRect().top>innerHeight)stop.setAttribute('data-unseen','')});
  window.addEventListener('scroll',schedule,{passive:true});window.addEventListener('resize',schedule);motion.addEventListener('change',schedule);
  window.addEventListener('beforeprint',()=>{line.style.strokeDashoffset='0';stops.forEach(stop=>stop.removeAttribute('data-unseen'))});
  paint();
}
</script>
