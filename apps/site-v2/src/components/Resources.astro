---
import {t,path,asset,type Lang} from '../config';import Icon from './Icon.astro';import CTA from './CTA.astro';
const {lang}=Astro.props as {lang:Lang};
const cards=[
{id:'craap',method:'CRAAP / CRRAAB',title:['信源辨识','Evaluate a source'],desc:['引用之前，检查来源的时效、相关性、权威、准确性与目的，进一步考虑偏见。','Before citing, examine currency, relevance, authority, accuracy and purpose, and consider bias.'],steps:[['确定需要核查的单一来源','Identify one source to examine'],['逐项核对，记录依据','Check each dimension and record evidence'],['判断引用、进一步验证或不用','Decide whether to cite, verify further or set aside']]},
{id:'toulmin',method:'TOULMIN',title:['构建论证','Build an argument'],desc:['把论点与证据连接起来，检查推理依据，考虑限定条件与可能的反驳。','Connect claims with evidence, examine the reasoning, and consider qualifications and rebuttals.'],steps:[['明确需要支持的主张','Identify the claim'],['说明证据怎样支持主张','Explain how evidence supports it'],['补充限定与反驳','Consider qualifications and rebuttals']]},
{id:'concession',method:'COUNTERARGUMENT',title:['回应反方','Consider a counterargument'],desc:['准确理解不同观点，承认其中有依据的部分，再说明自己结论的范围与理由。','Understand an opposing view fairly, acknowledge what it gets right, and explain the scope and reasoning of your conclusion.'],steps:[['准确陈述反方观点','State the opposing view fairly'],['区分可接受的部分与分歧','Separate agreement from disagreement'],['用理由与证据作出回应','Respond with reasons and evidence']]},
{id:'sift',method:'SIFT',title:['横向核查','Read laterally'],desc:['暂停判断，调查来源，寻找更可靠的报道，并追溯主张的原始出处。','Stop, investigate the source, find better coverage and trace claims to their original context.'],steps:[['先暂停，了解谁在发布','Pause and investigate the publisher'],['离开当前页面，交叉核查','Leave the page to cross-check'],['追到原始来源与语境','Trace the original source and context']]},
{id:'argument-map',method:'ARGUMENT MAPPING',title:['看清论证结构','Map an argument'],desc:['把核心主张、支持理由与反对意见放在同一结构中，检查缺少的连接。','Place the main claim, supporting reasons and objections in one structure to examine missing connections.'],steps:[['识别核心结论','Identify the main conclusion'],['连接支持理由与证据','Connect reasons and evidence'],['检查反例与推理缺口','Examine objections and gaps']]},
{id:'data-literacy',method:'DATA LITERACY',title:['理解数据','Interpret data'],desc:['从图表与数字回到研究问题，关注数据来自哪里、比较了什么，以及不能说明什么。','Relate charts and numbers to the question: where the data came from, what is being compared and what it cannot show.'],steps:[['检查来源、口径与样本','Check the source, definitions and sample'],['区分观察、比较与解释','Separate observation, comparison and explanation'],['说明结论的范围','Explain the limits of the conclusion']]}
];
---
<section class="product-intro"><div class="wrap page-intro"><span class="eyebrow">THINKING TOOLS FOR EDUCATORS</span><h1>{t(lang,['教学生一种方法，\n让下一次思考有据可依。','A method for today.\nA skill for the next question.'])}</h1><p>{t(lang,['从信源核查到论证与数据，了解产品中的代表性思维工具。以下是方法导览；完整交互在学习空间中使用。','Explore representative tools for source evaluation, argumentation and data literacy. These are method guides; full interactions take place in the learning space.'])}</p><div class="actions"><a class="button" href={path(lang,'product/courses')}>{t(lang,['浏览互动课程','Browse interactive courses'])}<Icon name="arrow"/></a></div></div></section><section class="section wrap"><div class="resource-list">{cards.map(c=><article class="resource-detail" id={c.id}><img src={asset(`cards/${c.id}-v3.webp`)} width="240" height="360" loading="lazy" alt={t(lang,[`${c.title[0]}工具卡`,`${c.title[1]} thinking card`])}/><div><span class="little-label">{c.method}</span><h3>{t(lang,c.title as [string,string])}</h3><p>{t(lang,c.desc as [string,string])}</p><details><summary>{t(lang,['查看使用步骤','View the steps'])}</summary><ol>{c.steps.map(s=><li>{t(lang,s as [string,string])}</li>)}</ol></details></div></article>)}</div><div class="note">{t(lang,['这些方法用于帮助学生组织思考。使用工具本身不代表已经形成高质量判断，需要结合具体材料与理由讨论。','These methods help organize thinking. Using a tool does not by itself establish the quality of a judgment; discuss it in the context of the material and reasoning.'])}</div></section><CTA lang={lang}/>
