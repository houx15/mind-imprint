---
import {t,path,type Lang} from '../config';import Icon from './Icon.astro';
const {lang}=Astro.props as {lang:Lang};
const scenes=[
 {id:'reading',label:['阅读与核查','Read & evaluate'] as const,title:['“地球变绿”意味着更可持续吗？','Does a greener Earth mean a more sustainable Earth?'] as const,question:['你找到的证据说明了植被变化。它也能说明碳排放的变化吗？','Your evidence describes changes in vegetation. Does it also describe changes in carbon emissions?'] as const,student:['我需要把植被变化和碳排放分别查证。','I need to investigate vegetation change and carbon emissions separately.'] as const,card:['信源辨识卡','Source evaluation'] as const,method:'CRAAP',notes:[['来源','Source'],['主张','Claim'],['证据范围','Scope of evidence']] as const,values:[['原始研究','Original research'],['植被覆盖的变化','Change in vegetation cover'],['不足以单独判断整体可持续性','Insufficient to judge sustainability alone']] as const},
 {id:'writing',label:['写作与论证','Write & reason'] as const,title:['如何回应与自己观点不同的证据？','How do you respond to evidence against your claim?'] as const,question:['这条反例挑战了你的哪一部分论点？你会怎样调整原来的表述？','Which part of your argument does this challenge? How would you revise your claim?'] as const,student:['我会缩小结论的范围，并解释现有证据的限制。','I will narrow my conclusion and explain the limits of the evidence.'] as const,card:['让步与反方观点','Concession & counterargument'] as const,method:'ARGUMENT',notes:[['原观点','Initial claim'],['反方证据','Counterevidence'],['修改方向','Revision']] as const,values:[['单一指标足以说明整体改善','One indicator shows overall improvement'],['不同指标可能呈现不同变化','Different indicators can move differently'],['限定结论，并回应反例','Qualify the conclusion and address the counterexample']] as const},
 {id:'projects',label:['项目与决策','Create & decide'] as const,title:['怎样让校园二手交换更容易？','How could a school make reuse easier?'] as const,question:['在制作页面之前，怎样验证同学真正需要解决的问题？','Before building a page, how could you check which problem students actually need solved?'] as const,student:['先访谈同学，比较信息发布、信任和取货三个环节。','Interview students first and compare listing, trust and collection.'] as const,card:['问题识别','Problem framing'] as const,method:'PROJECT',notes:[['观察','Observe'],['学生负责','Student-led'],['AI 支持','AI support']] as const,values:[['了解实际交换中的困难','Investigate difficulties with real exchanges'],['访谈、判断与方案审核','Interviews, decisions and review'],['整理材料与辅助制作','Organize findings and help create']] as const}
];
---
<section class="walkthrough section" id="learning-demo"><div class="wrap"><div class="section-head"><div><span class="eyebrow">LEARNING, IN ACTION</span><h2>{t(lang,['看见一次思考，\n如何向前推进。','See thinking\nmove forward.'])}</h2></div><p>{t(lang,['学生带着真实问题进入，印记提出问题、提供工具，帮助学生形成自己的判断。','Students bring a real question. Imprint offers prompts and tools to help them develop their own judgment.'])}</p></div><div class="learning-examples"><div class="example-stage"><div class="scene-controls" aria-label={t(lang,['选择学习示例','Choose a learning example'])}>{scenes.map((s,i)=><button type="button" data-scene={s.id} aria-pressed={i===0?'true':'false'} aria-controls={`scene-${s.id}`}>{t(lang,s.label)}</button>)}</div>
{scenes.map((s,i)=><div class="scene" id={`scene-${s.id}`} hidden={i!==0}><div class="scene-bar"><span><i class="status-dot"></i> {t(lang,['学习空间','Learning space'])}</span><span>{t(lang,['交互示例 · 非实时 AI 对话','Illustrative example · not a live AI conversation'])}</span></div><div class="scene-body"><div class="scene-conversation"><span class="little-label">{t(lang,['学生的问题','THE STUDENT’S QUESTION'])}</span><h3>{t(lang,s.title)}</h3><div class="coach-message"><span class="coach-avatar"><Icon name="mark"/></span><div><b>{t(lang,['印记 · AI 学习伙伴','Imprint · AI learning partner'])}</b><p>{t(lang,s.question)}</p></div></div><div class="student-message">{t(lang,s.student)}</div><div class="scene-bottom"><Icon name="check"/><span>{t(lang,['学生作出判断，过程留下记录','The student makes a judgment. The process is recorded.'])}</span></div></div><div class="scene-tool"><span class="little-label">{t(lang,['思维工具','THINKING TOOL'])}</span><div class="tool-paper"><div class="tool-title"><span>{s.method}</span><Icon name="spark"/></div><h3>{t(lang,s.card)}</h3>{s.notes.map((n,j)=><div class="tool-row"><span>{t(lang,n)}</span><p>{t(lang,s.values[j])}</p></div>)}<div class="tool-stamp"><Icon name="check"/>{t(lang,['学习记录示例','Sample learning record'])}</div></div></div></div></div>)}
<div class="demo-under"><p>{t(lang,['AI 的参与可见，学生的思考也可见。','Make AI’s contribution visible. Make student thinking visible.'])}</p><a class="text-link" href={path(lang,'product/assessment')}>{t(lang,['了解过程评估','Explore process assessment'])}<Icon name="arrow"/></a></div></div></div></div></section>
<script>
const controls=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scene]'));
controls.forEach((button,index)=>{
  button.addEventListener('click',()=>{
    controls.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
    document.querySelectorAll<HTMLElement>('.scene').forEach(s=>s.hidden=s.id!==`scene-${button.dataset.scene}`);
  });
  button.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();controls[(index+(e.key==='ArrowRight'?1:controls.length-1))%controls.length]?.focus()}});
});
</script>
