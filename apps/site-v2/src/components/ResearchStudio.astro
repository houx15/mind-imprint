---
import {t,path,v2Asset,proUrl,type Lang} from '../config';
import Icon from './Icon.astro';import ResearchCase from './ResearchCase.astro';import EvaluationStory from './EvaluationStory.astro';import CTA from './CTA.astro';
const {lang,compact=false}=Astro.props as {lang:Lang;compact?:boolean};
const stages=[
[['提出研究问题','Frame a research question'],['缩小兴趣范围，明确要回答的问题与研究方向。','Narrow an interest into a question and define the direction of the inquiry.']],
[['规划与管理','Plan the investigation'],['组织任务与阶段，在持续研究中回顾进展。','Organize tasks and stages, and revisit progress throughout the project.']],
[['阅读与证据','Read with a purpose'],['阅读相关材料，检查来源，整理支持或挑战论点的证据。','Read relevant materials, examine sources and organize evidence that supports or challenges an argument.']],
[['写作与修改','Write and revise'],['学生自己撰写正文；AI 对结构与论证提供反馈。','Students author their text. AI offers feedback on structure and argument.']],
[['回顾研究过程','Reflect on the process'],['回顾研究中的判断、修改与 AI 分工，结合过程评估理解自己的方法。','Revisit decisions, revisions and AI’s contribution, using process assessment to examine how the work developed.']]
] as const;
---
<section class="section research-band"><div class="wrap research-intro"><div><span class="eyebrow">MIND IMPRINT / RESEARCH STUDIO</span>{compact?<h2>{t(lang,['准备好深入研究\n一个问题了吗？','Ready to stay\nwith a bigger question?'])}</h2>:<h1>{t(lang,['从研究问题，\n到有据可循的论证。','From a research question\nto a reasoned argument.'])}</h1>}<p class="hero-lead">{t(lang,['专注于探究性研究与写作的学习空间，连接立题、项目管理、文献阅读、写作与反思。让学生在持续的研究中练习自己的判断。','A dedicated workspace for inquiry-based research and writing. Connect question development, project management, research reading, writing and reflection throughout a sustained investigation.'])}</p><div class="actions"><a class="button" href={compact?path(lang,'research-studio'):proUrl}>{t(lang,compact?['探索 Research Studio','Explore Research Studio']:['进入研究空间','Open the research workspace'])}<Icon name="arrow"/></a></div><p class="note">{t(lang,['为需要持续阅读、证据整理与论证写作的研究任务提供支持。','For projects that call for sustained reading, evidence gathering and argument development.'])}</p></div><img src={v2Asset('curious-learner-v2.webp')} width="1536" height="1024" loading="lazy" alt={t(lang,['学生使用放大镜观察植物的插画','Illustration of a student examining a plant'])}/></div></section>
{!compact&&<><section class="section wrap"><div class="section-head"><div><span class="eyebrow">ONE INQUIRY, CONNECTED THROUGHOUT</span><h2>{t(lang,['把研究的各个环节\n联系起来。','Keep the whole\ninvestigation connected.'])}</h2></div><p>{t(lang,['日常阅读、写作、课程与实践构成思维印记的广泛学习空间。Research Studio 聚焦需要持续推进、整合多份材料的深入研究。','Mind Imprint offers reading, writing, courses and practical projects across everyday learning. Research Studio focuses on sustained inquiry involving multiple sources and a developing argument.'])}</p></div><ol class="research-stages">{stages.map(([title,desc],i)=><li><span>0{i+1}</span><div><h3>{t(lang,title)}</h3><p>{t(lang,desc)}</p></div></li>)}</ol></section><section class="section soft"><div class="wrap"><div class="section-head"><div><span class="eyebrow">FOR INQUIRY-BASED EDUCATION</span><h2>{t(lang,['围绕学校的\n研究任务使用。','Bring your school’s\nresearch task.'])}</h2></div><p>{t(lang,['面向 IB、AP Seminar / AP Research、道尔顿体系等探究性学习场景。教师根据具体项目要求安排研究、写作与指导。','For inquiry-based learning contexts including IB, AP Seminar / AP Research and Dalton education. Educators guide the work around the requirements of their own assignment.'])}</p></div></div></section><ResearchCase lang={lang}/><EvaluationStory lang={lang} compact/><section class="section wrap about-story"><h2>{t(lang,['让指导有具体依据。','Give supervision a concrete starting point.'])}</h2><p>{t(lang,['结合学生的学习记录、工具使用和过程评估，讨论证据选择、论证修改与自主判断。将这些记录与课堂观察一起用于后续指导。','Use learning records, thinking tools and process assessment to discuss evidence choices, revisions and independent judgment. Bring those records into supervision alongside classroom observations.'])}</p><a class="text-link" href={path(lang,'schools')}>{t(lang,['查看教师视角','Explore the educator experience'])}<Icon name="arrow"/></a></section><CTA lang={lang}/></>}
