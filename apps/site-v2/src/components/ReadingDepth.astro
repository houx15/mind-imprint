---
import {t,type Lang} from '../config';const {lang}=Astro.props as {lang:Lang};
---
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">READING THAT MEETS THE LEARNER</span><h2>{t(lang,['适合当前水平，\n深入到文章之中。','Meet the learner’s level.\nGo deeper into the text.'])}</h2></div><p>{t(lang,['分级阅读与学生带入的文章，都可以成为学习起点。系统结合文章和学生水平生成阅读任务，让学生在原文中参与、理解与判断。','Start with the graded reading library or a text the student brings. Reading tasks are generated around the article and the learner’s level, inviting active work within the text.'])}</p></div><div class="three-columns">{[[['分级阅读','Graded reading'],['从适合自己水平的材料开始，再通过阅读任务展开学习。','Start with material suited to the learner’s level and work through reading tasks.']],[['在文章中互动','Interact within the article'],['寻找并选择原文证据，标注段落，回应围绕文章生成的任务。','Find and select evidence, annotate passages and respond to tasks grounded in the article.']],[['英文精读','Close reading in English'],['获得针对英文文章的讲解，拆解句式，理解词句如何共同表达意义。','Explore explanations tailored to English texts, unpack sentence structures and examine how wording shapes meaning.']]].map(([title,desc])=><article><h3>{t(lang,title as [string,string])}</h3><p>{t(lang,desc as [string,string])}</p></article>)}</div><div class="sentence-demo"><div><span class="eyebrow">ENGLISH CLOSE READING · {t(lang,['示例','ILLUSTRATION'])}</span><h3><mark>Although the park is small,</mark> it provides a habitat <u>that many birds depend on.</u></h3></div><div><p><b>Although…</b> — {t(lang,['让步从句：先承认公园面积小。','A concessive clause acknowledges the park’s size.'])}</p><p><b>it provides a habitat</b> — {t(lang,['主句：说明公园的作用。','The main clause states what the park provides.'])}</p><p><b>that many birds depend on</b> — {t(lang,['定语从句：补充说明 habitat。','A relative clause gives more information about the habitat.'])}</p></div></div></section>
