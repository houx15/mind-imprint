---
import EvaluationStory from './EvaluationStory.astro';
import {t,path,asset,v2Asset,demoUrl,proUrl,type Lang} from '../config';import Icon from './Icon.astro';
const {lang}=Astro.props as {lang:Lang};
const faqs=[
[['学生会让 AI 代写作业吗？','Does AI write students’ assignments?'],['写作正文由学生自己撰写。AI 提供引导、结构建议和批注。项目制作中的人机分工会有所不同，学生仍需负责关键判断与成果审核。','Students write their own assignment text. AI provides prompts, structural guidance and feedback. AI’s role in project production can differ, with students responsible for key decisions and reviewing outcomes.']],
[['Research Studio 适合什么任务？','What is Research Studio for?'],['思维印记支持日常探索、中英文读写、课程与实践项目。Research Studio 是其中专注深入研究与探究性写作的学习空间，连接立题、材料阅读、写作与反思。','The Mark of Thinking supports exploration, Chinese and English reading and writing, courses and practical projects. Research Studio is the dedicated space for sustained inquiry, connecting research questions, reading, writing and reflection.']],
[['学生如何加入学校与班级？','How do students join a school and class?'],['账号归属于学校，学生通过有效的班级邀请码注册并加入班级。具体组织与接入安排需要结合学校使用场景确定。','Accounts belong to a school. Students register with a valid class join code. Organization and access arrangements depend on the school’s use case.']],
[['过程评估能替代教师评分吗？','Does process assessment replace teacher grading?'],['报告依据平台内发生的学习记录描述过程，为教师提供可讨论的证据。它不能覆盖学生全部学习活动，不替代教师专业判断，也不预测考试成绩。','Reports describe the process recorded in the platform and provide evidence for discussion. They do not capture all learning, replace professional judgment or predict examination results.']],
[['这是作业提交或学校管理系统吗？','Is this an assignment submission or school management system?'],['思维印记围绕思考、学习与协作提供支持。学生的成果可以带走，向学校提交作业仍在学校原有流程中完成。','The Mark of Thinking supports thinking, learning and collaboration. Students can take their outcomes with them; submission stays within the school’s existing process.']],
[['是否需要先了解 AI 技术？','Do educators need technical AI expertise?'],['可以先从一次阅读、写作或课程示例了解体验。产品以学习任务和思维工具组织使用过程，学校可结合课程目标判断适用范围。','Start with a reading, writing or course example. The product is organized around learning tasks and thinking tools so educators can assess its fit with their curriculum goals.']]
] as const;
---
<section class="school-hero school-character-hero"><div class="wrap school-hero-grid"><div><span class="eyebrow">FOR SCHOOLS & EDUCATORS</span><h1>{t(lang,['让学习得到支持，\n让教师看见思考。','Support learning.\nMake thinking visible.'])}</h1><p class="hero-lead">{t(lang,['为学生提供探索、阅读、写作与项目的 AI 支持，\n为教师提供理解学习过程的记录和证据。','AI support for exploration, reading, writing and projects.\nRecords and evidence that help educators understand the learning process.'])}</p><div class="actions"><a class="button" href={demoUrl}>{t(lang,['体验完整产品演示','Explore the product demo'])}<Icon name="arrow"/></a><a class="button outline" href="#teacher-view">{t(lang,['查看教师视角','See the educator view'])}</a></div><div class="school-hero-labels"><span>{t(lang,['课堂讨论','Classroom discussion'])}</span><span>{t(lang,['研究与写作','Research & writing'])}</span><span>{t(lang,['项目式学习','Project-based learning'])}</span><span>{t(lang,['过程性反馈','Process feedback'])}</span></div></div><img class="school-character" src={v2Asset('teacher-dialogue-v2.webp')} width="1536" height="1024" alt={t(lang,['教师倾听学生解释自己的学习','An educator listens as a student explains their learning'])}/></div></section>
<section class="section wrap" id="teacher-view"><div class="section-head"><div><span class="eyebrow">A CLEARER VIEW OF LEARNING</span><h2>{t(lang,['从“完成了什么”，\n进一步看到“怎样完成”。','See what students did.\nUnderstand how they did it.'])}</h2></div><p>{t(lang,['在具体的学习记录中了解学生的活动与进展，为后续指导找到切入点。','Use concrete records to understand activity and progress, and identify where a conversation could help.'])}</p></div><figure class="product-figure"><div class="figure-bar"><span>{t(lang,['班级周报','Class activity report'])}</span><span>{t(lang,['现有产品界面','Existing product interface'])}</span></div><img src={asset('product/teacher-week-v1.webp')} width="1440" height="900" loading="lazy" alt={t(lang,['教师工作台：班级活动与学习报告','Teacher workspace showing class activity and learning reports'])}/><figcaption>{t(lang,['截图中的数字为产品示例内容，不是学校成效承诺。','Figures shown are sample product content, not promises of school outcomes.'])}</figcaption></figure><div class="three-columns">{[[['班级活动','Class activity'],['了解学生近期参与情况与项目进展，定位需要进一步了解的学习过程。','Review recent participation and project progress to identify learning processes worth examining.']],[['学生记录','Student records'],['结合项目、课程与生成的报告，回顾学生在平台中的学习经历。','Review a student’s platform learning across projects, courses and available reports.']],[['教学判断','Professional judgment'],['从具体证据出发与学生讨论。报告提供参考，教师结合课堂与实际情境判断。','Discuss concrete evidence with students, using classroom context and professional judgment.']]].map(([title,desc])=><article><h3>{t(lang,title as [string,string])}</h3><p>{t(lang,desc as [string,string])}</p></article>)}</div></section>
<section class="section soft"><div class="wrap teacher-home"><div><span class="eyebrow">EVIDENCE, WITH CONTEXT</span><h2>{t(lang,['一份报告，\n回到具体的学习。','A report grounded\nin the learning itself.'])}</h2><p>{t(lang,['过程评估从思考深度与自主性两个维度，结合记录描述学生怎样使用信息、处理问题和参与判断。','Process assessment considers depth of thinking and autonomy, describing how the student used information, approached problems and participated in judgments.'])}</p><a class="text-link" href={path(lang,'product/assessment')}>{t(lang,['了解评估方式','Explore the assessment approach'])}<Icon name="arrow"/></a></div><img class="report-preview" src={asset('product/teacher-student-v1.webp')} width="1440" height="900" loading="lazy" alt={t(lang,['教师端学生详情界面','Student detail view for educators'])}/></div></section>
<EvaluationStory lang={lang} compact/><section class="section wrap"><div class="section-head"><div><span class="eyebrow">START WITH YOUR TEACHING</span><h2>{t(lang,['从一个教学任务开始。','Start with one teaching task.'])}</h2></div><p>{t(lang,['先看学生如何使用，再判断它适合进入哪些课堂与项目。','See how students use the space, then consider where it fits your teaching.'])}</p></div><ol class="steps-grid"><li><span>01</span><h3>{t(lang,['查看完整示例','Explore an example'])}</h3><p>{t(lang,['体验课程、研究与写作，查看学习过程及报告。','Explore courses, research and writing, then review the learning process and report.'])}</p></li><li><span>02</span><h3>{t(lang,['确定教学场景','Choose a teaching context'])}</h3><p>{t(lang,['选择阅读讨论、论证写作或一个具体项目，明确希望观察的学习行为。','Choose a reading discussion, argument or project, and define the learning behaviors you want to observe.'])}</p></li><li><span>03</span><h3>{t(lang,['结合课堂回顾','Reflect with classroom context'])}</h3><p>{t(lang,['将平台记录与学生成果、课堂表现一起讨论，形成后续支持。','Discuss platform records alongside student work and classroom participation to plan further support.'])}</p></li></ol></section>
<section class="section soft" id="faq"><div class="wrap faq-layout"><div><span class="eyebrow">YOUR QUESTIONS, ANSWERED</span><h2>{t(lang,['学校常见问题','Questions from educators'])}</h2><p>{t(lang,['关于 AI 分工、研究与学习记录。','About AI’s role, research and learning records.'])}</p></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{t(lang,q)}<span>+</span></summary><p>{t(lang,a)}</p></details>)}</div></div></section>
<section class="closing"><div class="wrap school-close"><span class="eyebrow">EXPLORE THE MARK OF THINKING</span><h2>{t(lang,['先亲自体验，\n再讨论教学中的可能。','Experience it first.\nConsider the possibilities.'])}</h2><div class="actions"><a class="button light" href={demoUrl}>{t(lang,['进入演示账号','Open the demo account'])}<Icon name="arrow"/></a><a class="text-link inverse" href={proUrl}>{t(lang,['已有账号？登录','Already have an account? Log in'])}</a></div><p>{t(lang,['演示入口连接Research Studio 现有产品，使用示例账号。请勿在演示中输入真实学生的个人信息。','The demo opens the Research Studio application with a sample account. Please use sample content rather than real students’ personal information.'])}</p></div></section>
