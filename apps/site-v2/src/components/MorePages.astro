---
import {t,type Lang} from '../config';import CTA from './CTA.astro';import FeatureGrid from './FeatureGrid.astro';import LearningShowcase from './LearningShowcase.astro';import ResearchStudio from './ResearchStudio.astro';import Walkthrough from './Walkthrough.astro';import AboutPeople from './AboutPeople.astro';import PlatformRecordings from './PlatformRecordings.astro';
const {lang,slug}=Astro.props as {lang:Lang;slug:string};

---
{slug==='product'&&<><section class="product-intro"><div class="wrap page-intro"><span class="eyebrow">THE MARK OF THINKING PLATFORM</span><h1>{t(lang,['真实的学习任务。\n具体的 AI 支持。','Real learning tasks.\nThoughtful AI support.'])}</h1><p>{t(lang,['从第一个问题，到阅读、写作与项目成果，再到回顾自己怎样思考。了解思维印记的完整学习空间。','From a first question to reading, writing and a project outcome, then reflecting on how you thought. Explore the complete The Mark of Thinking learning space.'])}</p></div></section><section class="section wrap"><FeatureGrid lang={lang}/></section><PlatformRecordings lang={lang}/><Walkthrough lang={lang}/><LearningShowcase lang={lang}/><ResearchStudio lang={lang} compact/></>}
{['editions','research-studio'].includes(slug)&&<ResearchStudio lang={lang}/>}
{slug==='about'&&<><section class="product-intro"><div class="wrap page-intro"><span class="eyebrow">ABOUT US</span><h1>{t(lang,['让思考，\n成为学习的主角。','Put thinking\nat the heart of learning.'])}</h1><p>{t(lang,['当 AI 能够生成越来越多内容，我们仍然需要学生提出问题、理解证据、作出判断，并解释自己的选择。','As AI generates more content, students still need to ask questions, understand evidence, make judgments and explain their choices.'])}</p></div></section><AboutPeople lang={lang}/><section class="section wrap"><div class="about-story"><h2>{t(lang,['从学习者自己的任务出发。','Start with the learner’s own task.'])}</h2><p>{t(lang,['学生带着文章、写作或项目进入思维印记。AI 提供问题和反馈，交互式工具帮助他们检查来源、整理证据、发展论证。学生在其中作出选择，也留下思考的记录。','Students bring an article, a writing task or a project into The Mark of Thinking. AI offers questions and feedback. Interactive tools help them examine sources, organize evidence and develop arguments. Their choices leave a record of thinking.'])}</p><p>{t(lang,['我们重视成果，也重视形成成果的过程。通过具体记录与过程评估，学生可以回顾自己的方法，教师可以结合课堂观察理解学习。','We value outcomes and the process that produces them. Learning records and process assessment help students revisit their methods and give educators context alongside classroom observations.'])}</p></div><div class="about-principles">{[[['自主思考','Student agency'],['学生负责作业正文、关键判断与修改。AI 的参与需要清楚可见。','Students own their assignment text, key judgments and revisions. AI’s contribution should be visible.']],[['参与式学习','Active participation'],['让学生通过问题、卡片、选项与实际操作参与学习，练习可再次使用的方法。','Questions, cards, choices and practical actions invite participation and practice of reusable methods.']],[['清楚的支持','Clear support'],['对话有明确目标，工具有具体用途，反馈帮助学生决定下一步。','Conversations have clear goals, tools have concrete uses and feedback helps students choose their next step.']],[['过程有据可查','Evidence of process'],['记录平台内发生的互动与工具使用，为回顾与教学判断提供具体依据。','Record platform interactions and tool use to provide concrete evidence for reflection and teaching.']]].map(([title,desc],i)=><article><span>0{i+1}</span><h3>{t(lang,title as [string,string])}</h3><p>{t(lang,desc as [string,string])}</p></article>)}</div></section></>}
{!['editions','research-studio'].includes(slug)&&<CTA lang={lang}/>}
