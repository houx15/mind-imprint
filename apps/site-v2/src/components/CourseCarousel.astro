---
import ProductVideo from './ProductVideo.astro';import {t,path,type Lang} from '../config';const {lang}=Astro.props as {lang:Lang};
const examples=[{clip:'courses/ifs-v1',name:['认识内在小人','Meet the parts within you'],text:['识别内在部分，回顾注意力，理解自己的反应与选择。','Recognize inner parts, revisit attention and examine your responses and choices.'],slug:'self-exploration'},{clip:'courses/sift-v1',name:['沿着 SIFT 追查来源','Follow a claim with SIFT'],text:['从一条转发内容出发，横向核查，再回到原始来源。','Start with a shared claim, investigate laterally and trace it back to the original source.'],slug:'source-evaluation'},{clip:'courses/craap-v1',name:['用 CRAAP / CRRAAB 检查信息','Evaluate with CRAAP / CRRAAB'],text:['在具体材料里练习来源筛选，解释为什么相信一条信息。','Practice source evaluation on concrete material and explain why a claim deserves trust.'],slug:'source-evaluation'}];
---
<section class="section wrap" data-course-carousel><div class="section-head"><div><span class="eyebrow">STEP INSIDE A COURSE</span><h2>{t(lang,['看看课程怎样展开。','See a course unfold.'])}</h2></div><p>{t(lang,['从认识自己，到判断外部信息。滑动或切换课程，观看实际学习过程。','From understanding yourself to evaluating information. Swipe or choose a course to watch the learning process.'])}</p></div><div class="course-slides" aria-label={t(lang,['课程演示轮播','Course demonstration carousel'])}>{examples.map(e=><article class="course-slide"><div class="course-slide-copy"><span class="eyebrow">{t(lang,['课程录屏','COURSE RECORDING'])}</span><h3>{t(lang,e.name as [string,string])}</h3><p>{t(lang,e.text as [string,string])}</p><a class="text-link" href={path(lang,`courses/${e.slug}`)}>{t(lang,['探索这个课程板块','Explore this curriculum area'])} ↗</a></div><ProductVideo lang={lang} clip={e.clip} title={e.name as [string,string]}/></article>)}</div><div class="course-slide-controls">{examples.map((e,i)=><button type="button" data-slide-to={i} aria-pressed={i===0}>{String(i+1).padStart(2,'0')} / {t(lang,e.name as [string,string])}</button>)}</div></section>
<script>
for(const carousel of document.querySelectorAll<HTMLElement>('[data-course-carousel]')){const track=carousel.querySelector<HTMLElement>('.course-slides')!;const slides=Array.from(track.children) as HTMLElement[];const buttons=Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));const go=(i:number)=>track.scrollTo({left:slides[i].offsetLeft,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});buttons.forEach((button,i)=>{button.addEventListener('click',()=>go(i));button.addEventListener('keydown',e=>{if(!['ArrowRight','ArrowLeft'].includes(e.key))return;e.preventDefault();const next=(i+(e.key==='ArrowRight'?1:-1)+slides.length)%slides.length;buttons[next].focus();go(next);});});const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting&&entry.intersectionRatio>.6){const i=slides.indexOf(entry.target as HTMLElement);buttons.forEach((b,j)=>b.setAttribute('aria-pressed',String(i===j)));}},{root:track,threshold:.6});slides.forEach(slide=>observer.observe(slide));}
</script>
