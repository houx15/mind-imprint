---
import {t,path,asset,v2Asset,type Lang} from '../config';import Icon from './Icon.astro';import FeatureGrid from './FeatureGrid.astro';import CTA from './CTA.astro';import Journey from './Journey.astro';import ResearchStudio from './ResearchStudio.astro';
const {lang}=Astro.props as {lang:Lang};
---
<div class="hero-band"><section class="hero wrap"><div class="hero-copy"><div class="hero-kicker"><span class="tiny-star">✳</span> {t(lang,['让 AI 支持更深入的学习','AI FOR DEEPER LEARNING'])}</div><h1>{lang==='zh'?<>让 AI 支持学习。<br/>让学生<span class="underline-word">深入思考。<svg viewBox="0 0 340 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 13Q160 0 335 12"/></svg></span></>:<>AI for learning.<br/>Space for <span class="underline-word">thinking.<svg viewBox="0 0 340 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 13Q160 0 335 12"/></svg></span></>}</h1><p class="hero-lead">{t(lang,['为学校与教育工作者提供一个 AI 学习空间。\n从兴趣探索到阅读、写作与项目，让学生练习思考，让教师看见过程。','An AI learning space for schools and educators. From curiosity to reading, writing and real projects—help students think deeply, and make their learning visible.'])}</p><div class="actions"><a class="button" href={path(lang,'schools')}>{t(lang,['为学校了解','Explore for your school'])}<Icon name="arrow"/></a><a class="button outline" href={path(lang,'product')+'#learning-demo'}><Icon name="play"/>{t(lang,['看看如何学习','See learning in action'])}</a></div><div class="hero-principles"><span><Icon name="check"/>{t(lang,['学生自己思考','Student agency'])}</span><span><Icon name="check"/>{t(lang,['AI 协作支持','AI collaboration'])}</span><span><Icon name="check"/>{t(lang,['学习过程可见','Visible learning'])}</span></div></div>
<div class="hero-visual"><img class="hero-image" src={v2Asset('learning-together-v3.webp')} width="1536" height="1024" fetchpriority="high" alt={t(lang,['学生阅读与交流的品牌插画','Brand illustration of students reading and sharing ideas'])}/></div></section></div>
<section class="learning-strip"><div class="wrap"><span>{t(lang,['服务真实的教学与学习','BUILT AROUND REAL LEARNING'])}</span><b>{t(lang,['探究','Inquiry'])}</b><i>✳</i><b>{t(lang,['阅读','Reading'])}</b><i>✳</i><b>{t(lang,['写作','Writing'])}</b><i>✳</i><b>{t(lang,['项目','Projects'])}</b><i>✳</i><b>{t(lang,['反思','Reflection'])}</b></div></section>
<Journey lang={lang}/><section class="section wrap" id="platform"><div class="section-head"><div><span class="eyebrow">{t(lang,['一个空间，多种学习方式','ONE SPACE. MANY WAYS TO LEARN.'])}</span><h2>{t(lang,['从好奇出发，\n把学习做深入。','Start with curiosity.\nTake learning further.'])}</h2></div><p>{t(lang,['六个相互联系的学习场景，支持学生理解材料、发展论证、开展实践，也帮助教师了解学习如何发生。','Six connected learning contexts help students understand texts, develop arguments and put ideas into practice—while giving educators a clearer view of learning.'])}</p></div><FeatureGrid lang={lang}/></section>

<section class="section wrap teacher-home"><div class="teacher-visual"><div class="teacher-screen-head"><span class="icon-box blue"><Icon name="people"/></span><b>{t(lang,['教师工作台','The educator workspace'])}</b><span>{t(lang,['产品示例','Product example'])}</span></div><img src={asset('product/teacher-week-v1.webp')} width="1440" height="900" loading="lazy" alt={t(lang,['教师端班级周报实际界面','Actual teacher class report interface'])}/><div class="teacher-callout"><Icon name="chart"/><div><b>{t(lang,['从学习记录，到教学支持','From learning records to teaching support'])}</b><p>{t(lang,['查看过程，结合证据理解学生。','Review the process. Understand the learner.'])}</p></div></div></div><div class="teacher-copy"><span class="eyebrow">{t(lang,['为教育者而设计','BUILT WITH EDUCATORS IN MIND'])}</span><h2>{t(lang,['AI 在学生身边，\n教师看得见过程。','Support for students.\nInsight for educators.'])}</h2><p>{t(lang,['看见学生做过什么、怎样使用工具、如何修改判断。把对学习的了解，带回下一次课堂讨论与指导。','See what students worked on, how they used thinking tools and how their judgments developed. Bring that understanding into the next conversation.'])}</p><ul class="check-list"><li><Icon name="check"/>{t(lang,['了解班级活动与学生学习进展','Understand class activity and student progress'])}</li><li><Icon name="check"/>{t(lang,['从具体记录阅读过程评估','Read assessments in the context of learning records'])}</li><li><Icon name="check"/>{t(lang,['分别关注思考深度与自主性','Consider depth of thinking and autonomy separately'])}</li></ul><a class="text-link" href={path(lang,'schools')}>{t(lang,['了解学校与教师端','Explore the educator experience'])}<Icon name="arrow"/></a></div></section>
<ResearchStudio lang={lang} compact/>
<CTA lang={lang}/>
