---
import {t,type Lang} from '../config';
const {lang}=Astro.props as {lang:Lang};
---
<section class="section wrap interest-growth" data-interest-growth><div class="section-head"><div><span class="eyebrow">INTERESTS ABOVE. DISCIPLINES BELOW.</span><h2>{t(lang,['把点状兴趣，\n连接成自己的树。','Connect individual interests.\nGrow a tree of your own.'])}</h2></div><p>{t(lang,['上层是学生的兴趣，下层是与兴趣相关的学科。随着阅读、写作、课程与项目积累，学习记录为兴趣发现和后续探索提供依据。','Interests form the canopy; connected disciplines form the roots. Reading, writing, courses and projects provide evidence for discovering interests and exploring further.'])}</p></div><div class="growth-layout"><div class="growth-diagram"><svg viewBox="0 0 640 560" role="img" aria-label={t(lang,['兴趣在上，学科根系在下的两层树木示意','A two-layer tree with interests above and disciplinary roots below'])}><path class="ground-line" d="M25 345H615"/><g class="growing-lines" fill="none" stroke-linecap="round"><path class="tree-trunk" pathLength="1" d="M320 345Q300 260 325 125"/><path pathLength="1" d="M316 280Q250 225 145 190M316 260Q390 205 490 180M321 200Q260 160 245 100M324 160Q375 120 405 80"/><g class="tree-roots"><path pathLength="1" d="M320 345Q270 395 140 445M320 345Q330 420 310 475M320 345Q385 405 490 440"/></g></g><g class="tree-leaves" fill="#a6ce79"><ellipse cx="185" cy="209" rx="30" ry="15" transform="rotate(25 185 209)"/><ellipse cx="442" cy="198" rx="30" ry="16" transform="rotate(-25 442 198)"/><ellipse cx="263" cy="134" rx="17" ry="30" transform="rotate(-35 263 134)"/><ellipse cx="368" cy="111" rx="16" ry="29" transform="rotate(40 368 111)"/></g><g class="tree-labels"><g><rect x="65" y="152" width="130" height="45" rx="22"/><text x="130" y="180">{t(lang,['游戏','Games'])}</text></g><g><rect x="430" y="139" width="140" height="45" rx="22"/><text x="500" y="168">{t(lang,['设计','Design'])}</text></g><g><rect x="177" y="57" width="136" height="45" rx="22"/><text x="245" y="86">{t(lang,['城市','Cities'])}</text></g><g><rect x="346" y="36" width="130" height="45" rx="22"/><text x="411" y="65">{t(lang,['自然','Nature'])}</text></g></g><g class="root-labels"><text x="130" y="470">{t(lang,['交互设计','Interaction design'])}</text><text x="310" y="510">{t(lang,['概率','Probability'])}</text><text x="505" y="467">{t(lang,['视觉设计','Visual design'])}</text></g></svg><small>{t(lang,['结构与生长示意，非学生真实数据。','Illustrative growth and structure, not a student’s data.'])}</small></div><div class="growth-copy"><span class="eyebrow">01 / INTERESTS</span><h3>{t(lang,['从真实学习中发现兴趣','Discover interests through learning'])}</h3><p>{t(lang,['把阅读、写作和项目中的兴趣线索与具体学习经历联系起来，持续了解自己关注什么。','Connect interests with the reading, writing and projects where they appeared, and revisit what holds your attention.'])}</p><span class="eyebrow">02 / DISCIPLINES</span><h3>{t(lang,['看到兴趣背后的学科','Explore the disciplines underneath'])}</h3><p>{t(lang,['例如，游戏可以连接交互设计、概率与视觉设计。沿着学科联系，找到进一步探索的方向。','Games, for example, connect to interaction design, probability and visual design. Follow these connections to find directions for further exploration.'])}</p><button type="button" class="button outline" data-grow-replay>{t(lang,['重新播放生长','Replay the growth'])} ↗</button></div></div></section>
<script>
for(const section of document.querySelectorAll<HTMLElement>('[data-interest-growth]')){const show=()=>section.classList.add('is-grown');const reduced=matchMedia('(prefers-reduced-motion: reduce)');if(reduced.matches)show();else{const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){show();observer.disconnect();}},{threshold:.2});observer.observe(section);}let timer:ReturnType<typeof setTimeout>;section.querySelector('[data-grow-replay]')?.addEventListener('click',()=>{clearTimeout(timer);if(reduced.matches){show();return;}section.classList.remove('is-grown');timer=setTimeout(show,80);});}
</script>
