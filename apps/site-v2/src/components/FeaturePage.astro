---
import {t,path,asset,v2Asset,demoUrl,type Lang} from '../config';import type {Feature} from '../data/features';import Icon from './Icon.astro';import FeatureArt from './FeatureArt.astro';import CTA from './CTA.astro';import courses from '../data/courses.json';import LearningShowcase from './LearningShowcase.astro';import InterestGrowth from './InterestGrowth.astro';import ReadingDepth from './ReadingDepth.astro';import CourseAreas from './CourseAreas.astro';import CourseCarousel from './CourseCarousel.astro';import EvaluationStory from './EvaluationStory.astro';import ProductVideo from './ProductVideo.astro';
const {lang,feature:f}=Astro.props as {lang:Lang;feature:Feature};
const projectTools=[['观察日记','Observation journal'],['头脑风暴','Brainstorming'],['问题识别','Problem framing'],['解决方案','Solution design'],['审核助手','Review assistant'],['理性决策','Decision making'],['结构审查','Structure review'],['分工建议','Division of work'],['项目复盘','Project reflection'],['长期迭代','Ongoing improvement']] as const;
---
<section class={`detail-hero ${f.tone} ${['explore','projects'].includes(f.id)?'character-hero':''}`}><div class="wrap detail-hero-inner"><div><a class="breadcrumb" href={path(lang,'product')}>{t(lang,['产品','Product'])} / {t(lang,f.name)}</a><span class="eyebrow">{f.label}</span><h1>{t(lang,f.title)}</h1><p class="hero-lead">{t(lang,f.desc)}</p><div class="actions"><a class="button" href={demoUrl}>{t(lang,['体验产品演示','Try the product demo'])}<Icon name="arrow"/></a><a class="text-link" href={path(lang,'research-studio')}>{t(lang,['深入研究','Explore Research Studio'])}<Icon name="arrow"/></a></div><p class="edition-note">{t(lang,f.edition)}</p></div>{['explore','projects'].includes(f.id)?<div class="detail-character"><img src={v2Asset(f.id==='explore'?'curious-learner-v2.webp':'project-makers-v2.webp')} width="1536" height="1024" alt={t(lang,[f.id==='explore'?'学生观察和探索':'学生共同设计与制作项目',f.id==='explore'?'A student observes and explores':'Students designing and making a project'])}/></div>:<div class="detail-art"><FeatureArt kind={f.id} lang={lang}/><span>{t(lang,['功能示意','Illustrative view'])}</span></div>}</div></section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">HOW LEARNING HAPPENS</span><h2>{t(lang,['有引导，也有自己的判断。','Guidance, with room for independent judgment.'])}</h2></div><p>{t(lang,['每一步都有具体行动。学生的选择、回答与修改，是学习过程的一部分。','Each step involves a concrete action. Students’ choices, responses and revisions are part of the learning process.'])}</p></div><ol class="steps-grid">{f.steps.map((s,i)=><li><span>0{i+1}</span><h3>{t(lang,s)}</h3><p>{t(lang,f.outcomes[i])}</p></li>)}</ol></section>
{['reading','writing','projects'].includes(f.id)&&<LearningShowcase lang={lang} focus={f.id}/>}
{f.image&&<section class="wrap screenshot-section"><figure class="product-figure"><div class="figure-bar"><span>Mind Imprint</span><span>{t(lang,['产品界面示例','Product interface example'])}</span></div><img src={asset(f.image)} alt={t(lang,[`${f.name[0]}产品界面示例`,`${f.name[1]} product interface example`])} width="1440" height="900" loading="lazy"/><figcaption>{t(lang,['现有产品界面。具体内容与可用功能因任务、版本和账号而异。','An existing product view. Content and available features vary by task, edition and account.'])}</figcaption></figure></section>}
{f.id==='explore'&&<InterestGrowth lang={lang}/>}
{f.id==='reading'&&<ReadingDepth lang={lang}/>}
{f.id==='courses'&&<><CourseCarousel lang={lang}/><CourseAreas lang={lang}/></>}
{f.id==='assessment'&&<><EvaluationStory lang={lang}/><section class="section wrap"><ProductVideo lang={lang} clip="case/07-evaluation-v1" title={['过程评估报告演示','A walkthrough of the process report']}/></section></>}
{f.id==='projects'&&<section class="section soft"><div class="wrap"><div class="section-head"><div><span class="eyebrow">TOOLS FOR THOUGHTFUL ACTION</span><h2>{t(lang,['计划之外，\n还有具体的思考工具。','A plan, and the tools\nto think it through.'])}</h2></div><p>{t(lang,['AI 可以协助整理、生成和制作。学生负责目标、调查、关键判断与成果审核，分工需要在项目中说清楚。','AI can help organize, generate and create. Students take responsibility for goals, investigation, key decisions and reviewing outcomes.'])}</p></div><div class="tool-index">{projectTools.map((tool,i)=><div><span>{String(i+1).padStart(2,'0')}</span><h3>{t(lang,tool)}</h3><Icon name={i%2?'shapes':'spark'}/></div>)}</div></div></section>}
{f.id==='assessment'&&<section class="section wrap"><div class="assessment-columns"><article><span class="eyebrow">DEPTH OF THINKING</span><h2>{t(lang,['思考有多深入？','How deeply did the student think?'])}</h2><p>{t(lang,['结合来源、证据、推理与反思，描述学生在这次学习中怎样处理问题。','Consider sources, evidence, reasoning and reflection to describe how the student approached this task.'])}</p></article><article><span class="eyebrow">LEARNER AUTONOMY</span><h2>{t(lang,['判断由谁作出？','Who made the judgments?'])}</h2><p>{t(lang,['区分学生与 AI 的参与，理解引导、依赖与自主判断之间的关系。','Distinguish the student’s contribution from AI support, considering guidance, reliance and independent judgment.'])}</p></article></div><p class="note">{t(lang,['两个维度分别呈现，不合成总分。报告用于理解具体过程，不替代教师专业判断，也不作为考试成绩预测。','The two dimensions are presented separately, never merged into a total score. Reports describe a process; they do not replace professional judgment or predict examination results.'])}</p><a class="button outline" href={asset('evaluation/report-sample-v1.pdf')} target="_blank" rel="noreferrer">{t(lang,['查看完整报告示例 · PDF','View a complete sample report · PDF'])}<Icon name="arrow"/></a></section>}
{f.id==='writing'&&<section class="section soft"><div class="wrap principle-split"><h2>{t(lang,['正文由学生撰写。\nAI 提供问题与反馈。','Students write.\nAI offers prompts and feedback.'])}</h2><div><p>{t(lang,['印记帮助检查论证与结构，学生选择如何回应，并自己修改文章。在回顾中，诚实说明 AI 和人的分工。','Imprint helps examine arguments and structure. Students decide how to respond and revise their own work. Reflection makes human and AI contributions explicit.'])}</p><a class="text-link" href={path(lang,'product/assessment')}>{t(lang,['了解过程如何被记录','See how the process is recorded'])}<Icon name="arrow"/></a></div></div></section>}
{f.id==='courses'&&<section class="section wrap" id="course-library"><div class="section-head"><div><span class="eyebrow">THE COURSE COLLECTION</span><h2>{t(lang,['为真实问题，\n学习思考方法。','Real questions.\nPractical thinking methods.'])}</h2></div><p>{t(lang,['浏览课程主题与能力方向。具体可学习的课程，以所在版本的课程目录为准。','Browse topics and thinking skills. The courses available to a learner depend on their edition’s course catalog.'])}</p></div><div class="library-controls"><label>{t(lang,['搜索课程','Search courses'])}<input type="search" data-library-search placeholder={t(lang,['输入标题或关键词','Search titles or keywords'])}/></label><label>{t(lang,['能力方向','Focus'])}<select data-library-category><option value="all">{t(lang,['全部方向','All focuses'])}</option>{[['src','信息与信源','Information & sources'],['data','证据与数据','Evidence & data'],['arg','论证与写作','Argument & writing'],['res','研究与项目','Research & projects'],['ai','AI 与元认知','AI & metacognition']].map(([value,zh,en])=><option value={value}>{t(lang,[zh,en])}</option>)}</select></label><p class="library-count" aria-live="polite"><span data-library-count>{courses.length}</span> {t(lang,['门课程','courses'])}</p></div><div class="course-grid">{courses.map(c=><details id={`course-${c.n}`} class="course-entry" data-library-item data-category={c.tags} data-search={`${c.zh} ${c.en} ${c.fz} ${c.fe}`}><summary><img src={asset(`courses/cover/${String(c.n).padStart(2,'0')}-v1.webp`)} width="640" height="360" loading="lazy" alt=""/><div class="course-entry-text"><span class="little-label">{t(lang,[c.fz,c.fe])}</span><h3>{t(lang,[c.zh,c.en])}</h3><span class="course-expand">{t(lang,['课程介绍','Course description'])} <span>+</span></span></div></summary><div class="course-description"><p>{t(lang,[c.dz,c.de])}</p><a class="text-link" href={demoUrl}>{t(lang,['进入产品了解课程','Explore courses in the product'])}<Icon name="arrow"/></a></div></details>)}</div><p data-library-empty hidden>{t(lang,['没有匹配的课程，请调整关键词或方向。','No matching courses. Try a different keyword or focus.'])}</p></section>}
<CTA lang={lang}/>
<script>
const search=document.querySelector<HTMLInputElement>('[data-library-search]');const category=document.querySelector<HTMLSelectElement>('[data-library-category]');const items=Array.from(document.querySelectorAll<HTMLElement>('[data-library-item]'));const filter=()=>{let count=0;const q=search?.value.trim().toLowerCase()||'';const selected=category?.value||'all';items.forEach(item=>{const show=(item.dataset.search||'').toLowerCase().includes(q)&&(selected==='all'||(item.dataset.category||'').split(' ').includes(selected));item.hidden=!show;if(show)count++});const display=document.querySelector('[data-library-count]');if(display)display.textContent=String(count);const empty=document.querySelector<HTMLElement>('[data-library-empty]');if(empty)empty.hidden=count>0;};search?.addEventListener('input',filter);category?.addEventListener('change',filter);
const openLinkedCourse=()=>{const id=window.location.hash.slice(1);if(!/^course-\d+$/.test(id))return;const entry=document.getElementById(id);if(!(entry instanceof HTMLDetailsElement))return;if(search)search.value='';if(category)category.value='all';filter();entry.open=true;requestAnimationFrame(()=>entry.scrollIntoView({block:'start'}));};window.addEventListener('hashchange',openLinkedCourse);openLinkedCourse();
</script>
