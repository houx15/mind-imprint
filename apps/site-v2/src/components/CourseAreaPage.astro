---
import {t,path,asset,type Lang} from '../config';import type {CourseArea} from '../data/courseAreas';import courses from '../data/courses.json';import ProductVideo from './ProductVideo.astro';import CTA from './CTA.astro';
const {lang,area}=Astro.props as {lang:Lang;area:CourseArea};const selected=area.courses.map(n=>courses.find(c=>c.n===n)!);
---
<section class="product-intro"><div class="wrap page-intro"><a class="breadcrumb" href={path(lang,'product/courses')+'#course-areas'}>{t(lang,['课程体系','Curriculum'])} / {t(lang,area.name)}</a><span class="eyebrow">{t(lang,area.name)}</span><h1>{t(lang,area.question)}</h1><p>{t(lang,area.intro)}</p></div></section><section class="section wrap"><div class="principle-split"><div><span class="eyebrow">IN THE CLASSROOM</span><h2>{t(lang,['学生具体做什么？','What do students do?'])}</h2></div><div><p>{t(lang,area.activity)}</p><p>{t(lang,area.context)}</p><div class="note-tags">{area.tools.map(tool=><b>{tool}</b>)}</div></div></div></section>
{area.clip&&<section class="wrap"><ProductVideo lang={lang} clip={area.clip} title={area.name}/></section>}
{area.id==='source-evaluation'&&<section class="section wrap"><ProductVideo lang={lang} clip="courses/sift-v1" title={['SIFT 横向核查课程','SIFT lateral reading course']} description={['从一条信息追查出处，再形成有证据的论证。','Trace a claim to its source and develop an evidence-based argument.']}/></section>}
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">EXPLORE THE LESSONS</span><h2>{t(lang,['这个板块里的课程','Courses in this area'])}</h2></div><p>{t(lang,['课程可跨多个板块使用。下列介绍来自现有课程库。','Courses can connect more than one area. These descriptions come from the existing course collection.'])}</p></div><div class="area-course-grid">{selected.map(c=><article><img src={asset(`courses/cover/${String(c.n).padStart(2,'0')}-v1.webp`)} width="640" height="360" loading="lazy" alt=""/><div><span class="eyebrow">{t(lang,[c.fz,c.fe])}</span><h3>{t(lang,[c.zh,c.en])}</h3><p>{t(lang,[c.dz,c.de])}</p><a class="text-link" href={path(lang,'product/courses')+`#course-${c.n}`}>{t(lang,['在课程目录中查看','View in the course catalog'])} ↗</a></div></article>)}</div></section><CTA lang={lang}/>
