---
import {t,path,asset,type Lang,type Copy} from '../config';
import courses from '../data/courses.json';
import Icon from './Icon.astro';
const {lang,focus='all'}=Astro.props as {lang:Lang;focus?:string};
const topics: {n:number;title:Copy;activity:Copy}[]=[
{n:30,title:['更有判断力地使用 AI','Use AI with better judgment'],activity:['提出问题，检查回答，并核对原始来源。','Write a prompt, examine the response and check the original sources.']},
{n:33,title:['讨论 AI 伦理','Examine the ethics of AI'],activity:['从训练数据、版权、劳动与能源，讨论谁承担成本。','Discuss training data, copyright, labour and energy—and who bears the costs.']},
{n:20,title:['判断图片、视频与信息','Investigate what you see online'],activity:['练习核查生成式媒体的来源与上下文。','Practice checking the source and context of AI-generated media.']},
{n:16,title:['识别数据中的误导','Question the numbers'],activity:['检查坐标轴、分母与比较对象，再判断图表的结论。','Check axes, denominators and comparisons before accepting a chart’s conclusion.']}
];
---
{['all','courses'].includes(focus)&&<section class="section wrap learning-showcase" id="ai-literacy"><div class="section-head"><div><span class="eyebrow">LITERACIES FOR LIFE WITH AI</span><h2>{t(lang,['理解 AI。辨识信息。\n形成自己的判断。','Understand AI. Read the world.\nMake your own judgments.'])}</h2></div><p>{t(lang,['从 AI 使用与伦理，到媒体、数据和论证。用具体问题与互动活动，练习课堂内外都需要的方法。','From AI use and ethics to media, data and argument. Concrete questions and interactive activities give students methods to use across subjects.'])}</p></div><div class="literacy-grid">{topics.map(topic=><a class="literacy-card" href={path(lang,'product/courses')+`#course-${topic.n}`}><img src={asset(`courses/cover/${String(topic.n).padStart(2,'0')}-v1.webp`)} width="640" height="360" loading="lazy" alt=""/><div><span class="little-label">{t(lang,['课程精选','FROM THE COURSE COLLECTION'])}</span><h3>{t(lang,topic.title)}</h3><p>{t(lang,topic.activity)}</p><span class="text-link">{t(lang,['查看课程','Explore the course'])}<Icon name="arrow"/></span></div></a>)}</div><a class="text-link showcase-more" href={path(lang,'product/courses')+'#course-library'}>{t(lang,[`浏览 ${courses.length} 门课程：信息、论证、研究、AI 与自我认知`,`Browse ${courses.length} courses in information, argument, research, AI and self-awareness`])}<Icon name="arrow"/></a></section>}
{['all','reading','writing'].includes(focus)&&<section class="section bilingual-band" id="bilingual-learning"><div class="wrap bilingual-grid"><div><span class="eyebrow">READ & WRITE · 中文 + ENGLISH</span><h2>{t(lang,['两种语言，\n都值得深入思考。','Two languages.\nRoom for your own voice.'])}</h2><p>{t(lang,['带入中文或英文材料，理解作者的观点、检查证据；在自己的写作中组织论证，回应不同意见，再根据反馈修改。学生自己撰写正文。','Bring a Chinese or English text. Examine the author’s claims and evidence, develop an argument, consider other perspectives and revise with feedback. Students write their own work.'])}</p><div class="actions"><a class="text-link" href={path(lang,'product/reading')}>{t(lang,['探索阅读','Explore reading'])}<Icon name="arrow"/></a><a class="text-link" href={path(lang,'product/writing')}>{t(lang,['探索写作','Explore writing'])}<Icon name="arrow"/></a></div></div><div class="language-notes"><article lang="en"><span>ENGLISH · {t(lang,['学习活动示例','ILLUSTRATIVE ACTIVITY'])}</span><h3>Should our school change its uniform policy?</h3><p>Which evidence supports your claim? What would someone who disagrees point out?</p><div class="note-tags"><b>Claim</b><b>Evidence</b><b>Counterargument</b></div></article><article lang="zh-CN"><span>中文 · {t(lang,['学习活动示例','ILLUSTRATIVE ACTIVITY'])}</span><h3>学校是否应该调整校服规定？</h3><p>哪些证据支持你的观点？持不同意见的人可能提出什么问题？</p><div class="note-tags"><b>观点</b><b>证据</b><b>反方意见</b></div></article></div></div></section>}
{['all','projects'].includes(focus)&&<section class="section wrap" id="create-projects"><div class="section-head"><div><span class="eyebrow">OBSERVE. DESIGN. MAKE.</span><h2>{t(lang,['从现实观察，\n到自己做出的作品。','Notice a real problem.\nMake something that responds.'])}</h2></div><p>{t(lang,['项目可以是一项调查、一个设计方案，或学生自己的网站。AI 协助计划与制作，学生负责方向、审核和改进。','A project can become an investigation, a design proposal or a student’s own website. AI helps with planning and production; students direct, review and improve the work.'])}</p></div><div class="project-examples"><div class="website-example"><div class="mock-browser"><span>● ● ●</span><span>{t(lang,['学生网站 · 示意','STUDENT WEBSITE · ILLUSTRATION'])}</span></div><div class="mock-site"><span>OUR SCHOOL / OUR IDEAS</span><h3>A little less waste.<br/>A lot more possibility.</h3><div class="mock-site-graphic" aria-hidden="true">↗ <span>✳</span></div><p>A student project about everyday choices on campus.</p><span class="mock-site-link">Explore our observations ↗</span></div></div><div class="project-path"><article><span>01 / OBSERVE</span><h3>{t(lang,['观察身边的真实问题','Observe the world around you'])}</h3><p>{t(lang,['例如记录校园浪费现象，收集观察和调查结果。','For example, document waste on campus and collect observations and survey findings.'])}</p></article><article><span>02 / CREATE</span><h3>{t(lang,['设计方案，制作自己的网站','Design a response. Build your own website.'])}</h3><p>{t(lang,['确定受众、内容与页面设计，和 AI 协作制作并审核成果。','Choose an audience, content and page design. Work with AI to create and review the result.'])}</p></article><article><span>03 / IMPROVE</span><h3>{t(lang,['收集反馈，继续改进','Gather feedback. Improve the work.'])}</h3><p>{t(lang,['请他人试用，记录问题，并解释自己的修改。','Invite others to try it, record problems and explain your revisions.'])}</p></article><a class="text-link" href={path(lang,'product/projects')}>{t(lang,['了解项目式学习','Explore project-based learning'])}<Icon name="arrow"/></a></div></div><p class="note">{t(lang,['以上为教学场景与网站示意，不是实际学生作品。','Illustrative teaching scenario and website, not an actual student submission.'])}</p></section>}
