---
import {courseAreas} from '../data/courseAreas';import CourseAreaPage from '../components/CourseAreaPage.astro';import Shell from '../layouts/Shell.astro';import Home from '../components/Home.astro';import Schools from '../components/Schools.astro';import Resources from '../components/Resources.astro';import MorePages from '../components/MorePages.astro';import FeaturePage from '../components/FeaturePage.astro';import {features} from '../data/features';import {t,type Lang,type Copy} from '../config';
export function getStaticPaths(){const slugs=['','product','schools','resources','editions','research-studio','about',...courseAreas.map(a=>`courses/${a.id}`),...features.map(f=>`product/${f.id}`)];return (['en','zh'] as const).flatMap(lang=>slugs.map(slug=>({params:{page:[lang==='zh'?'zh':'',slug].filter(Boolean).join('/')||undefined},props:{lang,slug}})))}
const {lang,slug}=Astro.props as {lang:Lang;slug:string};const area=courseAreas.find(a=>`courses/${a.id}`===slug);const feature=features.find(f=>`product/${f.id}`===slug);const titles:Record<string,Copy>={product:['产品全览','The platform'],schools:['学校与教师','Schools & educators'],resources:['教学资源','Thinking tools'],editions:['研究空间','Research Studio'],'research-studio':['研究空间','Research Studio'],about:['关于思维印记','About the Mark of Thinking']};const title=area?t(lang,area.name):feature?t(lang,feature.name):titles[slug]?t(lang,titles[slug]):undefined;
---
<Shell lang={lang} slug={slug} title={title} description={feature?t(lang,feature.desc):undefined}>
{area?<CourseAreaPage lang={lang} area={area}/>:slug===''?<Home lang={lang}/>:feature?<FeaturePage lang={lang} feature={feature}/>:slug==='schools'?<Schools lang={lang}/>:slug==='resources'?<Resources lang={lang}/>:<MorePages lang={lang} slug={slug}/>}
</Shell>
