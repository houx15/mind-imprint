---
import Base from "../layouts/Base.astro";
import AboutPage from "../components/pages/AboutPage.astro";
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  title={t(lang, "关于我们 | 思维印记", "About us | The Mark of Thinking")}
  description={t(
    lang,
    "团队、四条红线与六项承诺：红线拦住 AI 越界替孩子思考，承诺拦住平台越界使用孩子的思考。以及学校如何以班级为单位接入。",
    "The team, four red lines and six commitments: the red lines stop the AI thinking for a child, the commitments stop the platform misusing what the child thought. Plus how schools roll out class by class.",
  )}
>
  <AboutPage />
</Base>
