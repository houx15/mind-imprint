---
// Site-wide 404. Served by the container nginx via `error_page 404 /404.html`,
// so it has to stand alone for both language trees — hence both languages here
// rather than the usual t() switch.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { localePath } from "../i18n/utils";

const links: [string, string, string][] = [
  ["/", "首页", "Home"],
  ["/product", "产品", "Product"],
  ["/algorithm", "算法", "Algorithm"],
  ["/about", "关于我们", "About"],
];
---

<Base
  title="页面不存在 · Page not found | 思维印记 The Mark of Thinking"
  description="这个地址没有对应的页面。 This address has no page behind it."
>
  <section class="pagehero" style="padding-block: 120px 40px">
    <div class="wash">
      <i class="w1" style="width:520px;height:520px;background:var(--primary-tint);top:-260px;left:-140px"></i>
      <i class="w2" style="width:420px;height:420px;background:var(--accent-tint);top:-180px;right:-120px"></i>
    </div>
    <div class="pagehero-inner">
      <div class="eyebrow"><span class="pip"></span>404</div>
      <h1 class="page-title" style="margin-top:22px">
        这个地址后面没有页面。<br />
        <span class="soft">This address has no page behind it.</span>
      </h1>
      <p class="lead">
        链接可能过期了，或者被我们改掉了。下面几页应该是你要找的。<br />
        The link may be stale, or we moved it. One of these is probably what you wanted.
      </p>

      <div class="chips" style="margin-top:34px">
        {links.map(([href, zh, en]) => (
          <a class="chip" href={localePath("zh", href)}>{zh} · {en}</a>
        ))}
      </div>

      <div class="cta-row" style="margin-top:34px">
        <a class="btn btn-lg btn-primary" href={localePath("zh", "/")}>
          回到首页 · Back home<Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>
  </section>
</Base>
