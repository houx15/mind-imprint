---
import Base from "../layouts/Base.astro";
import HomePage from "../components/pages/HomePage.astro";
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  title={t(
    lang,
    "思维印记 · 作品不再证明人，过程可以",
    "Mind Imprint · The work no longer proves the person. The process does.",
  )}
  description={t(
    lang,
    "思维印记是一套探究过程证据与判断力评估系统：课程、思维工具卡、阅读与写作工作室，把学生与 AI 协作的全过程记录成一条可追溯的证据链，并用认知深度与智识自主两根轴读出读数。",
    "Mind Imprint is an inquiry-process evidence and judgment assessment system: courses, thinking cards, reading and writing studios. It records how students work with AI as a traceable chain of evidence, read along two axes — cognitive depth and intellectual autonomy.",
  )}
>
  <HomePage />
</Base>
