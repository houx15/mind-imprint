---
import Base from "../layouts/Base.astro";
import ProductPage from "../components/pages/ProductPage.astro";
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  title={t(
    lang,
    "产品 · 项目、工具、评估 | 思维印记",
    "Product · projects, tools, evaluation | Mind Imprint",
  )}
  description={t(
    lang,
    "三个部分：学生在项目里做真实课题（六站主线、阅读工作室、写作面），用 34 张思维工具卡与 9 个学科透镜把方法练成习惯，最后由双轴过程评估与教师端把过程读出来。",
    "Three parts: real coursework inside a project (six-station spine, reading studio, writing surface), 34 thinking cards and 9 disciplinary lenses that turn method into habit, and a two-axis process evaluation plus teacher console that read the process back.",
  )}
>
  <ProductPage />
</Base>
