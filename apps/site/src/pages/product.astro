---
import Base from "../layouts/Base.astro";
import ProductPage from "../components/pages/ProductPage.astro";
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  title={t(
    lang,
    "完整案例 | 思维印记",
    "Product overview | The Mark of Thinking",
  )}
  description={t(
    lang,
    "四个部分：AI 互动课程、AI 写作教练、过程评估报告、教师端全过程数据。附一个完整的用户案例，从学方法到拿到评估报告。",
    "Four parts: the AI courses, the AI writing coach, the process assessment, and the teacher console — with one full case study from learning a method to receiving the report.",
  )}
>
  <ProductPage />
</Base>
