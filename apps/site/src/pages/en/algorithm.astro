---
import Base from "../../layouts/Base.astro";
import AlgorithmPage from "../../components/pages/AlgorithmPage.astro";
import { getLang, t } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  title={t(
    lang,
    "技术 · 让 AI 学会什么时候别答 | 思维印记",
    "Technology · teaching an AI when not to answer | The Mark of Thinking",
  )}
  description={t(
    lang,
    "五层系统：决定 AI 什么时候闭嘴的克制层、schema 驱动的工具卡运行时、写作侧一条连续会话加隔离子代理与课程侧的确定性状态机、把每个动作变成事件的记录层，以及只能引用证据索引的评估层。",
    "Five layers: a restraint layer that decides when the AI stays quiet, a schema-driven card runtime, one continuous session with isolated sub-agents for writing and a deterministic state machine for courses, a record layer that turns every move into an event, and an evaluation layer bound to an evidence index.",
  )}
>
  <AlgorithmPage />
</Base>
