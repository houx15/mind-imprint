---
import Base from "../../layouts/Base.astro";
import ProductPage from "../../components/pages/ProductPage.astro";
import { getLang, t } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  title={t(
    lang,
    "产品总览 | 思维印记",
    "Product overview | Mind Imprint",
  )}
  description={t(
    lang,
    "四个部分：课程与工具卡、探究性写作空间、过程性评估报告、教师端全过程数据。附一个完整的用户案例，从学方法到拿到评估报告。",
    "Four parts: courses and thinking cards, the inquiry writing space, the process assessment report, and the teacher console — with one full case study from learning a method to receiving the report.",
  )}
>
  <ProductPage />
</Base>
