---
import Base from "../../layouts/Base.astro";
import HomePage from "../../components/pages/HomePage.astro";
import { getLang, t } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);
---

<Base
  immersive
  title={t(
    lang,
    "思维印记 · 和 AI 一起学，判断自己下",
    "Mind Imprint · Learn with the AI. Own the judgment.",
  )}
  description={t(
    lang,
    "思维印记是给中学生的 AI 学习空间：他带着真实课题进来，AI 陪他查资料、追问、改稿，但从不代写正文、不替他下结论。全过程留痕，最后生成一份看得见他怎么想的评估报告。",
    "Mind Imprint is an AI workspace for secondary students. They bring real coursework; the AI searches, questions and reviews alongside them, and never writes their prose or settles the answer. Every step is recorded, and becomes a report you can read their thinking in.",
  )}
>
  <HomePage />
</Base>
