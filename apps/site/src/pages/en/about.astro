---
import Base from "../../layouts/Base.astro";
import AboutPage from "../../components/pages/AboutPage.astro";
import { getLang, t } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);
---
<Base
  title={t(lang, "关于 · 思维印记", "About · Mind Imprint")}
  description={t(lang,
    "在 AI 时代，善用 AI 是可教、可见、可评估的素养。思维印记扎根于 IB 教学法、信息素养与论证训练，占「思考」这一层，不拥有学生的文档。",
    "Using AI well is a teachable, visible, assessable literacy. Mind Imprint is rooted in IB pedagogy, information literacy and argument training — it holds the thinking layer, never the student's document."
  )}
>
  <AboutPage />
</Base>
