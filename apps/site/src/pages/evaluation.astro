---
import Base from "../layouts/Base.astro";
import EvaluationPage from "../components/pages/EvaluationPage.astro";
import { getLang, t } from "../i18n/utils";
const lang = getLang(Astro.currentLocale);
---
<Base
  title={t(lang, "评估模型 · 思维印记", "The Evaluation Model · Mind Imprint")}
  description={t(lang,
    "思维印记评估的是学生思考的整个过程：用最强的模型，从十个维度、四个成长阶段给出诊断式评级，只给学生本人看。",
    "Mind Imprint evaluates the student's whole thinking process — the strongest model rates ten dimensions across four stages of growth, private to the student."
  )}
>
  <EvaluationPage />
</Base>
