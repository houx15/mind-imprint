---
import Icon from "../Icon.astro";
import HeroImmersive from "../sections/HeroImmersive.astro";
import CtaBand from "../sections/CtaBand.astro";
import Pager from "../sections/Pager.astro";
import { getLang, t, localePath } from "../../i18n/utils";
import { demoUrl } from "../../config";

const lang = getLang(Astro.currentLocale);
const L = (p: string) => localePath(lang, p);

/** Screen two: what a student's day with AI actually looks like now. */
const scenes: [string, string, string, string, string][] = [
  [
    "quote",
    "答案来得太快",
    "The answer arrives too fast",
    "通顺、完整、看上去很有道理。要不要停下来问一句「这是真的吗」，全凭习惯。",
    "Fluent, complete, plausible. Whether anyone stops to ask “is this true” comes down to habit.",
  ],
  [
    "target",
    "知道该怀疑，说不出哪里不对",
    "Suspicious, but can't say why",
    "刷到「每天一杯柠檬水可以抗癌」，他知道多半有问题，却不知道从哪查起，也不知道查到什么程度算数。",
    "“A glass of lemon water a day prevents cancer.” He senses it's off — but not where to start checking, or what would settle it.",
  ],
  [
    "route",
    "交上去了，说不清哪些是自己想的",
    "Handed in, and can't say which part was his",
    "过程散落在几十条聊天记录里。没有人看得清他到底想了什么，包括他自己。",
    "The process is scattered across dozens of chat messages. Nobody can see what he actually thought — including him.",
  ],
];

const eras: [string, string, string, string, string, string][] = [
  ["信息不足的时代", "When information was scarce", "获取", "Acquire", "找得到材料的人占优势。", "The advantage went to whoever could find the material."],
  ["信息过剩的时代", "When information overflowed", "筛选", "Filter", "找得到不难了，选得对才难。", "Finding got easy. Choosing well did not."],
  ["答案过剩的时代", "When answers overflow", "判断", "Judge", "一堆彼此竞争、看上去都挺像样的结论摆在面前，得决定信哪一个、用哪一个。", "A pile of competing, plausible-looking conclusions — and a call to make about which to believe and use."],
];

/** The three abilities this product is built to grow. */
const abilities: [string, string, string, string, string, string][] = [
  [
    "layers",
    "批判性思维",
    "Critical thinking",
    "追到一手来源，读清一条证据能证明到哪一步，接得住反方，也守得住结论的强度。",
    "Trace a claim to its primary source, read how far a piece of evidence actually reaches, take on the counter-case, and keep the conclusion within its bounds.",
    "",
  ],
  [
    "compass",
    "探索能力",
    "Exploring on his own",
    "把一个模糊的兴趣收窄成能回答的问题，自己决定往哪里深挖，也知道什么时候该收手。",
    "Narrow a vague interest into an answerable question, decide where to dig — and know when to stop digging.",
    "a",
  ],
  [
    "hand",
    "和 AI 协作的分寸",
    "A working line with AI",
    "知道什么可以交给 AI、什么必须自己来；对它的建议说「不」的时候，说得出理由。",
    "Know what to hand the AI and what to keep. And when refusing its suggestion, be able to say why.",
    "g",
  ],
];

/** The scrub steps — each has its own screenshot slot. */
const walk: {
  k: [string, string];
  h: [string, string];
  p: [string, string];
  asset: string;
  brief: [string, string];
}[] = [
  {
    k: ["01 · 课程与工具卡", "01 · Course & cards"],
    h: ["一门课，交给她一套能带走的方法", "A course hands her a method she can take away"],
    p: [
      "一门课就是一条工作流：看材料、被追问、做判断、填一张工具卡，一步步推进。CRAAP、SIFT、良构论证都在真实材料上走过一遍——方法在用过之后才真正到手。",
      "A course is a workflow: watch the material, get questioned, make a call, fill in a card, move on. CRAAP, SIFT and well-formed argument all get practised on real material — a method only really lands once it has been used.",
    ],
    asset: "home-01-course-player",
    brief: ["课程播放界面：视频 + 旁白 + 一张工具卡被递出来", "Course player: video + narration + a card being handed over"],
  },
  {
    k: ["02 · 阅读工作室", "02 · Reading studio"],
    h: ["一条没标出处的推文，她自己追到了 Nature", "An unsourced post — and she traced it to Nature herself"],
    p: [
      "推文说「全球变绿 40% 以上来自中国」。她跳出页面横向核查：公众号 → NASA 发布稿 → Nature Sustainability 原论文，然后发现分母被换过——原文的 42% 说的是中国自己那部分变绿里森林工程的占比。",
      "The post claimed “over 40% of the Earth's greening comes from China”. She read laterally — post → NASA release → the Nature Sustainability paper — and found the denominator had been swapped. The original 42% was the share of China's own greening due to forest programmes.",
    ],
    asset: "home-02-reading-room",
    brief: ["阅读室：原文 + 溯源链 + 探索图谱", "Reading room: source text + provenance chain + exploration map"],
  },
  {
    k: ["03 · 写作项目空间", "03 · Writing project space"],
    h: ["论证撞上反例，让步段是她自己写的", "The argument hits a counter-example — she writes the concession"],
    p: [
      "中国碳排放全球第一。这条反方证据推翻不了她的题目，但会限制她的结论。AI 不会替她写一个字正文，它只会问：你打算接住它，还是绕开它？",
      "China is the world's largest emitter. That counter-evidence doesn't sink her thesis, but it does bound her conclusion. The AI writes none of her prose — it only asks: are you going to take this on, or route around it?",
    ],
    asset: "home-03-writing-studio",
    brief: ["写作面：正文编辑区 + 右侧只读过程树", "Writing surface: the draft, with the read-only process tree alongside"],
  },
  {
    k: ["04 · 过程评估", "04 · Process evaluation"],
    h: ["连她跳过的那一次，也被记下来了", "Even the time she skipped is on the record"],
    p: [
      "报告分两半：数出来的事实，和有证据支撑的判断。每一条判断都要指回一个真实存在的片段，指不到的直接丢弃。两根轴分开报告，不合成总分。",
      "The report has two halves: facts that are counted, and judgments that are grounded. Every judgment must point back to a real fragment — the ones that can't are dropped. The two axes are reported apart, never merged into a single score.",
    ],
    asset: "home-04-evaluation-report",
    brief: ["评估报告：双轴读数 + 证据链接 + 过程叙述", "Evaluation report: the two axes, evidence links, process narrative"],
  },
];

const surfaces: [string, string, string, string, string, string, string][] = [
  ["pen", "projects", "写作项目空间", "Writing project space", "带着真实课题进来：立题、找文献、阅读溯源、写作、回顾。一条连续的对话陪着走完，正文他自己写。", "He brings real coursework: framing, sources, reading, writing, review. One continuous conversation walks it with him, and he writes the prose.", ""],
  ["cards", "tools", "课程与工具卡", "Courses & thinking cards", "34 张思维工具卡、9 个学科透镜。课程负责把方法教会，工具卡负责在需要的那一刻被递到手上。", "34 thinking cards and 9 disciplinary lenses. Courses teach the method; a card puts it in his hands at the moment he needs it.", "a"],
  ["gauge", "evaluation", "过程评估", "Process evaluation", "认知深度与智识自主分开测量、分开报告。每一条判断都能点开背后那条真实记录。", "Cognitive depth and intellectual autonomy, measured and reported apart. Every judgment opens onto the record behind it.", "g"],
  ["users", "evaluation", "教师端", "Teacher console", "教师终于看得见过程：叙述版周报、实时名单、可点开的证据，以及一键改判。", "Teachers can finally see the process: a narrated week, a live roster, openable evidence — and a one-click override.", "m"],
];

const stats: [string, number, string, string, string][] = [
  ["", 34, "", "张思维工具卡", "thinking cards"],
  ["", 9, "", "个学科透镜", "disciplinary lenses"],
  ["", 6, "", "站探究主线", "inquiry stations"],
  ["", 12, "", "个可观察的测量点", "observable measurement points"],
];
---

<HeroImmersive />

<!-- ═══════════════════════════════════ WHERE STUDENTS ARE NOW ════ -->
<section class="section">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "现在的处境", "Where students are now")}</div>
      <h2 class="sec-title">
        {t(lang, "学生已经在用 AI 了，问题是怎么用", "Students already use AI. The question is how.")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "他们不缺工具，缺的是把判断真正做出来的机会。一个问题丢给 AI，三十秒就有一段通顺完整的回答；这段回答对不对、能不能用、有没有更站得住的说法，常常没有下一句追问。",
          "They don't lack tools. They lack occasions to actually make a judgment. Ask the AI something and thirty seconds later a fluent, complete answer is sitting there — and whether it's right, whether it can be used, whether something better-founded exists, usually goes unasked.",
        )}
      </p>
    </div>

    <div class="grid-3" style="margin-top:52px">
      {scenes.map(([icon, zh, en, pz, pe], i) => (
        <div class="card hoverable rv" style={`--i:${i}`}>
          <div class="cardic a"><Icon name={icon} /></div>
          <h3>{t(lang, zh, en)}</h3>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <div class="pull rv" style="margin-top:64px; max-width:900px">
      {t(
        lang,
        "生成式 AI 改变的，是学校判断一个学生学到了什么的整套证据。",
        "What generative AI changed is the whole body of evidence a school uses to judge what a student has learned.",
      )}
      <cite>{t(lang, "《思维印记产品白皮书》· 前言", "Mind Imprint white paper · Preface")}</cite>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════ THE ERA LADDER ═══════ -->
<section class="section band-paper">
  <div class="container">
    <div class="sec-head center rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "稀缺的东西变了", "What's scarce has changed")}</div>
      <h2 class="sec-title">{t(lang, "从信息过剩，到答案过剩", "From too much information to too many answers")}</h2>
      <p class="lead">
        {t(
          lang,
          "教育的难题总是跟着当时最稀缺的那种能力走。今天最稀缺的是判断：看上去都挺像样的结论摆了一桌，得决定信哪一个、用哪一个。",
          "Education's hard problem always tracks whichever ability is scarcest at the time. Today that's judgment: a table full of plausible-looking conclusions, and a call to make about which to believe and which to use.",
        )}
      </p>
    </div>

    <div class="era rv-pop" style="margin-top:52px">
      {eras.map(([wz, we, kz, ke, pz, pe]) => (
        <div class="e">
          <div class="when">{t(lang, wz, we)}</div>
          <div class="what">{t(lang, kz, ke)}</div>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <p class="body rv" style="margin-top:34px; max-width:760px">
      {t(
        lang,
        "判断是很具体的动作：这个来源能不能用，这条证据能证明到哪一步，AI 这段建议哪里站不住，自己的立场要不要改。思维印记保存下来的，就是这些动作发生的过程。",
        "Judgment is a set of concrete moves. Whether a source can be used. How far a piece of evidence reaches. Where the AI's suggestion breaks. Whether your own position needs to move. What Mind Imprint keeps is the process where those moves happen.",
      )}
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════ THREE ABILITIES ═══════ -->
<section class="section">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "我们想练出来的", "What we set out to grow")}</div>
      <h2 class="sec-title">{t(lang, "三件事，练在他自己的课题上", "Three things, practised on his own coursework")}</h2>
      <p class="lead">
        {t(
          lang,
          "这三件事都没法在纸面上学会。它们只在一个够长、够真实、AI 真的帮得上忙也真的可能把人带偏的任务里，才有机会长出来。",
          "None of the three can be learned on paper. They only grow inside a task long enough and real enough that the AI can genuinely help — and genuinely lead someone astray.",
        )}
      </p>
    </div>

    <div class="grid-3" style="margin-top:52px">
      {abilities.map(([icon, zh, en, pz, pe, tone], i) => (
        <div class="card hoverable rv" style={`--i:${i}`}>
          <div class={`cardic ${tone}`}><Icon name={icon} /></div>
          <h3>{t(lang, zh, en)}</h3>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <div class="callout yes rv" style="margin-top:36px">
      <div class="cl"><Icon name="shield" />{t(lang, "安全在这里的意思", "What “safe” means here")}</div>
      <h3>{t(lang, "学生能放心用，学校也能放心让他用", "A student can use it freely, and a school can let them")}</h3>
      <p>
        {t(
          lang,
          "AI 不代写正文、不替学生定论；产品里没有连胜、排行榜、徽章这类留人的机制；测量数据永不用于筛选、排名或惩戒，家长知情同意先于任何记录。这些写在权限和合同里，不只写在隐私政策里。",
          "The AI writes no prose and settles nothing. There are no streaks, leaderboards or badges holding anyone here. Measurement is never used for selection, ranking or discipline, and informed parental consent comes before any of it is recorded — written into permissions and contracts, not only into a privacy policy.",
        )}
      </p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ THE WALK (scrub) ════ -->
<section class="section loose scrub band-paper">
  <div class="container">
    <div class="sec-head rv" style="margin-bottom:56px">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "一次真实探究", "One real inquiry")}</div>
      <h2 class="sec-title">
        {t(lang, "「中国有没有让地球变得更可持续？」", "“Has China made the planet more sustainable?”")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "一个学生，一篇 800 词的文章，四个工作面。下面是她真的走过的路。",
          "One student, an 800-word essay, four surfaces. Below is the route she actually took.",
        )}
      </p>
    </div>

    <div class="scrub-grid">
      <div class="scrub-steps">
        {walk.map((s) => (
          <div class="scrub-step">
            <div class="k">{t(lang, s.k[0], s.k[1])}</div>
            <h3>{t(lang, s.h[0], s.h[1])}</h3>
            <p>{t(lang, s.p[0], s.p[1])}</p>
          </div>
        ))}
      </div>

      <div class="scrub-sticky">
        <div class="shotstack">
          {walk.map((s, i) => (
            <div class="shot" data-shot={i}>
              <div class="figure ratio-16-9" data-asset={s.asset}>
                <div class="fslot">
                  <div class="ficon"><Icon name="image" /></div>
                  <div class="fname">{s.asset}</div>
                  <div class="fdesc">{t(lang, s.brief[0], s.brief[1])}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════ SURFACES ═══════ -->
<section class="section band-cool">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "四个地方", "Four places")}</div>
      <h2 class="sec-title">{t(lang, "学生在这四个地方花时间", "The four places a student spends time")}</h2>
      <p class="lead">
        {t(
          lang,
          "每一个地方都在帮他把探究走扎实，同时留下可以回查的痕迹。留痕是走扎实的副产品，不是另外加上去的监控。",
          "Each one helps him do the inquiry properly, and leaves a trail that can be checked later. The trail is a by-product of doing it properly, not surveillance bolted on top.",
        )}
      </p>
    </div>

    <div class="grid-2" style="margin-top:52px">
      {surfaces.map(([icon, anchor, zh, en, pz, pe, tone], i) => (
        <a class="card hoverable rv" style={`--i:${i}`} href={L("/product") + "#" + anchor}>
          <div class={`cardic ${tone}`}><Icon name={icon} /></div>
          <h3>{t(lang, zh, en)}</h3>
          <p>{t(lang, pz, pe)}</p>
          <span class="tlink" style="margin-top:18px">
            {t(lang, "看这一面的设计", "See how it's designed")}<Icon name="arrow" />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════ TWO AXES ══════ -->
<section class="section">
  <div class="container">
    <div class="grid-2" style="align-items:center; gap:64px">
      <div class="rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "读证据的那把尺", "The ruler that reads the evidence")}</div>
        <h2 class="sec-title" style="margin-top:18px">
          {t(lang, "两根轴，分开测量，永不合成一个总分。", "Two axes. Measured apart. Never merged into one score.")}
        </h2>
        <p class="lead" style="margin-top:22px">
          {t(
            lang,
            "光有记录还不够。聊天记录、操作日志、版本历史堆在一起，并不会自动变成评价。读懂一段过程，需要一把有来历的尺。",
            "Recording isn't enough. Chat logs, action logs and version history piled together do not become an assessment. Reading a process takes a ruler with a real lineage.",
          )}
        </p>
        <p class="body" style="margin-top:18px">
          {t(
            lang,
            "这两根轴来自上世纪九十年代以来批判性思维的实证研究：一根读技能到达了哪一层，一根读倾向表现成了什么行为。",
            "Both axes come out of three decades of empirical work on critical thinking: one reads how far down the skill went, the other reads what the disposition turned into as behaviour.",
          )}
        </p>
        <a class="tlink" style="margin-top:24px" href={L("/product") + "#evaluation"}>
          {t(lang, "看完整的评估设计", "See the full assessment design")}<Icon name="arrow" />
        </a>
      </div>

      <div class="axes rv-pop" style="grid-template-columns:1fr; gap:18px">
        <div class="axis d">
          <div class="ah">
            <span class="ai"><Icon name="layers" /></span>
            <div>
              <div class="an">{t(lang, "认知深度", "Cognitive depth")}</div>
              <div class="ak">D-AXIS · D1–D6</div>
              <p class="aq">{t(lang, "思考到达了第几层。深度决定判断的质量上限。", "How many layers down the thinking got. Depth sets the ceiling on quality.")}</p>
            </div>
          </div>
        </div>
        <div class="axis a">
          <div class="ah">
            <span class="ai"><Icon name="compass" /></span>
            <div>
              <div class="an">{t(lang, "智识自主", "Intellectual autonomy")}</div>
              <div class="ak">A-AXIS · A1–A6</div>
              <p class="aq">{t(lang, "无人要求时，思考由谁启动、判断归谁所有。", "When nobody asked: who started the thinking, and whose judgment is it.")}</p>
            </div>
          </div>
        </div>
        <p class="small" style="padding:0 4px">
          {t(
            lang,
            "缺深度的自主，产出的是自信的垃圾；缺自主的深度，是一台租给任何提示者的好引擎。",
            "Autonomy without depth produces confident garbage. Depth without autonomy is a good engine rented to whoever prompts it.",
          )}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════ STATS ═════ -->
<section class="section tight band-paper">
  <div class="container">
    <div class="grid-4">
      {stats.map(([, n, , zh, en], i) => (
        <div class="stat rv" style={`--i:${i}`}>
          <div class="n tabular"><span data-count={n}>0</span></div>
          <div class="l">{t(lang, zh, en)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════ DISCIPLINE ═════ -->
<section class="section">
  <div class="container">
    <div class="grid-2" style="gap:64px; align-items:start">
      <div class="rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "我们对自己的纪律", "The discipline we hold ourselves to")}</div>
        <h2 class="sec-title" style="margin-top:18px">
          {t(lang, "四条红线拦住 AI，六项承诺拦住我们自己。", "Four red lines hold the AI back. Six commitments hold us back.")}
        </h2>
        <p class="lead" style="margin-top:22px">
          {t(
            lang,
            "一份讲判断力的产品，自己先得经得起判断。对得上的逐句对，对不上的明说。",
            "A product that argues about judgment has to survive being judged. Where it lines up we say so line by line; where it doesn't, we say that too.",
          )}
        </p>
        <a class="tlink" style="margin-top:24px" href={L("/about") + "#discipline"}>
          {t(lang, "读全部承诺", "Read every commitment")}<Icon name="arrow" />
        </a>
      </div>

      <div class="stack rv">
        <div class="redline">
          <span class="rn">01</span>
          <div>
            <h4>{t(lang, "AI 绝不替学生成文", "The AI never writes the student's prose")}</h4>
            <p>{t(lang, "解释、提示、扮演反方、指出草稿断裂都可以；核心判断与正文，不代产。", "Explaining, hinting, playing devil's advocate, flagging a broken draft — all fine. The core judgment and the body text are never produced for her.")}</p>
          </div>
        </div>
        <div class="redline">
          <span class="rn">02</span>
          <div>
            <h4>{t(lang, "不操纵", "No manipulation")}</h4>
            <p>{t(lang, "没有连胜、排行榜、徽章、上瘾式推送。工具卡触发是自动的，但打开由学生确认。", "No streaks, leaderboards, badges or engagement pushes. A card may be triggered automatically — opening it is always her call.")}</p>
          </div>
        </div>
        <div class="redline">
          <span class="rn">03</span>
          <div>
            <h4>{t(lang, "双轴永不用于筛选与排名", "The axes are never used to select or rank")}</h4>
            <p>{t(lang, "永不用于入学筛选、学生排名、纪律惩戒或教师绩效；不出售，不做商业画像。", "Never for admissions, ranking, discipline or staff appraisal. Never sold, never turned into a commercial profile.")}</p>
          </div>
        </div>
        <div class="redline">
          <span class="rn">04</span>
          <div>
            <h4>{t(lang, "证据不够时，就说不够", "When the evidence is thin, we say so")}</h4>
            <p>{t(lang, "没看到证据，只说明证据还在积累，并不代表这个学生没有能力。宁可不说，也不硬贴标签。", "No evidence seen only means evidence is still accumulating; it says nothing about the student's ability. We'd rather say nothing than pin on a label.")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

