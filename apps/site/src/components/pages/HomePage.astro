---
/**
 * The front page is one journey, not a summary of us.
 *
 *   1 · the hero — who this is for
 *   2 · the mission — the hero's water falls as digits and settles into the
 *       four abilities we are trying to build
 *   3 · the three parts of the product, indexed on a dial those four turn
 *   4 · the closing note, and a way in
 *
 * Everything that argues our case in more depth — the measurement design, the
 * multi-agent architecture, the product matrix — lives one click away, on the
 * pages built for it. This page's job is to be understood.
 */
import HeroImmersive from "../sections/HeroImmersive.astro";
import MissionRain from "../sections/MissionRain.astro";
import ProductDial from "../sections/ProductDial.astro";
import CtaBand from "../sections/CtaBand.astro";
import { getLang, t } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);
---

<HeroImmersive />

<MissionRain />

<ProductDial />

<!-- ═══════════════════════════════════ 4 · THE IMPRINT ══════════ -->
<section class="section band-ink closing">
  <div class="container narrow center">
    <div class="closerow" data-glyphsolid="row" aria-hidden="true">
      <canvas class="gr-figs"></canvas>
    </div>

    <p class="closeline rv" data-type>
      {t(
        lang,
        "我们想培养的，是能借助 AI 把事情想得更深、判断依然属于自己的人。",
        "We're trying to grow people who can think further with AI, and still own the judgment at the end of it.",
      )}
    </p>
    <p class="closecite rv">
      {t(lang, "《思维印记产品白皮书》· 结语", "Mind Imprint white paper · Conclusion")}
    </p>
  </div>
</section>

<CtaBand />

<script>
  import "../../scripts/glyph-rain";
  import "../../scripts/typewriter";
</script>
