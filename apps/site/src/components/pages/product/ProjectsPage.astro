---
import Icon from "../../Icon.astro";
import Figure from "../../Figure.astro";
import CtaBand from "../../sections/CtaBand.astro";
import Pager from "../../sections/Pager.astro";
import PageBanner from "../../sections/PageBanner.astro";
import { getLang, t } from "../../../i18n/utils";

const lang = getLang(Astro.currentLocale);

/* ── the six stages a project actually moves through ─────────────────
   Source of truth: docs/2026-08-09-all-statuses.md. The coach's job, the
   page the student is on, and which cards are available all change per
   stage — so this list has to match that document, not a generic
   research spine. */
const stations: [string, string, string, string, string, string, string][] = [
  ["01", "研究框架", "Framing", "目标、缘由、活动与时间、资源、可能的反例，五项逐条谈清。卡住时递出提问卡，把题目拆回学生自己的经验。", "Objective, motivation, activities and timeline, resources, likely counter-cases — five items, settled one at a time. When she stalls, the question card takes the prompt apart and connects it to her own experience.", "研究框架", "research framework"],
  ["02", "项目管理", "Planning", "系统据框架生成计划：甘特图排期、看板拆任务、活动日志留痕。中途回来先看这一页，用于复位。", "The framework becomes a plan: a Gantt schedule, a kanban of tasks, an activity log. Coming back after a break, this is the page that re-orients her.", "计划与日志", "plan and log"],
  ["03", "写提案", "Proposal", "九个部分的提案，可以自由写，也可以逐段引导——每段一张卡、一个具体问题、一个可参考的范例。写完拿到分段批注。", "A nine-part proposal, written freely or section by section — each with one card, one specific question and a worked example. It comes back with paragraph-level annotation.", "提案定稿", "proposal locked"],
  ["04", "阅读与探索", "Reading", "阅读室里做检索与精读：逐篇记来源、论点、证据，标出它服务哪个子问题，长成一张证据地图。教练提检索方向，也提醒哪条线跑偏了。", "Search and close reading in the reading room: source, claim and evidence noted per paper, tagged to the sub-question it serves, growing into an evidence map. The coach suggests directions — and says when a line has drifted.", "证据地图", "evidence map"],
  ["05", "写论文", "Writing", "先定大纲，再逐个论点写：证据、分析、限度、与其他论点的关系。需要时递上 PEE 与论证解剖卡。最后写引言与结论，AI 批注与修改轮流走，直到她说完成。", "Outline first, then claim by claim: evidence, analysis, limits, and how it connects to the rest. PEE and argument-anatomy cards arrive when needed. Introduction and conclusion last, then annotate-and-revise until she calls it done.", "终稿", "final draft"],
  ["06", "复盘", "Review", "左边摊开活动日志、研究框架、提案与终稿，右边是她自己的复盘表。她先写，教练再补。复盘完成，评估报告随之生成。", "The activity log, research framework, proposal and final draft on the left; her own review form on the right. She writes first, the coach adds after. Finishing the review is what generates the assessment.", "思维印记报告", "the imprint report"],
];

/* ── the transposition-gap table from the greening case ─────────────── */
const gaps: [string, string, string, string, string, string, string, string][] = [
  ["一、无法核", "1. Uncheckable", "出处流失", "The source vanishes", "明确标注 NASA Ames 发布稿、《Nature Sustainability》论文、作者与机构", "NASA Ames release, the Nature Sustainability paper, authors and institutions", "全篇无出处，文末一行「本图文均来自网络」", "No source at all — just “images and text from the internet”"],
  ["二、可核出的硬错", "2. A checkable error", "分母被换掉", "The denominator is swapped", "中国占全球叶面积净增长的 25%；原文的 42% 指中国自身变绿中森林工程的占比", "China is 25% of the global net leaf-area gain. The 42% is forest programmes' share of China's own greening", "「全球绿色面积的 40% 以上都来自中国」", "“Over 40% of the world's greening comes from China”"],
  ["三、核不全", "3. Not fully checkable", "限定流失", "The caveats vanish", "不能抵消热带地区植被丧失；印度增产依赖地下水，可能反转", "It can't offset tropical vegetation loss; India's gains lean on groundwater and may reverse", "两条限定全部缺失", "Both caveats are simply gone"],
  ["四、核了也读偏", "4. Checkable but misread", "框架变形", "The frame is displaced", "人类活动「也在贡献」；气候与 CO₂ 施肥似乎仍是主导", "Human activity “also contributes”; climate and CO₂ fertilisation still appear dominant", "「真正原因并不是人口过多，而是大量植树」——并列被改写成替换", "“The real cause isn't population but tree planting” — a conjunction rewritten as a substitution"],
];
---

<PageBanner
  asset="banner/project-v1.webp"
  tone="a"
  eyebrow={["解决方案 · AI 写作教练", "Solution · the AI writing coach"]}
  title={[
    ["学生自己走完一个真实课题，", "The student does the whole inquiry."],
    ["AI 全程支持，但从不代笔。", "The AI supports every step, and never writes it."],
  ]}
  lead={[
    "涵盖项目管理、立题、研究、写作、复盘全生命周期的多智能体写作教练，在真实项目中引导学生探索并独立完成课题。",
    "A multi-agent writing coach across the whole life cycle — planning, framing, research, writing, review — guiding a student through a real project she finishes herself.",
  ]}
/>

<section class="section">
    <div class="container">
      <div class="sec-head rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "项目全流程", "The whole project")}</div>
        <h2 class="sec-title">{t(lang, "六个阶段，教练在每个阶段做的事都不一样", "Six stages — and the coach does a different job in each")}</h2>
        <p class="lead">
          {t(
            lang,
            "不是一个通用聊天框陪着走全程。每个阶段有它自己的页面、自己可用的工具卡、自己的完成标准；上一阶段的产出，是下一阶段的输入。",
            "Not one general-purpose chat box for the whole journey. Each stage has its own page, its own available cards and its own bar for being finished — and what one stage produces is what the next one starts from.",
          )}
        </p>
      </div>

      <div class="ribbon rv-pop" style="margin-top:44px">
        {stations.map(([s, zh, en, pz, pe, oz, oe]) => (
          <div class="rstep">
            <div class="s">{s}</div>
            <h4>{t(lang, zh, en)}</h4>
            <p>{t(lang, pz, pe)}</p>
            <div class="out">→ {t(lang, oz, oe)}</div>
          </div>
        ))}
      </div>

      <Figure
        class="rv-pop"
        name="product-framing"
        clip="case/02-proposal-v1"
        ratio="16-9"
        caption={t(
          lang,
          "第一阶段「研究框架」：不写正式开题报告，把五件事逐条聊清楚就行（4 / 5 已聊到）。左边教练正在追问那条自媒体说法的原始来源；右边「活动与时间」已经长成一份三步走的取证计划——先用 CRAAP 追回一手论文，再三条线交叉验证，最后用论证图去撞反例。",
          "Stage one, the research framework. No formal proposal document: five things talked through one at a time, four of five so far. On the left, the coach pressing on where that viral claim originally came from. On the right, the activities-and-timeline box has already become a three-step plan for gathering evidence — trace back to the primary paper, cross-check three separate lines, then take the argument map out to look for counter-cases.",
        )}
      />
    </div>
  </section>

  <!-- reading studio -->
  <section class="section band-paper">
    <div class="container">
      <div class="sec-head rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "阅读工作室", "The reading studio")}</div>
        <h2 class="sec-title">{t(lang, "每一条声明，都能追回原始出处", "Every claim can be traced back to where it started")}</h2>
        <p class="lead">
          {t(
            lang,
            "推文是转述，原始研究才是证据。一条没标出处的推文，学生用文中仅有的三个可检索特征，自己追到了 NASA 发布稿，再追到《Nature Sustainability》原论文。",
            "A post is a retelling; the study behind it is the evidence. With the only three searchable features in an unsourced post, the student found the NASA release herself, then the Nature Sustainability paper behind it.",
          )}
        </p>
      </div>

      <div class="grid-3 rv" style="margin-top:48px; align-items:start">
          <div class="card">
            <div class="cardnum">{t(lang, "横向 · 跳出页面", "LATERAL · step outside the page")}</div>
            <h4>SIFT</h4>
            <p>{t(lang, "停下来 · 查来源 · 找更好的报道 · 追到原始语境。解决的是「是不是它说的」。", "Stop · investigate the source · find better coverage · trace to the original context. It settles whether they said it.")}</p>
          </div>
          <div class="card">
            <div class="cardnum">{t(lang, "纵向 · 留在页面里", "VERTICAL · stay on the page")}</div>
            <h4>CRAAP / CRRAAB</h4>
            <p>{t(lang, "时效、相关、权威、准确、目的。遇到个人证言时，第五维从「目的」换成「偏见」——权威概念在这里受力变形。", "Currency, relevance, authority, accuracy, purpose. For personal testimony the fifth swaps purpose for bias — the idea of authority bends under load.")}</p>
          </div>
          <div class="card">
            <div class="cardnum">{t(lang, "方法纪律", "METHOD DISCIPLINE")}</div>
            <h4>{t(lang, "遇到个人证言，第五维要换", "For personal testimony, the fifth criterion changes")}</h4>
            <p>{t(lang, "把横向工具一路用到底，只会停在「《Nature》发的，可信」。溯源抵达一手论文之后，必须切回纵向，读它说得立不立得住。", "Ride the lateral tool all the way and you stop at “Nature published it, so it's fine”. Once you reach the primary paper you must switch back to vertical and ask whether it holds.")}</p>
          </div>
      </div>

      <Figure
        class="rv-pop"
        name="product-reading-provenance"
        asset="case/05-guided-reading-v1.webp"
        ratio="16-9"
        caption={t(
          lang,
          "阅读室：左边陪练把信源辨识卡递过来，右边是一手论文本身。她划中的那一句被逐条体检——权威性站得住、口径要留意、相关性正好回应总问题——最下面是她自己记下的发现：这条「碳排放全球第一」提醒她，「变绿」不能单独用来证明「更可持续」。",
          "The reading room. On the left the coach hands over the source-evaluation card; on the right, the primary paper itself. The sentence she selected is checked line by line — authority holds, the basis needs care, relevance answers the main question — and underneath, the finding in her own words: a country can be the largest emitter and be greening at once, so greening alone cannot carry the word sustainable.",
        )}
      />

      <div class="sec-head rv" style="margin-top:80px">
        <h2 class="sub-title">{t(lang, "溯源只完成了一半。转述与原文之间，差了什么？", "Tracing is only half of it. What got lost between the retelling and the original?")}</h2>
        <p class="body" style="margin-top:14px">
          {t(
            lang,
            "落差集中在三件事上：出处、限定，与框架。全盘接受和全盘怀疑都不用读原文，只有想真正弄清楚的人才需要。",
            "The gap concentrates in three things: the source, the caveats and the frame. Neither swallowing it nor dismissing it requires reading the original. Only wanting to actually know does.",
          )}
        </p>
      </div>

      <div class="tablewrap rv" style="margin-top:32px">
        <table class="dt">
          <thead>
            <tr>
              <th style="width:170px">{t(lang, "落差类型", "Kind of gap")}</th>
              <th>{t(lang, "原文说的", "What the original says")}</th>
              <th>{t(lang, "推文说的", "What the post says")}</th>
            </tr>
          </thead>
          <tbody>
            {gaps.map(([kz, ke, nz, ne, oz, oe, pz, pe]) => (
              <tr>
                <td class="k">
                  {t(lang, kz, ke)}
                  <div class="small">{t(lang, nz, ne)}</div>
                </td>
                <td>{t(lang, oz, oe)}</td>
                <td>{t(lang, pz, pe)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="callout yes rv" style="margin-top:32px">
        <div class="cl"><Icon name="target" />{t(lang, "这一处装不出来", "This one cannot be faked")}</div>
        <h3>{t(lang, "40% 与 42% 只差两个点，扫过去像是同一个数", "40% and 42% are two points apart — a glance reads them as the same number")}</h3>
        <p>
          {t(
            lang,
            "但分母被从「中国的变绿」换成了「全球的变绿」，数字照抄，含义翻了一倍。这个错误可核查、不可表演、有迷惑性——说「我会核查数据」谁都会说，抓出这一处才算数。",
            "But the denominator moved from “China's greening” to “the world's greening”. The number was copied; the meaning doubled. The error is checkable, unfakeable and genuinely deceptive — anyone can say they check data. Catching this is what counts.",
          )}
        </p>
      </div>

      <div class="grid-2 rv" style="margin-top:32px">
        <div class="card">
          <div class="cardic g"><Icon name="branch" /></div>
          <h3>{t(lang, "兔子洞日志", "The rabbit-hole log")}</h3>
          <p>
            {t(
              lang,
              "一次溯源常常会岔出新的线索。它有真实的触发点，也有探索价值，只是需要边界来管。系统记录触发点、支线问题、与主问题的关系，以及退出的理由。",
              "Tracing a source opens side branches. They have a real trigger and real value; what they need is a boundary. The system records the trigger, the side question, its relation to the main one, and why she left.",
            )}
          </p>
        </div>
        <div class="card">
          <div class="cardic g"><Icon name="check" /></div>
          <h3>{t(lang, "及时退出，同样是自主的证据", "Leaving in time is also evidence of autonomy")}</h3>
          <p>
            {t(
              lang,
              "A1 测的是谁在定方向，不看走了多远。照单全收，方向是别人定的；漫无目的地漂移，方向没有人在定，包括她自己。两种都算不上自主。",
              "A1 measures who sets the direction, not how far you went. Taking it all on board means someone else set it. Drifting means nobody set it — including her. Neither counts as autonomy.",
            )}
          </p>
        </div>
      </div>

      <Figure
        class="rv-pop"
        name="product-warren-map"
        clip="case/03-research-v1"
        ratio="16-9"
        caption={t(
          lang,
          "兔子洞地图：每张卡是一个问题，标着它下面挂了几篇文献，卡与卡之间连出子问题关系；还没归位的来源留在「未归类」里等着被挂上去。右侧「还需要探索的」是她自己记下的待查方向，随时可以跳进阅读室。",
          "The rabbit-hole map. Each card is a question, showing how many sources hang beneath it, with sub-question relations drawn between them; sources not yet placed wait in an unfiled box. On the right, the things she noted down as still worth looking into — each one a jump straight into the reading room.",
        )}
      />
    </div>
  </section>

  <!-- writing space -->
  <section class="section">
    <div class="container">
      <div class="sec-head rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "写作项目空间", "The writing project space")}</div>
        <h2 class="sec-title">{t(lang, "正文由学生自己写，AI 只帮她想清楚", "The student writes the prose. The AI only helps her think it through.")}</h2>
        <p class="lead">
          {t(
            lang,
            "这里没有排版功能，也没有「一键提交给学校」。我们占的是「思考」这一层——她的作文活在她自己的世界里，那份文档不归我们。",
            "There's no formatting here, and no “submit to school” button. We occupy the thinking layer — her essay lives in her own world, and that file isn't ours.",
          )}
        </p>
      </div>

      <Figure
        class="rv-pop"
        name="product-writing-studio"
        clip="case/06-writing-v1"
        ratio="16-9"
        caption={t(
          lang,
          "写作面：左侧陪练栏顶上就写着这条边界——「聊提纲、挑逻辑、撞反例——但不替你写正文」；中间是她的阅读笔记、AI 批注，和还没查完的方向；右侧是她自己搭的提纲，每一条论点后面跟着出处，最后一条是带限定条件的结论。",
          "The writing surface. At the top of the coach rail, the boundary in plain sight: talk through the outline, test the logic, throw counter-examples — never write your prose. In the middle, her reading notes, the AI's annotations, and the directions she has not chased yet. On the right, the outline she built herself: every claim followed by where it came from, and a last line that states the conclusion with its limits attached.",
        )}
      />

      <div class="grid-3" style="margin-top:56px">
        <div class="card rv" style="--i:0">
          <div class="cardic"><Icon name="chat" /></div>
          <h3>{t(lang, "教练记得住整个项目", "The coach remembers the whole project")}</h3>
          <p>{t(lang, "一个课题跑几周，学生始终在跟同一个教练说话。第六周提起第一周定下的研究问题，它接得上，不需要她重新解释一遍自己在做什么。", "Coursework runs for weeks, and she talks to the same coach throughout. In week six it still knows the question she set in week one — she never has to explain her own project back to it.")}</p>
        </div>
        <div class="card rv" style="--i:1">
          <div class="cardic"><Icon name="db" /></div>
          <h3>{t(lang, "所有产出都留在项目里", "Everything she makes stays with the project")}</h3>
          <p>{t(lang, "研究框架、计划、文献笔记、证据地图、大纲、每一版草稿、活动日志——都存在同一个项目里，随时打得开、改得动，也构成最后那份评估的原始材料。", "Research framework, plan, reading notes, evidence map, outline, every draft, the activity log — all held in one project, all open to revisit and revise, and all of it the raw material the final assessment is built from.")}</p>
        </div>
        <div class="card rv" style="--i:2">
          <div class="cardic"><Icon name="slash" /></div>
          <h3>{t(lang, "红线只有一条", "There is exactly one red line")}</h3>
          <p>{t(lang, "AI 可以解释概念、生成检索词、扮演反方、指出草稿断裂；但不能替她确定研究方向，不能替她完成核心判断，不能生成可直接提交的正文。", "The AI may explain a concept, generate search terms, play the opposition, flag a broken draft. It may not set her direction, make her core judgment, or produce submittable prose.")}</p>
        </div>
      </div>

      <div class="callout yes rv" style="margin-top:32px">
        <div class="cl"><Icon name="quote" />{t(lang, "这条边界为什么必须守住", "Why that boundary has to hold")}</div>
        <h3>{t(lang, "AI 最难防的风险是它顺着人说", "The hardest AI risk to catch is that it agrees with you")}</h3>
        <p>
          {t(
            lang,
            "学生给出一个站不住的判断，它顺势补上理由；学生流露一点偏好，它调整立场去迎合。识破并顶住这种顺从，是 AI 时代最难、也最要紧的一个动作——而它只在足够长、足够开放、AI 真的有机会顺着学生说下去的任务里才会显形。",
            "A student offers a claim that doesn't stand, and it supplies the reasons. A student hints at a preference, and it shifts to match. Seeing that and holding against it is the hardest and most important move of this era — and it only shows up in tasks long and open enough for the AI to really have the chance to agree.",
          )}
        </p>
      </div>
    </div>
  </section>

<CtaBand />

<Pager links={[
    {
      href: "/product/evaluation",
      kicker: ["下一面", "Next"],
      title: ["过程评估报告", "The process assessment"],
      body: ["九个板块，把这段过程读成一份可核对的报告", "Nine sections that read the process into a checkable report"],
    },
    {
      href: "/product/courses",
      kicker: ["上一面", "Previous"],
      title: ["AI 互动课程", "AI courses"],
      body: ["方法从这里来", "Where the method comes from"],
    },
  ]} />

<script>
  import "../../../scripts/clip";
</script>
