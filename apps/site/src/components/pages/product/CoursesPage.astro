<!-- ═══════════════════════════════════════ THREE TO OPEN ON ══════ -->
<!-- The category stays put on the left while the recordings run past it, so
     the three read as one shelf rather than three unrelated demos. -->
<section class="section exsec">
  <div class="container wide">
    <div class="scrub excourse">
      <div class="ex-grid">
        <aside class="ex-rail">
          <div class="eyebrow" data-type>{t(lang, "课程示例", "Three courses")}</div>
          <ol class="ex-list">
            {examples.map((e, i) => (
              <li class="exi" data-i={i}>
                <div class="exc">{t(lang, e.cat[0], e.cat[1])}</div>
                <h3>{t(lang, e.zh, e.en)}</h3>
                <p>{t(lang, e.pz, e.pe)}</p>
              </li>
            ))}
          </ol>
        </aside>

        <div class="scrub-steps ex-steps">
          {examples.map((e) => (
            <div class="scrub-step ex-step">
              <div class="ex-media">
                <video
                  data-clip
                  src={assetUrl(`${e.clip}.mp4`)}
                  poster={assetUrl(`${e.clip}-poster.webp`)}
                  muted
                  playsinline
                  preload="none"
                  aria-label={t(lang, e.zh, e.en)}
                ></video>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

  <section class="section band-paper">
    <div class="container" data-catalog>
      <div class="sec-head rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "课程库", "The catalogue")}</div>
        <h2 class="sec-title">
          <span data-count="33">33</span>{t(lang, " 门课，每一门都对得上某张官方评分表", " courses, each mapped onto a real mark scheme")}
        </h2>
        <p class="lead">
          {t(
            lang,
            "一门课通常只用到三到五张工具卡。选课不按学科分，按学生这学期最缺的那一样能力分。",
            "A course usually calls on three to five cards. They aren't sorted by subject but by the ability a student is short of this term.",
          )}
        </p>
      </div>

      <div class="catbar rv" style="margin-top:34px">
        {courseTags.map(([k, zh, en], i) => (
          <button class="catbtn" type="button" data-tag={k} aria-pressed={i === 0 ? "true" : "false"}>
            {t(lang, zh, en)}
          </button>
        ))}
        <span class="catcount" data-catcount data-catcount-tpl={t(lang, "{n} 门", "{n} courses")}></span>
      </div>

      <!-- Two rows to start with. Thirty-three cards at once is a wall, and a
           wall is not a catalogue. -->
      <div class="catclip" data-catclip>
        <div class="catgrid rv">
          {courseList.map((c) => (
            <article class="catcard" data-tags={c.tags}>
              <div class="catin">
                <div class="catface catfront">
                  <div class="catcover">
                    <img
                      src={assetUrl(`courses/cover/${String(c.n).padStart(2, "0")}-v1.webp`)}
                      alt={t(lang, c.zh, c.en)}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="cn mono">{String(c.n).padStart(2, "0")}</span>
                  </div>
                  <h4>{t(lang, c.zh, c.en)}</h4>
                  <div class="cs">
                    {c.sys.split(" · ").map((x) => <span>{x}</span>)}
                  </div>
                </div>
                <div class="catface catback">
                  <div class="cbk mono">{t(lang, c.fz, c.fe)}</div>
                  <p>{t(lang, c.dz, c.de)}</p>
                </div>
              </div>
              <!-- The whole card is the control, so it is a real button rather
                   than a click handler bolted onto an article. -->
              <button
                class="catflip"
                type="button"
                aria-expanded="false"
                aria-label={t(lang, `${c.zh} — 课程介绍`, `${c.en} — what the course is`)}
              >
                <span class="catmark" aria-hidden="true"></span>
              </button>
            </article>
          ))}
        </div>
      </div>
      <div class="catmore">
        <button
          class="btn btn-outline"
          type="button"
          data-catmore
          data-more={t(lang, "展开全部课程", "Show every course")}
          data-less={t(lang, "收起", "Show fewer")}
        >
          <span class="lbl">{t(lang, "展开全部课程", "Show every course")}</span>
          <Icon name="arrow" />
        </button>
      </div>
    </div>
  </section>

<section class="section cardsec">
    <div class="container">

      <div class="sec-head rv">
        <div class="eyebrow" data-type>{t(lang, "工具卡", "The thinking cards")}</div>
        <h2 class="sec-title">
          {t(
            lang,
            "课上学会的方法，一张一张收进图鉴",
            "The methods she learns settle, one card at a time",
          )}
        </h2>
        <p class="lead">
          {t(
            lang,
            "一门课教的方法，会以一张卡的形式留在她自己的图鉴里。下一次遇到同类的问题，不必重新上一门课——她手上已经有那张卡了。",
            "The method a course teaches stays with her as a card, in a collection that is hers. Next time she meets the same kind of problem she doesn't retake the course: she already holds the card.",
          )}
        </p>
      </div>

      <div class="grid-3" style="margin-top:44px">
        <div class="card rv" style="--i:0">
          <div class="cardic a"><Icon name="cards" /></div>
          <h3>{t(lang, "一张卡是一套方法", "A card is a method, packaged")}</h3>
          <p>
            {t(
              lang,
              "它把一套思维方法拆成看得见的几步。点开一张卡，AI 就从「供答者」退成「接生者」——只提问，不代产。",
              "It breaks a thinking method into visible steps. Open one and the AI steps back from answer-giver to midwife: it questions, it does not deliver.",
            )}
          </p>
        </div>
        <div class="card rv" style="--i:1">
          <div class="cardic a"><Icon name="hand" /></div>
          <h3>{t(lang, "召唤权在学生手里", "She holds the summons")}</h3>
          <p>
            {t(
              lang,
              "触发是自动的，打开由她确认。质疑一个 AI 不需要勇气，邀请对手同样不需要——剩下的只有想不想较真。",
              "The trigger is automatic; opening it is her call. Challenging an AI takes no courage, and neither does inviting one. What's left is whether she wants to get it right.",
            )}
          </p>
        </div>
        <div class="card rv" style="--i:2">
          <div class="cardic a"><Icon name="branch" /></div>
          <h3>{t(lang, "点卡这个动作自带标记", "The tap itself is data")}</h3>
          <p>
            {t(
              lang,
              "系统在触发场景递卡，记「引导」；无人提示、她自己召唤，记「自发」。A2 与 A4 的证据，就采在这一点之差。",
              "Offered by the system: logged as prompted. Summoned with nobody asking: logged as self-initiated. The whole A2/A4 signal lives in that one difference.",
            )}
          </p>
        </div>
      </div>

      <div class="rv" style="margin-top:64px">
        <div class="eyebrow" style="margin-bottom:18px"><span class="pip"></span>{t(lang, "她的图鉴 · 34 张 · 一门课通常只用三到五张", "Her collection · 34 cards · a course usually uses three to five")}</div>
        <!-- The art carries its own title, so there is nothing to caption. -->
        <div class="marquee gallery">
          <div class="marquee-track">
            {[...cards, ...cards].map(([id, zh, en]) => (
              <div class="gcard">
                <img
                  src={assetUrl(`cards/${id}-v3.webp`)}
                  alt={t(lang, zh, en)}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="sec-head rv" style="margin-top:72px">
        <h2 class="sub-title">{t(lang, "点开一张卡，看见的是什么", "What opening a card actually looks like")}</h2>
        <p class="body" style="margin-top:14px">
          {t(
            lang,
            "左边是卡面，右边是这套方法的全部内容：一句口诀、一条流程、逐步的做法。它不解释「你应该批判性思考」，它给出这一次具体要做的六件事。",
            "The face on the left; on the right, the whole method: one mnemonic, one flow, and the steps. It doesn't explain that you should think critically — it names the six things to do this time.",
          )}
        </p>
      </div>

      <div class="grid-2 rv" style="margin-top:32px; align-items:start">
        <Figure
          name="card-detail-craap"
          asset="product/card-craap-v1.webp"
          ratio="4-3"
          caption={t(
            lang,
            "信源辨识卡：六个维度问下来，就知道这份材料够不够格进你的论证。",
            "The source-evaluation card: six dimensions, and you know whether the material is fit to enter your argument.",
          )}
        />
        <Figure
          name="card-detail-pee"
          asset="product/card-pee-v1.webp"
          ratio="4-3"
          caption={t(
            lang,
            "PEE 写作卡：先亮要点、再给证据、最后讲清两者的逻辑——这个骨架你自己搭，AI 替不了。",
            "The PEE card: point, then evidence, then the logic between them — a frame she builds herself, and the AI cannot build for her.",
          )}
