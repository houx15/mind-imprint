  [5, "一张图，四次翻案：OPCVL 史料评估", "One image, four reversals: OPCVL", "历史史料评估", "Historical source evaluation", "History P1 · DBQ · 历史", "src"],
  [6, "事实、观点，还是价值判断？", "Fact, opinion, or value judgment?", "判断类型与论证回应", "Types of claim, and how to answer them", "TOK · IB English", "arg"],
  [7, "信息交互能力工具包", "The information-handling toolkit", "公共议题信息整合", "Synthesising public-issue information", "Geography · Global Politics · 地理", "src"],
  [8, "信息素养：从一句权威主张到多源核查写作", "From one authoritative claim to verified writing", "多源核查与证据写作", "Multi-source checking and evidence writing", "Geography · AP Seminar · 语文", "src arg"],
  [9, "元认知：我怎么知道我没被自己骗？", "Metacognition: how do I know I haven't fooled myself?", "自我推理校准", "Calibrating your own reasoning", "TOK 核心主题", "ai"],
  [10, "可比性检验：先查四格，再判断", "Comparability check: four boxes before you judge", "证据可比性与冲突判断", "Comparability and conflicting evidence", "Biology IA · AP Statistics · 数学 · 生物", "data"],
  [11, "哥伦布：英雄还是恶棍？OPCVL 多源综合", "Columbus: hero or villain? OPCVL across sources", "多源史料综合", "Synthesising multiple historical sources", "History P1+IA · 历史", "src"],
  [12, "SIFT 信息横向调查：从一条微信到一篇有立场的议论文", "SIFT lateral reading: from a post to an argued essay", "学术写作与可持续议题论证", "Academic writing on a sustainability question", "ESS · AP Seminar · 语文", "src arg"],
  [13, "威尼斯三选一：把一部纪录片写成一份站得住的建议", "Venice, three options: a defensible recommendation", "纪录片材料到建议写作", "From documentary material to a recommendation", "Geography 决策题 · 地理", "arg"],
  [14, "英文学术写作：从论文结构到引用规范", "Academic writing in English: structure to citation", "英文学术论文写作", "Academic paper writing", "EE · AP Research · 英语", "arg"],
  [15, "我们能多确定？证据语言的校准", "How sure can we be? Calibrating the language of evidence", "证据确定度校准", "Calibrating certainty", "TOK · Psychology · 语文", "data"],
  [16, "当数字想骗你：数据三问", "When numbers want to fool you: three questions", "数据与统计素养", "Data and statistical literacy", "Math AI · AP Statistics · 数学", "data"],
  [17, "数据分析：从研究问题到结果段落", "Data analysis: from question to results paragraph", "数据分析与结果表达", "Analysis and reporting results", "各科 IA · AP Research · 数学", "data res"],
  [18, "查找信息：从搜索入口到可用资源", "Finding information: from the search box to a usable source", "学术检索与资源路径", "Academic search and source routes", "EE 研究过程 · EPQ · 信息技术", "res src"],
  [19, "识别企业漂绿：Tesla ESG 证据链", "Spotting greenwashing: the Tesla ESG evidence chain", "ESG 漂绿证据链", "ESG greenwashing evidence chains", "Business Management · 思想政治", "data src"],
  [20, "生成式 AI 时代的多模态信息甄别与可信判断", "Judging multimodal information in the age of generative AI", "AI 生成多模态信息可信判断", "Credibility of AI-generated media", "Digital Society · TOK · 信息技术", "src ai"],
  [21, "电竞是不是体育？", "Is esports a sport?", "概念承认与证据射程", "Concept boundaries and evidential reach", "TOK 展览 · IB English", "arg"],
  [22, "研究方法：从问题到可执行计划", "Research methods: from question to a workable plan", "研究设计与方法计划", "Research design and method planning", "EE/IA 方法 · AP Research · 综合实践", "res"],
  [23, "影像侦探局：镜头在替谁说话", "The image detective: whose side is the camera on?", "视听语言与证据区分", "Audiovisual language versus evidence", "Film · Lang&Lit P1 · 语文跨媒介", "src"],
  [24, "删得掉的让步段，不是让步段", "A concession you can delete was never a concession", "反方证据与论点限定", "Counter-evidence and bounding a claim", "Lang A P2 · AP Lang · 语文", "arg"],
  [25, "逻辑侦探局：从拆案到立案的论证训练", "The logic detective: taking arguments apart and building them", "论证解剖与谬误识别", "Dissecting arguments, spotting fallacies", "TOK · IB English", "arg"],
  [26, "语言如何塑造思维：五把工具扫描文本框定", "How language shapes thought: five tools for reading framing", "语言框定与文本扫描", "Framing in language, scanned", "TOK 语言主题 · AP Lang · 语文", "arg"],
  [27, "追踪信息背后的利益链", "Following the money behind a claim", "利益链与资金来源核查", "Interests and funding trails", "Global Politics · 思想政治", "src"],
  [28, "选题与 Proposal：从宽泛兴趣到可写研究提案", "Topic and proposal: from a broad interest to a writable question", "选题与 Proposal 写作", "Choosing a topic, writing a proposal", "EE 开题 · AP Research · 综合实践", "res"],
  [29, "项目管理：把长期探究变成一周冲刺", "Project management: a long inquiry as weekly sprints", "长期探究项目管理", "Managing a long inquiry", "EE/CAS · EPQ log · 综合实践", "res"],
