    href: "/product/projects",
    asset: "walk-02-proposal",
    shot: "product/framing-v1.webp",
    brief: ["提案页：左侧要点与批注，右侧写作区", "The proposal page: notes and annotations left, writing surface right"],
  },
  {
    k: ["阅读室 · 溯源", "The reading room"],
    h: ["一条没有出处的推文，追到 Nature", "An unsourced post, traced back to Nature"],
    p: [
