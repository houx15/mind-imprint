  [18, "查找信息：从搜索入口到可用资源", "Finding information: from the search box to a usable source", "学术检索与资源路径", "Academic search and source routes", "EE 研究过程 · EPQ · 信息技术", "res src"],
  [19, "识别企业漂绿：Tesla ESG 证据链", "Spotting greenwashing: the Tesla ESG evidence chain", "ESG 漂绿证据链", "ESG greenwashing evidence chains", "Business Management · 思想政治", "data src"],
