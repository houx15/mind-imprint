---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import CtaBand from "../sections/CtaBand.astro";
import Pager from "../sections/Pager.astro";
import { getLang, t } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);

/* ── the three surfaces this page is organised by ───────────────────── */
const tabs: [string, string, string, string, string][] = [
  ["projects", "项目", "Projects", "AI 全过程支持的探究性写作", "Inquiry writing, supported end to end"],
  ["courses", "课程", "Courses", "真实情境带练，习得思维工具", "Coached practice in real situations"],
  ["evaluation", "评估", "Evaluation", "基于 AI 互动全过程的思维印记评估", "Assessment from the full interaction record"],
];

/* ── the six-station inquiry spine ──────────────────────────────────── */
const stations: [string, string, string, string, string, string, string][] = [
  ["S1", "选题与研究问题", "Question", "把兴趣主题收窄为可回答的问题，限定对象、范围与比较关系。", "Narrow an interest into an answerable question — object, scope, comparison.", "问题链", "question chain"],
  ["S2", "文献搜索与综述", "Sources", "从「找到资料」走向「让来源彼此对话」，并指认研究缺口。", "Move from finding material to making sources argue with each other.", "文献表格", "source table"],
  ["S3", "研究方法设计", "Method", "比较方法候选，说明为什么这一种方法能回答这个问题。", "Compare candidate methods; say why this one answers this question.", "方法框架", "method frame"],
  ["S4", "数据分析", "Data", "处理自己收集的证据，记录清洗、分析与不确定性。", "Work her own evidence — cleaning, analysis, and how certain she is.", "数据包", "data pack"],
  ["S5", "学术写作", "Writing", "搭论证、接反方、写让步段，控制结论的强度。", "Build the argument, take the counter-case, bound the conclusion.", "修订稿", "revisions"],
  ["S6", "项目管理", "Managing", "贯穿全程：定计划、发现计划失效、调整行动。", "Throughout: plan, notice the plan failing, adjust.", "项目日志", "project log"],
];

/* ── the card library (packages/contracts/cards) ────────────────────── */
const cards: [string, string][] = [
  ["CRAAP 信源体检", "CRAAP source check"],
  ["SIFT 横向核查", "SIFT lateral reading"],
  ["让步段", "Concession"],
  ["图尔敏论证", "Toulmin argument"],
  ["PEE 段落", "PEE paragraph"],
  ["论证地图", "Argument map"],
  ["提问卡", "Question card"],
  ["兔子洞日志", "Rabbit-hole log"],
  ["元认知复盘", "Metacognition"],
  ["OPCVL 史料评估", "OPCVL source evaluation"],
  ["话语分析 CDA", "Discourse analysis"],
  ["资金链溯源", "Money trail"],
  ["框定识别", "Spin detector"],
  ["多模态甄别", "Multimodal decode"],
  ["数据素养", "Data literacy"],
  ["事实 / 观点 / 价值", "Fact · opinion · value"],
  ["立场光谱", "Belief spectrum"],
  ["视角对照矩阵", "Perspective matrix"],
  ["认知者视角", "Knower's perspective"],
  ["AI 边界声明", "AI boundary"],
  ["AI 使用决策树", "AI decision tree"],
  ["检索计划", "Search plan"],
  ["伦理透镜", "Ethics lenses"],
  ["情感对齐", "Emotional alignment"],
  ["学习报告", "Learning report"],
];

/* ── one real inquiry, walked across all three surfaces ─────────────── */
const walk: {
  k: [string, string];
  h: [string, string];
  p: [string, string];
  asset: string;
  brief: [string, string];
}[] = [
  {
    k: ["01 · 课程与工具卡", "01 · Course & cards"],
    h: ["一门课，交给她一套能带走的方法", "A course hands her a method she can take away"],
    p: [
      "一门课就是一条工作流：看材料、被追问、做判断、填一张工具卡，一步步推进。CRAAP、SIFT、良构论证都在真实材料上走过一遍——方法在用过之后才真正到手。",
      "A course is a workflow: watch the material, get questioned, make a call, fill in a card, move on. CRAAP, SIFT and well-formed argument all get practised on real material — a method only really lands once it has been used.",
    ],
    asset: "home-01-course-player",
    brief: ["课程播放界面：视频 + 旁白 + 一张工具卡被递出来", "Course player: video + narration + a card being handed over"],
  },
  {
    k: ["02 · 阅读工作室", "02 · Reading studio"],
    h: ["一条没标出处的推文，她自己追到了 Nature", "An unsourced post — and she traced it to Nature herself"],
    p: [
      "推文说「全球变绿 40% 以上来自中国」。她跳出页面横向核查：公众号 → NASA 发布稿 → Nature Sustainability 原论文，然后发现分母被换过——原文的 42% 说的是中国自己那部分变绿里森林工程的占比。",
      "The post claimed “over 40% of the Earth\u2019s greening comes from China”. She read laterally — post → NASA release → the Nature Sustainability paper — and found the denominator had been swapped. The original 42% was the share of China\u2019s own greening due to forest programmes.",
    ],
    asset: "home-02-reading-room",
    brief: ["阅读室：原文 + 溯源链 + 探索图谱", "Reading room: source text + provenance chain + exploration map"],
  },
  {
    k: ["03 · 写作项目空间", "03 · Writing project space"],
    h: ["论证撞上反例，让步段是她自己写的", "The argument hits a counter-example — she writes the concession"],
    p: [
      "中国碳排放全球第一。这条反方证据推翻不了她的题目，但会限制她的结论。AI 不会替她写一个字正文，它只会问：你打算接住它，还是绕开它？",
      "China is the world\u2019s largest emitter. That counter-evidence doesn\u2019t sink her thesis, but it does bound her conclusion. The AI writes none of her prose — it only asks: are you going to take this on, or route around it?",
    ],
    asset: "home-03-writing-studio",
    brief: ["写作面：正文编辑区 + 右侧只读过程树", "Writing surface: the draft, with the read-only process tree alongside"],
  },
  {
    k: ["04 · 过程评估", "04 · Process evaluation"],
    h: ["连她跳过的那一次，也被记下来了", "Even the time she skipped is on the record"],
    p: [
      "报告分两半：数出来的事实，和有证据支撑的判断。每一条判断都要指回一个真实存在的片段，指不到的直接丢弃。两根轴分开报告，不合成总分。",
      "The report has two halves: facts that are counted, and judgments that are grounded. Every judgment must point back to a real fragment — the ones that can\u2019t are dropped. The two axes are reported apart, never merged into a single score.",
    ],
    asset: "home-04-evaluation-report",
    brief: ["评估报告：双轴读数 + 证据链接 + 过程叙述", "Evaluation report: the two axes, evidence links, process narrative"],
  },
];

/* ── the nine disciplinary lenses ───────────────────────────────────── */
const lenses: [string, string, string, string][] = [
  ["逻辑学", "Logic", "证据能否推出结论，是否存在隐藏前提、因果跳跃、过度概括。", "Does the evidence actually yield the conclusion — hidden premises, causal leaps, overreach."],
  ["科学方法论", "Scientific method", "数据怎样获得，测量、样本、变量与误差能否支持当前结论。", "How the data was obtained; whether measurement, sample and error support the claim."],
  ["社会学", "Sociology", "权力、资源、制度和社会位置如何影响不同群体。", "How power, resources, institutions and social position land differently on different groups."],
  ["法学", "Law", "权利、义务、责任、程序与救济渠道是否清楚。", "Whether rights, duties, procedure and remedy are actually spelled out."],
  ["经济学", "Economics", "规则如何改变选择、激励、成本与资源配置。", "How a rule shifts choices, incentives, costs and allocation."],
  ["伦理学", "Ethics", "一项主张保护或牺牲了哪些价值：公平、伤害、自主、尊严。", "Which values a claim protects or sacrifices — fairness, harm, autonomy, dignity."],
  ["历史学", "History", "结论依赖什么时代背景，哪些条件已经变了。", "What period conditions the conclusion rests on, and which have since changed."],
  ["传播学", "Communication", "标题、措辞、叙述角度和缺席的声音如何影响判断。", "How headline, wording, framing and absent voices steer the reader."],
  ["系统科学", "Systems", "局部行动如何产生连锁影响、延迟后果与反馈循环。", "How a local action produces knock-on effects, delays and feedback loops."],
];

/* ── the transposition-gap table from the greening case ─────────────── */
const gaps: [string, string, string, string, string, string, string, string][] = [
  ["一、无法核", "1. Uncheckable", "出处流失", "The source vanishes", "明确标注 NASA Ames 发布稿、《Nature Sustainability》论文、作者与机构", "NASA Ames release, the Nature Sustainability paper, authors and institutions", "全篇无出处，文末一行「本图文均来自网络」", "No source at all — just “images and text from the internet”"],
  ["二、可核出的硬错", "2. A checkable error", "分母被换掉", "The denominator is swapped", "中国占全球叶面积净增长的 25%；原文的 42% 指中国自身变绿中森林工程的占比", "China is 25% of the global net leaf-area gain. The 42% is forest programmes' share of China's own greening", "「全球绿色面积的 40% 以上都来自中国」", "“Over 40% of the world's greening comes from China”"],
  ["三、核不全", "3. Not fully checkable", "限定流失", "The caveats vanish", "不能抵消热带地区植被丧失；印度增产依赖地下水，可能反转", "It can't offset tropical vegetation loss; India's gains lean on groundwater and may reverse", "两条限定全部缺失", "Both caveats are simply gone"],
  ["四、核了也读偏", "4. Checkable but misread", "框架变形", "The frame is displaced", "人类活动「也在贡献」；气候与 CO₂ 施肥似乎仍是主导", "Human activity “also contributes”; climate and CO₂ fertilisation still appear dominant", "「真正原因并不是人口过多，而是大量植树」——并列被改写成替换", "“The real cause isn't population but tree planting” — a conjunction rewritten as a substitution"],
];

/* ── the two axes ───────────────────────────────────────────────────── */
const depth: [string, string, string, string, string][] = [
  ["D1", "任务理解与问题表述", "Framing the question", "能否把研究问题说清、限定范围、拆出可答的子问题", "Stating it clearly, bounding scope, splitting out answerable sub-questions"],
  ["D2", "证据与信源", "Evidence & sources", "追溯一手来源、区分转述与原文、核查数据", "Tracing to primary sources, separating paraphrase from original, checking numbers"],
  ["D3", "论证结构", "Argument structure", "主张—证据—推理的完整性、识别缺失的 warrant、构造让步段", "Claim–evidence–warrant integrity, spotting the missing warrant, building the concession"],
  ["D4", "视角与偏见", "Perspective & bias", "多视角比较、识别来源的立场与利益、处理反方证据", "Comparing perspectives, reading a source's stake, handling counter-evidence"],
  ["D5", "反馈处理与修订", "Feedback & revision", "理解批评、修订有理由、改的是论证而非只是措辞", "Understanding critique, revising with reasons, changing the argument not just the wording"],
  ["D6", "反思与元认知", "Reflection & metacognition", "从复盘事实，到审视自己的方法与框架", "From recounting what happened to interrogating her own method and frame"],
];
const autonomy: [string, string, string, string, string][] = [
  ["A1", "方向自主", "Direction", "谁在定目标与路线：自拟或修改计划、主动往深处钻", "Who sets the target and route — writing or rewriting the plan, digging deeper unprompted"],
  ["A2", "发起自主", "Initiation", "无人要求时的提问、核查、修订", "Questions, checks and revisions nobody asked for"],
  ["A3", "边界主权", "Boundary", "给 AI 设界、拒绝建议并给出理由、守住自己的路径", "Setting limits on the AI, refusing a suggestion with a reason, holding her own route"],
  ["A4", "对抗与检验", "Challenge", "主动召唤反方、带证据质疑 AI、抵抗迎合陷阱", "Summoning the counter-case, challenging the AI with evidence, resisting its urge to agree"],
  ["A5", "判断署名", "Signature", "评估判断自己下、反思自写、为结论给理由", "Making the call herself, writing her own reflection, giving reasons for the conclusion"],
  ["A6", "求真优先", "Truth first", "愿意跟着证据走到对自己不利的地方：接受反证、修正立场", "Willing to follow the evidence somewhere inconvenient — accepting it, moving her position"],
];

/* ── the report's nine parts ────────────────────────────────────────── */
const reportParts: [string, string, string, string][] = [
  ["基础数据", "Basics", "标题、起止、里程碑，以及数出来的计数：AI 轮次、材料数、正文字数、批注、修订。", "Title, dates, milestones, and counted numbers: AI turns, materials, words, comments, revisions."],
  ["摘要", "Abstract", "一段回顾她这次真正走过的路，加上三句分别说材料、写作与 AI 使用。", "A paragraph on the route she actually took, plus one line each on materials, writing and AI use."],
  ["事件时间线", "Timeline", "对话、阅读室、图谱、写作、复盘，逐条按时间摊开。", "Chat, reading room, map, writing, retrospective — laid out in order."],
  ["材料清单", "Materials", "每条来源的加入时间、出处、链接、它在论证里承担了什么。", "Every source: when it arrived, where from, and what job it does in the argument."],
  ["认知深度 D1–D6", "Depth D1–D6", "每一维给分层、一句判断、若干条可点开的证据、一句建议。", "Per dimension: a level, a verdict, clickable evidence, one suggestion."],
  ["智识自主 A1–A6", "Autonomy A1–A6", "同样结构；并标记这一次是自发还是被引导。", "Same structure — plus whether each move was self-initiated or prompted."],
  ["提示词观测", "Prompt lens", "挑出 3–10 条她真实写过的提示词，说明好在哪、可以怎么改。", "3–10 of her actual prompts, with what worked and what to change."],
  ["工具卡与子代理", "Cards & sub-agents", "哪张卡、在哪一站、为什么被递出来、产出改变了后续什么。", "Which card, at which station, why it was offered, and what changed downstream."],
  ["风险行为", "Risk signals", "AI 代劳、缺少信源、论证断裂、数据口径、兔子洞跑题——各自附建议。", "Ghost-writing, missing sources, broken warrants, shifting denominators, tangents — each with advice."],
];

/* ── the teacher's four positions ───────────────────────────────────── */
const teacher: [string, string, string, string, string][] = [
  ["target", "教师设计机会", "The teacher designs the opportunity", "题目够不够开放、材料有没有冲突、反方有没有被放进去——这些由教师决定。", "How open the task is, whether the material conflicts, whether a counter-case is in the room — the teacher decides all of it."],
  ["eye", "教师判读证据", "The teacher reads the evidence", "系统给的是读数，教师给的是解释。原始对话、来源记录、草稿修改都可点开。", "The system gives a reading; the teacher gives the interpretation. Raw chat, source records and draft changes all open up."],
  ["flask", "教师开出处方", "The teacher writes the prescription", "同样是「表现不理想」，有的该放手，有的该补方法，有的该换题材。平台指出问题，教师决定怎么教。", "“Underperforming” has many causes. Some need to be let go of, some need method, some need a different subject. The platform locates it; the teacher decides."],
  ["users", "教师训练担责", "The teacher trains accountability", "解释自己的结论、回答追问、承认限制——这种场合只发生在人和人之间。", "Explaining a conclusion, answering follow-ups, conceding a limit — that only happens between people."],
];
---

<!-- ═════════════════════════════════════════════════ HERO ════════ -->
<section class="pagehero">
  <div class="wash">
    <i class="w1" style="width:520px;height:520px;background:var(--primary-tint);top:-240px;left:-120px"></i>
    <i class="w2" style="width:440px;height:440px;background:var(--accent-tint);top:-160px;right:-100px"></i>
  </div>
  <div class="pagehero-inner">
    <div class="eyebrow rv"><span class="pip"></span>{t(lang, "产品", "Product")}</div>
    <h1 class="page-title">
      <span class="rv-line" style="--i:0"><span>{t(lang, "学生自己走完一个真实课题，", "The student does the whole inquiry.")}</span></span>
      <span class="rv-line" style="--i:1"><span class="soft">{t(lang, "AI 全程支持，但从不代笔。", "The AI supports every step, and never writes it.")}</span></span>
    </h1>
    <p class="lead rv" style="--i:2">
      {t(
        lang,
        "她在项目里做自己的真实课题，用工具卡把方法练成习惯，最后拿到一份写着她怎么想的评估报告。三个部分，按这个顺序看下去。",
        "She does her own real coursework inside a project, turns methods into habits with the thinking cards, and ends up with a report that describes how she thought. Three parts, best read in that order.",
      )}
    </p>
  </div>
</section>

<!-- ══════════════════════════════════════════════════ TABS ══════ -->
<div class="tabbar" data-tabs>
  <div class="tabbar-inner" role="tablist">
    {tabs.map(([id, zh, en, sz, se], i) => (
      <button
        class="tabbtn"
        role="tab"
        type="button"
        data-tab={id}
        aria-selected={i === 0 ? "true" : "false"}
      >
        <span class="tl">{t(lang, zh, en)}</span>
        <span class="tsub">{t(lang, sz, se)}</span>
      </button>
    ))}
  </div>
</div>

<!-- ══════════════════════════════════════ PANEL · PROJECTS ══════ -->
<div class="tabpanel" data-panel="projects">
  <section class="section tight">
    <div class="container">
      <div class="sec-head rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "项目 · AI 全过程支持的探究性写作", "Projects · inquiry writing, supported end to end")}</div>
        <h2 class="sec-title">{t(lang, "从研究问题到成稿，六个阶段都有支持", "From research question to finished draft — support at all six stages")}</h2>
        <p class="lead">
          {t(
            lang,
            "EE、TOK、IA、课题研究、科创项目——形态不限。项目空间给的是一条走得完的主线：六站结构负责路线，工具卡按需要递到手上，一门课通常只用得到其中三到五张。",
            "EE, TOK, IA, a research project, a science-fair entry — the form is open. What the project space gives is a route that can actually be finished: six stations carry the structure, and cards arrive as needed. A single course usually calls on three to five of them.",
          )}
        </p>
      </div>

      <div class="ribbon rv-pop" style="margin-top:44px">
        {stations.map(([s, zh, en, pz, pe, oz, oe]) => (
          <div class="rstep">
            <div class="s">{s}</div>
            <h4>{t(lang, zh, en)}</h4>
            <p>{t(lang, pz, pe)}</p>
            <div class="out">→ {t(lang, oz, oe)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- reading studio -->
  <section class="section band-paper">
    <div class="container">
      <div class="sec-head rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "阅读工作室", "The reading studio")}</div>
        <h2 class="sec-title">{t(lang, "每一条声明，都能追回原始出处", "Every claim can be traced back to where it started")}</h2>
        <p class="lead">
          {t(
            lang,
            "推文是转述，原始研究才是证据。一条没标出处的推文，学生用文中仅有的三个可检索特征，自己追到了 NASA 发布稿，再追到《Nature Sustainability》原论文。",
            "A post is a retelling; the study behind it is the evidence. With the only three searchable features in an unsourced post, the student found the NASA release herself, then the Nature Sustainability paper behind it.",
          )}
        </p>
      </div>

      <div class="grid-2 rv" style="margin-top:48px; align-items:start">
        <div class="stack">
          <div class="card">
            <div class="cardnum">{t(lang, "横向 · 跳出页面", "LATERAL · step outside the page")}</div>
            <h4>SIFT</h4>
            <p>{t(lang, "停下来 · 查来源 · 找更好的报道 · 追到原始语境。解决的是「是不是它说的」。", "Stop · investigate the source · find better coverage · trace to the original context. It settles whether they said it.")}</p>
          </div>
          <div class="card">
            <div class="cardnum">{t(lang, "纵向 · 留在页面里", "VERTICAL · stay on the page")}</div>
            <h4>CRAAP / CRRAAB</h4>
            <p>{t(lang, "时效、相关、权威、准确、目的。遇到个人证言时，第五维从「目的」换成「偏见」——权威概念在这里受力变形。", "Currency, relevance, authority, accuracy, purpose. For personal testimony the fifth swaps purpose for bias — the idea of authority bends under load.")}</p>
          </div>
          <div class="card">
            <div class="cardnum">{t(lang, "方法纪律", "METHOD DISCIPLINE")}</div>
            <h4>{t(lang, "工具要随对象切换", "Switch the tool with the object")}</h4>
            <p>{t(lang, "把横向工具一路用到底，只会停在「《Nature》发的，可信」。溯源抵达一手论文之后，必须切回纵向，读它说得立不立得住。", "Ride the lateral tool all the way and you stop at “Nature published it, so it's fine”. Once you reach the primary paper you must switch back to vertical and ask whether it holds.")}</p>
          </div>
        </div>

        <Figure
          name="product-reading-provenance"
          ratio="4-3"
          desc={t(lang, "阅读室：溯源链 公众号 → NASA → Nature，以及探索图谱", "Reading room: the provenance chain post → NASA → Nature, plus the exploration map")}
          caption={t(
            lang,
            "溯源在做的事，用信源金字塔的语言说，就是沿着梯子往上爬，直到爬不动为止。",
