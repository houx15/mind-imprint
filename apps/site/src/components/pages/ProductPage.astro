---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import CtaBand from "../sections/CtaBand.astro";
import { getLang, t, localePath } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);
const L = (p: string) => localePath(lang, p);

/* The four surfaces, in the order a school meets them. Each is its own page —
   they are separate products in practice, and a tab strip buried three of
   them. */
const surfaces: {
  icon: string;
  href: string;
  zh: string;
  en: string;
  pz: string;
  pe: string;
  tone: string;
}[] = [
  {
    icon: "cards",
    href: "/product/courses",
    zh: "课程与工具卡",
    en: "Courses & thinking cards",
    pz: "AI 互动课堂，在真实情境中带着学生学会多项思维工具的应用。",
    pe: "An interactive AI classroom that teaches a set of thinking tools by using them on real material.",
    tone: "",
  },
  {
    icon: "pen",
    href: "/product/projects",
    zh: "探究性写作空间",
    en: "Inquiry writing space",
    pz: "涵盖项目管理、立题、研究、写作、复盘全生命周期的多智能体写作教练，在真实项目中引导学生探索并独立完成课题。",
    pe: "A multi-agent writing coach across the whole life cycle — planning, framing, research, writing, review — guiding a student through a real project she finishes herself.",
    tone: "a",
  },
  {
    icon: "gauge",
    href: "/product/evaluation",
    zh: "过程性评估报告",
    en: "Process assessment report",
    pz: "基于学生实际项目过程的系统评估报告，覆盖九大板块，包括认知深度与智识自主两大轴线，详细呈现学生认知过程。",
    pe: "A systematic report built from the student's actual project record — nine sections, including the two axes, laying out how the thinking went.",
    tone: "g",
  },
  {
    icon: "users",
    href: "/product/teacher",
    zh: "教师端全过程数据监控",
    en: "Teacher console",
    pz: "让学生的 AI 使用过程可视化、可管理、可回溯，让过程性评估、家长报告一键生成。",
    pe: "Makes each student's AI use visible, manageable and reviewable — and generates process assessments and family reports in one click.",
    tone: "m",
  },
];

/* ── the three surfaces this page is organised by ───────────────────── */
const tabs: [string, string, string, string, string][] = [
  ["courses", "课程", "Courses", "真实情境带练，习得思维工具", "Coached practice in real situations"],
  ["projects", "项目", "Projects", "AI 全过程支持的探究性写作", "Inquiry writing, supported end to end"],
  ["evaluation", "评估", "Evaluation", "基于 AI 互动全过程的思维印记评估", "Assessment from the full interaction record"],
  ["teacher", "教师端", "Teachers", "全过程数据，可视化、可回溯", "The whole process, visible and reviewable"],
];

/* Each surface opens on its own artwork — the same set the sub-pages use. */
const panelArt: Record<string, string> = {
  courses: "banner/course-v1.webp",
  projects: "banner/project-v1.webp",
  evaluation: "banner/evaluation-v1.webp",
  teacher: "banner/teacher-v1.webp",
};

/* ── the six-station inquiry spine ──────────────────────────────────── */
const stations: [string, string, string, string, string, string, string][] = [
  ["S1", "选题与研究问题", "Question", "把兴趣主题收窄为可回答的问题，限定对象、范围与比较关系。", "Narrow an interest into an answerable question — object, scope, comparison.", "问题链", "question chain"],
  ["S2", "文献搜索与综述", "Sources", "从「找到资料」走向「让来源彼此对话」，并指认研究缺口。", "Move from finding material to making sources argue with each other.", "文献表格", "source table"],
  ["S3", "研究方法设计", "Method", "比较方法候选，说明为什么这一种方法能回答这个问题。", "Compare candidate methods; say why this one answers this question.", "方法框架", "method frame"],
  ["S4", "数据分析", "Data", "处理自己收集的证据，记录清洗、分析与不确定性。", "Work her own evidence — cleaning, analysis, and how certain she is.", "数据包", "data pack"],
  ["S5", "学术写作", "Writing", "搭论证、接反方、写让步段，控制结论的强度。", "Build the argument, take the counter-case, bound the conclusion.", "修订稿", "revisions"],
  ["S6", "项目管理", "Managing", "贯穿全程：定计划、发现计划失效、调整行动。", "Throughout: plan, notice the plan failing, adjust.", "项目日志", "project log"],
];

