/* ── one real inquiry, walked across all three surfaces ─────────────── */
const walk: {
  k: [string, string];
  h: [string, string];
  p: [string, string];
  href: string;
  asset: string;
  /** Media key, when the screenshot exists. Absent = labelled empty slot. */
  shot?: string;
  brief: [string, string];
}[] = [
  {
    k: ["课程与工具卡", "Courses & thinking cards"],
    h: ["方法先在课上学会", "She learns the method in class first"],
    p: [
      "《信息过滤神器》用一条真实的气候信息带她走完 CRAAP 与 SIFT。课程结束时，她手上多了两张能带进任何课题的工具卡。",
      "“The Information Filter” walks her through CRAAP and SIFT on a real piece of climate reporting. She finishes the course holding two cards she can take into any piece of coursework.",
    ],
    href: "/product/courses",
    asset: "walk-01-course",
    shot: "product/course-runtime-v1.webp",
    brief: ["课程播放界面：素材 + 旁白 + 递出的工具卡", "The course player: material, narration, and the card being handed over"],
  },
  {
    k: ["立题与提案", "Framing and the proposal"],
    h: ["把一个大问题收窄成能回答的问题", "Narrowing a big question into an answerable one"],
    p: [
      "教练逐项追问目标、缘由、活动与时间、资源与可能的反例，形成研究框架；系统据此生成项目计划与甘特图。她写出第一版提案，拿到分段批注。",
      "The coach works through objective, motivation, activities and timeline, resources and likely counter-cases to build the research framework; the system generates the project plan and Gantt chart from it. She writes a first proposal and gets paragraph-level annotation back.",
