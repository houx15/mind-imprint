---
import Icon from "../Icon.astro";
import CtaBand from "../sections/CtaBand.astro";
import PageBanner from "../sections/PageBanner.astro";
import Pager from "../sections/Pager.astro";
import { getLang, t } from "../../i18n/utils";
import { demoUrl, assetUrl } from "../../config";

const lang = getLang(Astro.currentLocale);

/* The team. Portraits live in apps/site/assets/team/ and are served through
   the site CDN; a member without one gets a monogram rather than a broken
   frame, which is a state the page should be able to hold indefinitely. */
const team: {
  name: [string, string];
  role: [string, string];
  bio: [string, string];
  /** media key under the site CDN; absent means the monogram */
  photo?: string;
  /** shown when there is no photo; a Latin initial reads better in English */
  initial: [string, string];
}[] = [
  {
    name: ["陈玉洁", "Yujie Chen"],
    role: ["创始人", "Founder"],
    photo: "team/chen-yujie-v1.webp",
    initial: ["陈", "C"],
    bio: [
      "教育学、心理学与社会学的跨学科背景，在德国、美国、澳大利亚求学与工作。曾任职于联合国训练研究所（UNITAR）纽约，从事媒介与信息素养、可持续发展教育与 AI 课程设计。她长期在不同国家、文化与教育体系之间做课程协作，擅长把复杂议题转化为可学习、可评估、可行动的教育方案。",
      "An interdisciplinary background in education, psychology and sociology, with study and work across Germany, the United States and Australia. At UNITAR in New York she worked on media and information literacy, education for sustainable development and AI curriculum design. Years of collaboration across countries, cultures and education systems have made her expert at turning a complex issue into something that can be learned, assessed and acted on.",
    ],
  },
  {
    name: ["侯煜欣", "Yuxin Hou"],
    role: ["创始人", "Founder"],
    photo: "team/hou-yuxin-v1.webp",
    initial: ["侯", "H"],
    bio: [
      "清华大学毕业，工学、教育学、心理学与社会学的跨学科背景，在 AI + 教育领域深耕十余年。曾作为联合创始人与 CTO 打造全国首个自适应 AI 教师，也曾在联合国儿童基金会（UNICEF）参与社会情感学习课程设计。她持续研究的问题只有一个：AI 时代真正的核心竞争力是什么，以及它到底怎么习得。",
      "A Tsinghua graduate with an interdisciplinary background spanning engineering, education, psychology and sociology, and more than a decade in AI and education. She was co-founder and CTO of China's first adaptive AI teacher, and worked on social-emotional learning curriculum design at UNICEF. One question runs through all of it: what the core competence of the AI era actually is, and how it is actually acquired.",
    ],
  },
  {
    name: ["杨欣松", "Xinsong Yang"],
    role: ["技术顾问", "Technical adviser"],
    initial: ["杨", "Y"],
    bio: [
      "计算机科学与社会科学的跨学科背景，多年软件工程与互联网产品研发经验，曾任职于 Tubi、爱奇艺等科技公司，参与大规模互联网产品与数据系统的研发。近年持续关注生成式 AI 如何改变人的学习、思考与决策方式，并探索 AI 原生产品的设计与开发。",
      "An interdisciplinary background in computer science and the social sciences, with years of software engineering and product work at Tubi and iQIYI on large-scale consumer products and the data systems behind them. Lately his attention has been on how generative AI changes the way people learn, think and decide — and on what an AI-native product should therefore be.",
    ],
  },
  {
    name: ["周晓卓", "Xiaozhuo Zhou"],
    role: ["课程实习生", "Curriculum intern"],
    photo: "team/zhou-xiaozhuo-v1.webp",
    initial: ["周", "Z"],
    bio: [
      "北京大学国际中文教育硕士，语言学、认知科学与心理学的跨学科背景，研究方向涵盖二语习得、实验语用学与心理语言学。曾任高校辩论队队长与学生心理协会会长，有中文教学、跨文化教育与逻辑思维训练的实践经验。她关心的是怎么把复杂知识变成清晰、可参与的学习体验。",
      "A master's in international Chinese-language education from Peking University, with an interdisciplinary background in linguistics, cognitive science and psychology — second-language acquisition, experimental pragmatics, psycholinguistics. She has captained a university debate team, chaired its student psychology society, and taught Chinese across cultures. Her question is how complex knowledge becomes a learning experience clear enough to take part in.",
    ],
  },
  {
    name: ["郭浩然", "Haoran Guo"],
    role: ["研究实习生", "Research intern"],
    photo: "team/guo-haoran-v1.webp",
    initial: ["郭", "G"],
    bio: [
      "清华大学博士生在读，专业为管理科学与工程。",
      "A PhD candidate in management science and engineering at Tsinghua University.",
    ],
  },
];

/* the four red lines — AGENTS.md 铁律, in the whitepaper's voice */
const redlines: [string, string, string, string][] = [
  ["AI 克制，绝不替学生定论", "The AI holds back, and never concludes for her", "AI 可以解释概念、生成检索词、扮演反方、指出草稿断裂；但不能替她确定研究方向，不能替她完成核心判断，不能生成可直接提交的正文。助产士替产妇分娩，是职业的自我取消。", "It may explain a concept, generate search terms, play the opposition, flag a broken draft. It may not set her direction, make her core judgment, or produce submittable prose. A midwife who gives birth for the mother has abolished the profession."],
  ["不操纵", "No manipulation", "这个产品教学生「不被俘获」。所以它不能用老虎机式的机制留人——没有连胜、排行榜、徽章、上瘾式推送；也不用弹窗强迫：工具卡触发是自动的，但打开由学生确认。", "This product teaches students not to be captured. So it cannot use slot-machine mechanics to hold them — no streaks, leaderboards, badges or engagement pushes — and no coercive modals: a card may be triggered automatically, but opening it is always her call."],
  ["一次只问一个", "One question at a time", "陪练对话短、不啰嗦。这既降低 token，也保护学生的思考节奏——把三个问题一起抛过去，等于让她一个都答不好。", "The coach is short and doesn't ramble. That saves tokens, and it protects her thinking rhythm — throw three questions at once and she'll answer none of them well."],
  ["过程即数据", "Process is data", "学生跳过工具卡、让 AI 直接答，也被记录。摩擦被转成信号，不被消灭。一个只测量、不干预的系统，测得越准，也只是更准确地记录学生如何变得被动。", "Skipping a card, or asking the AI to just answer, is recorded too. Friction becomes signal instead of being eliminated. A system that only measures and never intervenes just documents, with increasing accuracy, how a student became passive."],
];


const rollout: [string, string, string, string][] = [
  ["学校建班", "The school creates a class", "老师或管理员建立班级，拿到一个班级邀请码。", "A teacher or admin creates a class and receives a join code."],
  ["学生凭码注册", "Students join with the code", "账号自动归属对应的学校与班级。每个账号都必属于某个学校与班级——不存在「无组织账号」，也没有面向公众的自助注册。", "Accounts bind to the right school and class. Every account belongs to a school and a class — there are no orphan accounts and no public self-serve signup."],
  ["带着真实任务开练", "They bring real work", "EE、TOK、IA、课题研究、科创项目——形态不重要，思考的过程会被一路记下来。", "EE, TOK, IA, a research project, a science-fair entry — the form doesn't matter. The thinking gets recorded either way."],
];
---

<!-- ═════════════════════════════════════════════════ HERO ════════ -->
<PageBanner
  asset="banner/about-v1.webp"
  eyebrow={["关于我们", "About us"]}
  title={[
    ["为 AI 原生教育而生的", "An AI-native team,"],
    ["AI 原生团队。", "built for AI-native education."],
  ]}
  lead={[
    "一支跨教育学、心理学、社会学与工学的团队，来自清华、北大与联合国机构。我们在同一个问题上花了十几年：AI 时代真正值得培养的能力是什么，以及它怎么被教会、被看见。",
    "One team across education, psychology, sociology and engineering, out of Tsinghua, Peking University and the UN system. We have spent more than a decade on a single question: what ability is actually worth building in the age of AI, and how it can be taught and made visible.",
  ]}
/>

<!-- ═══════════════════════════════════════════════ BELIEF ═══════ -->
<section class="section tight">
  <div class="container narrow">
    <div class="pull rv">{t(lang, "格物致知", "Investigate things; arrive at understanding")}</div>
    <p class="body rv" style="margin-top:36px">
      {t(
        lang,
        "《大学》讲「致知在格物」：要形成自己的判断，先得亲自去究事物之理。两千五百年后，IB 的 TOK 把「对知识本身发问」设成考试内容——措辞相隔两千五百年，指的是同一件事。这个目标很老，老到不同文明都独立写下过它；而在这两千五百年里，它一直只能靠师徒之间的言传身教传递，从来没有过读数。",
        "The Great Learning holds that understanding comes from investigating things: to form your own judgment, you must go and examine the thing yourself. Twenty-five centuries later, IB's TOK makes questioning knowledge itself an examinable subject — different words, the same idea. The goal is old enough that separate civilisations wrote it down independently, and for all those centuries it could pass only from teacher to student by example. There was never a reading.",
      )}
    </p>
    <p class="body rv" style="margin-top:18px">
      {t(
        lang,
        "我们做的，是把它第一次变成高频、可追溯、可干预的过程性证据。所有的指挥棒都在转向，而它们共同指着的那个位置，现在还空着——我们站在那里。",
        "What we do is turn it, for the first time, into process evidence that is frequent, traceable and actionable. Every one of those systems has been turning, and the place they all now point at is still empty. That's where we stand.",
      )}
    </p>
  </div>
</section>

<!-- ═════════════════════════════════════════════════ TEAM ══════ -->
<section class="section band-paper" id="team">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "团队", "The team")}</div>
      <h2 class="sec-title">{t(lang, "课程、系统与认知，坐在同一张桌子上", "Curriculum, systems and cognition at one table")}</h2>
      <p class="lead">
        {t(
          lang,
          "有人设计课程与评估，有人构建系统与算法，有人研究语言与认知。这套产品里的每个决定——什么时候递出工具卡、什么时候不给答案、报告里哪句话可以写——同时是教学问题和工程问题，所以它们必须一起被决定。",
          "Some of us design the curriculum and the assessment, some build the systems and the algorithms, some study language and cognition. Every decision in this product — when a thinking card appears, when the coach withholds an answer, what a report is allowed to say — is a teaching question and an engineering question at once, which is why they have to be settled together.",
        )}
      </p>
    </div>

    <div class="team" style="margin-top:52px">
      {team.map((m, i) => (
        <div class="member rv" style={`--i:${i % 3}`}>
          <div class="portrait">
            {m.photo ? (
              <img
                src={assetUrl(m.photo)}
                alt={t(lang, m.name[0], m.name[1])}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="mono-ph" aria-hidden="true">{t(lang, m.initial[0], m.initial[1])}</div>
            )}
          </div>
          <div class="mtext">
            <div class="mname">{t(lang, m.name[0], m.name[1])}</div>
            <div class="mrole">{t(lang, m.role[0], m.role[1])}</div>
            <p class="mbio">{t(lang, m.bio[0], m.bio[1])}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════ RED LINES ════ -->
<section class="section" id="discipline">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "我们的愿景", "Our vision")}</div>
      <h2 class="sec-title">{t(lang, "让每个孩子都能借助 AI 走得更远，而判断依然属于自己", "Every child goes further with AI — and still owns the judgment")}</h2>
      <p class="lead">
        {t(
          lang,
          "我们要建的，是 AI 时代的教育基础设施：一套让学生在真实课题中与 AI 协作、让思考过程被完整记录、让能力成长被严谨评估的系统。学校由此第一次看得见 AI 是怎么被使用的，教师第一次拿到过程证据，学生第一次带走一份属于自己的成长档案。下面四条，是我们在实现它的过程中不会越过的边界。",
          "We are building the educational infrastructure of the AI era: a system where students work with AI on real coursework, where the thinking is recorded in full, and where growth is assessed rigorously. Schools see how AI is actually being used, teachers get process evidence for the first time, and students leave with a record of their own development. The four lines below are the boundaries we will not cross while building it.",
        )}
      </p>
    </div>

    <div class="grid-2" style="margin-top:48px">
      {redlines.map(([zh, en, pz, pe], i) => (
        <div class="card rv" style={`--i:${i % 2}`}>
          <span class="cardnum">{t(lang, "红线", "RED LINE")} 0{i + 1}</span>
          <div class="cardic a"><Icon name="slash" /></div>
          <h3>{t(lang, zh, en)}</h3>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <div class="callout yes rv" style="margin-top:32px">
      <div class="cl"><Icon name="help" />{t(lang, "这条红线管到哪为止", "Where this red line stops")}</div>
      <h3>{t(lang, "「不替学生做」只针对她的正文与核心判断", "“Never for the student” means her prose and her core judgments")}</h3>
      <p>
        {t(
          lang,
          "它不适用于确定性的系统步骤：生成一份计划、从她已经陈述的研究问题派生一份大纲——这些是系统该自动做的事，不需要为了「防操纵」再加一道确认门槛。把铁律扩大化，只会让产品变得难用，而不会让它更有原则。",
          "It does not apply to deterministic system steps: generating a plan, deriving an outline from a research question she has already stated. Those are things the system should just do. Stretching the rule to cover them makes the product harder to use without making it more principled.",
        )}
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════ FOR SCHOOLS ════ -->
<section class="section" id="schools">
  <div class="container">
    <div class="grid-2" style="gap:64px; align-items:start">
      <div class="rv">
        <div class="eyebrow"><span class="pip"></span>{t(lang, "为学校接入", "For schools")}</div>
        <h2 class="sec-title" style="margin-top:18px">{t(lang, "以班级为单位接入", "We roll out class by class")}</h2>
        <p class="lead" style="margin-top:22px">
          {t(
            lang,
            "想为你的学校或班级试用？先自己走一遍完整流程——从一条没标出处的推文，走到一份双轴报告——再聊接入。",
            "Want to try it for your school or class? Walk the whole flow yourself first — from an unsourced post to a two-axis report — and then let's talk about rolling it out.",
          )}
        </p>
        <div class="cta-row" style="margin-top:28px">
          <a class="btn btn-lg btn-primary" href={demoUrl}>{t(lang, "体验 Demo", "Try the demo")}</a>
        </div>
        <p class="small" style="margin-top:20px">
          {t(
            lang,
            "结构归属（学校 / 班级）与付费权益是两回事：账号归属是系统不变式，权益另算。",
            "Structural membership (school / class) and paid entitlement are separate things: membership is a system invariant; entitlement is handled apart from it.",
          )}
        </p>
      </div>

      <div class="rail rv" data-sequence data-step="200">
        {rollout.map(([zh, en, pz, pe], i) => (
          <div class="rail-node" data-seq-item>
            <div class="k">{t(lang, "第", "Step")} {i + 1} {t(lang, "步", "")}</div>
            <h4>{t(lang, zh, en)}</h4>
            <p>{t(lang, pz, pe)}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<CtaBand />

<Pager
  links={[
    {
      href: "/product",
      kicker: ["了解产品", "The product"],
      title: ["项目、课程、评估", "Projects, courses, evaluation"],
      body: ["学生在哪里做事、手上有什么、过程被怎么读", "Where the work happens, what she has in hand, how the process gets read"],
    },
    {
      href: "/algorithm",
      kicker: ["技术", "Under the hood"],
      title: ["让 AI 学会什么时候别答", "Teaching an AI when not to answer"],
      body: ["五层系统：克制、卡运行时、编排、记录、评估", "Five layers: restraint, card runtime, orchestration, record, evaluation"],
    },
  ]}
/>
