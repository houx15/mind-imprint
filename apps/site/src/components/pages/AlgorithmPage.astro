---
import Icon from "../Icon.astro";
import CtaBand from "../sections/CtaBand.astro";
import Pager from "../sections/Pager.astro";
import SystemStack from "../diagrams/SystemStack.astro";
import RestraintLadder from "../diagrams/RestraintLadder.astro";
import CourseWorkflow from "../diagrams/CourseWorkflow.astro";
import AgentTopology from "../diagrams/AgentTopology.astro";
import ContextStack from "../diagrams/ContextStack.astro";
import EvalPipeline from "../diagrams/EvalPipeline.astro";
import { getLang, t } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);

/* The five layers, in the order a student's action falls through them. */
const layers: [string, string, string, string, string, string][] = [
  [
    "L1 · RESTRAINT",
    "agent/prompt · summon_card",
    "克制层",
    "The restraint layer",
    "模型的默认行为是把答案给出来。克制阶梯先把每一轮劈成三档：直接回应、只给一句提示、或者调用 summon_card 把一张工具卡递回去。这个决定发生在服务端，客户端没有改写它的机会。",
    "A model's default is to produce the answer. The restraint ladder splits every turn three ways first: answer, offer one nudge, or call summon_card and hand a thinking card back. The decision is made server-side; the client gets no say in it.",
  ],
  [
    "L2 · CARD RUNTIME",
    "packages/contracts/cards",
    "工具卡运行时",
    "The card runtime",
    "34 张卡是 34 份 JSON 配置。字段原语只有七种，三种视觉态、事件采集与产出的标准信封完全共用。前端构建期 import，Go 用 go:embed 嵌同一批文件——决策层看到的卡目录，和学生手上的卡，永远是同一份真相。",
    "34 cards are 34 JSON files. There are seven field primitives, and the three visual states, the event capture and the standard envelope are shared by all of them. The frontend imports the files at build time and Go embeds the same ones — so the catalogue the decision layer sees and the card the student holds can never drift apart.",
  ],
  [
    "L3 · ORCHESTRATION",
    "coach loop · course FSM",
    "编排层",
    "The orchestration layer",
    "写作项目里只有一个智能体，走过所有工作面；只有必须吞下长文本的活儿才切给上下文隔离的子代理。课程侧反过来：生成交给智能体，播放交给一台确定性状态机，中间隔着一道三层校验的门。",
    "A writing project has exactly one agent, walking every surface; work is split off to a context-isolated sub-agent only when it must swallow a long text. Courses invert it: generation goes to an agent, playback to a deterministic state machine, with a three-layer validation gate between them.",
  ],
  [
    "L4 · RECORD",
    "event · checkpoint · citation",
    "记录层",
    "The record layer",
    "学生的每一步都落成结构化事件：卡的标准信封、检查点快照、正文修订、引用条目、里程碑。过程树由 parent_node_id 投影出来，不额外建表。跳过一张卡同样被记下——摩擦被转成信号。",
    "Every step lands as a structured event: the card's envelope, checkpoint snapshots, prose revisions, citation rows, milestones. The process tree is projected from parent_node_id rather than stored in a table of its own. Skipping a card is recorded too — friction becomes signal.",
  ],
  [
    "L5 · EVALUATION",
    "assembleFacts · ValidateRefs",
    "评估层",
    "The evaluation layer",
    "报告分两半。事实半区从记录里直接算，一次模型都不调；判断半区调旗舰模型，但只能引用一个预先建好的证据索引，生成之后逐条回指校验，指不到的整条丢弃，并记下丢弃率。",
    "The report has two halves. The fact half computes straight from the record and calls no model at all. The judgment half calls a flagship model, but may cite only a pre-built evidence index — and afterwards every citation is re-resolved, with unresolvable ones dropped whole and the drop rate recorded.",
  ],
];

/* 三层解耦 — the decoupling that makes cards a tool-use loop */
const decoupled: [string, string, string, string, string, string][] = [
  ["决策层", "Decision", "服务端", "server-side", "用不用卡、用哪一张。系统 prompt、克制阶梯、回灌与轮次循环，全部在服务端。", "Whether to use a card and which one. The system prompt, the restraint ladder, the refeed and the turn loop all live on the server."],
  ["单函数接线", "One function", "summon_card", "summon_card", "决策层与运行时之间只有一个函数：summon_card(card_id, reason, nudge_text)。", "Exactly one function connects decision to runtime: summon_card(card_id, reason, nudge_text)."],
  ["卡运行时", "Card runtime", "客户端", "client-side", "schema 驱动渲染、三视觉态、事件采集，产出一个标准信封。", "Schema-driven rendering, three visual states, event capture — and one standard envelope out."],
  ["回灌与沉淀", "Refeed", "过程树 + 评估", "tree + assessment", "信封回灌陪练，同时长成过程树，成为 rubric 评估的地基。", "The envelope feeds back to the coach, grows the process tree, and becomes the floor the rubric stands on."],
];

/* what the record layer actually stores */
const records: [string, string, string, string, string, string][] = [
  ["工具卡作答", "A card answered", "标准信封：status / field_values / event_trace", "Standard envelope: status / field_values / event_trace", "过程树节点、卡使用计数、D 轴证据", "A process-tree node, a usage count, D-axis evidence"],
  ["卡从哪来", "Where the card came from", "发起方标记：系统引导，或学生自发", "Provenance flag: system-prompted, or self-initiated", "A2 与 A4 的核心信号", "The core signal behind A2 and A4"],
  ["正文修订", "Prose revised", "检查点快照 + 变更事件", "A checkpoint snapshot plus change events", "D5：改的是论证，还是只是措辞", "D5: did the argument change, or only the wording"],
  ["加入一条来源", "A source added", "citation 行：出处、时间、在论证里的位置", "A citation row: origin, time, its job in the argument", "材料清单与 D2 的溯源证据", "The materials list and D2's provenance evidence"],
  ["阶段完成", "A stage completed", "里程碑事件", "A milestone event", "时间线与就绪度", "The timeline and the readiness reading"],
  ["每一次模型调用", "Every model call", "档位、输入输出 token、成本，各一行", "One row: tier, input and output tokens, cost", "组织成本汇总，以及一份报告到底花了多少", "Organisation cost rollups — and what one report actually cost"],
];

/* the three context levers */
const levers: [string, string, string, string, string, string][] = [
  ["01", "压缩", "Compact", "把定形的对话折进脊柱。它做的是持续把对话转成持久结构，跟「把聊天总结成一坨」是两回事。", "Fold solidified dialogue into the spine — continuously converting conversation into durable structure, rather than summarising the chat into a blob.", ""],
  ["02", "隔离", "Isolate", "当一个任务必须吞下很大的东西、只需吐回很小的东西时，才切给子代理。文章正文从不进主线程。", "Spin off a sub-agent only when a task must swallow something big and return something small. An article body never enters the main thread.", "a"],
  ["03", "重开", "Reset", "硬重置。自然边界是「新项目 = 新会话」，以及回顾之后——评估蒸馏出一条记忆增量，下一件事从头开始。", "The hard reset. The natural boundary is a new project, and the point just after review — where the assessment distils one memory delta and the next thing starts fresh.", "g"],
];

/* why this is hard to copy */
const hards: [string, string, string, string][] = [
  [
    "克制没法靠一句提示词实现",
    "Restraint doesn't come from a line in the prompt",
    "模型天生想把答案给出来。要让它在对的时刻停住，需要三样东西同时成立：服务端的决策阶梯、一个只有单一函数的接线、以及一套学生真的填得下去的卡。少一样，克制就退化成一句没人遵守的提示词。",
    "A model wants to hand over the answer. Making it stop at the right moment takes three things at once: a server-side decision ladder, a single-function seam, and cards a student will actually fill in. Drop any one and restraint decays into a line of prompt nobody obeys.",
  ],
  [
    "每一句判断都要能指回一条记录",
    "Every judgment has to point back at a record",
    "做法是先建一个候选证据索引，限定模型只能从里面引用；生成之后再逐条回指校验，指不到的整条丢弃，并把丢弃率记下来。这一步把「评语」变成「可核对的判断」——教师点开就能看到原始片段。",
    "The method: build an index of candidate evidence, bound the model to citing only from it, then re-resolve every citation afterwards, dropping unresolvable ones whole and recording the drop rate. That's what turns a comment into a checkable judgment — a teacher clicks and sees the raw fragment.",
  ],
  [
    "长项目的上下文经济学",
    "The context economics of a long project",
    "一个项目跨几周、几百轮对话，还要塞进文献、大纲、草稿。三根杠杆撑着它：定形的对话折进项目脊柱、吞长文本的活儿切给隔离子代理、在自然边界上重开。折叠按事件触发，不按时间——时间是错误的轴。",
    "A project runs for weeks and hundreds of turns, with sources, outlines and drafts to hold. Three levers carry it: solidified dialogue folds into the project spine, long-text work goes to an isolated sub-agent, and the session resets at natural boundaries. Folding fires on events, never on a timer — time is the wrong axis.",
  ],
];

/* engineering invariants */
const invariants: [string, string, string, string][] = [
  ["客户端绝不直连模型", "The client never talks to a model", "所有 LLM 调用走后端网关，记录档位、token 与成本；API key 只在服务端。", "Every call goes through the backend gateway, which records tier, tokens and cost. API keys exist only on the server."],
  ["新增一张卡 = 新增一份 JSON", "A new card is a new JSON file", "不改渲染器代码。这是 schema 驱动是否成立的验证标准——用现有字段原语拼，除非真需要全新交互。", "No renderer changes. That's the test of whether schema-driven actually holds — compose from existing field primitives unless a genuinely new interaction is required."],
  ["卡 spec 单一真相源", "One source of truth for card specs", "决策层的目录从 registry 派生，不手写第二份，避免触发条件漂移。前端构建期 import，后端 embed 同一批文件。", "The decision layer's catalogue derives from the registry — never a hand-written second copy, so trigger conditions can't drift. The frontend imports it; the backend embeds the same files."],
  ["标准信封结构不随意改", "The envelope structure stays put", "它是过程树、使用计数与评估的共同地基。后端按边界校验存储，内层深结构的真相归共享契约。", "It's the shared floor under the process tree, the usage counts and the assessment. The backend validates the envelope's boundary; the shared contract owns the inner shape."],
  ["课程文档确定、无时间、可移植", "Course documents are deterministic and time-free", "没有 URL、没有时间戳、没有随机 id。真实的时间、id 与网络只在宿主边界进入。", "No URLs, no timestamps, no baked-in random ids. Real time, ids and network enter only at the host boundary."],
];
---

<!-- ═════════════════════════════════════════════════ HERO ════════ -->
<section class="pagehero">
  <div class="wash">
    <i class="w1" style="width:540px;height:540px;background:var(--primary-tint);top:-250px;left:-140px"></i>
    <i class="w2" style="width:460px;height:460px;background:var(--green-tint);top:-180px;right:-120px"></i>
  </div>
  <div class="grid-bg"></div>
  <div class="pagehero-inner">
    <div class="eyebrow rv"><span class="pip"></span>{t(lang, "技术", "Technology")}</div>
    <h1 class="page-title">
      <span class="rv-line" style="--i:0"><span>{t(lang, "别人在把 AI 做得更会答。", "Everyone is making AI better at answering.")}</span></span>
      <span class="rv-line" style="--i:1"><span class="soft">{t(lang, "我们在教它什么时候别答。", "We taught ours when not to.")}</span></span>
    </h1>
    <p class="lead rv" style="--i:2">
      {t(
        lang,
        "AI 越会答，学生越不用想。所以这套系统真正的工程量，落在四件不太起眼的事上：让 AI 在关键时刻把问题交回去；把学生的每一个动作变成结构化记录；让一条跨越几周的项目对话仍然负担得起；让最后那份评估里的每一句话，都能指回一条真实存在的证据。",
        "The better an AI answers, the less a student has to think. So the real engineering here sits in four unglamorous places: getting the AI to hand the question back at the right moment; turning every move a student makes into a structured record; keeping one coherent conversation affordable across weeks of work; and making sure every sentence in the final assessment points back at evidence that actually exists.",
      )}
    </p>
    <div class="chips rv" style="--i:3; margin-top:32px">
      <a class="chip mono" href="#stack">five-layer stack</a>
      <a class="chip mono" href="#loop">summon_card</a>
      <a class="chip mono" href="#course">course-runtime</a>
      <a class="chip mono" href="#writing">project-spine</a>
      <a class="chip mono" href="#record">event-log</a>
      <a class="chip mono" href="#evaluation">evidence-index</a>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════════ THE FIVE LAYERS ════ -->
<section class="section" id="stack">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "系统总览", "The system")}</div>
      <h2 class="sec-title">
        {t(lang, "五层，从「要不要回答」开始", "Five layers, starting from whether to answer at all")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "多智能体是其中一层。让这件事真正成立的，是它上下的另外四层：决定 AI 什么时候闭嘴的克制层、把方法变成可执行卡片的运行时、把每个动作变成记录的记录层，以及一个不许凭空说话的评估层。",
          "Multi-agent is one layer of five. What makes the thing work is the four around it: a restraint layer that decides when the AI stays quiet, a runtime that turns a method into a card someone can execute, a record layer that turns every move into data, and an evaluation layer that isn't allowed to say anything ungrounded.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">restraint · card-runtime · orchestration · record · evaluation</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><SystemStack /></div>
        <div class="legend">
          <span><i class="a"></i>{t(lang, "决定 AI 说不说", "decides whether the AI speaks")}</span>
          <span><i class="p"></i>{t(lang, "编排与状态", "orchestration & state")}</span>
          <span><i class="g"></i>{t(lang, "被证据拴住的输出", "output tethered to evidence")}</span>
          <span><i></i>{t(lang, "落库结构", "stored structure")}</span>
        </div>
      </div>
    </div>

    <div class="layers rv" style="margin-top:44px">
      {layers.map(([n, id, zh, en, pz, pe]) => (
        <div class="layer">
          <div class="lz">{n}</div>
          <div>
            <h4>{t(lang, zh, en)}</h4>
            <div class="lid">{id}</div>
            <p>{t(lang, pz, pe)}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="callout rv" style="margin-top:24px">
      <div class="cl"><Icon name="lock" />{t(lang, "五层都站在同一个网关上", "All five stand on one gateway")}</div>
      <h3>{t(lang, "客户端绝不直连模型", "The client never talks to a model directly")}</h3>
      <p>
        {t(
          lang,
          "所有调用经过后端网关，API key 只在服务端；每一次真实调用记一行档位、token 与成本。陪练走中档模型、允许降级；评估走旗舰模型、永不降级。默认 DeepSeek，Anthropic 可选。",
          "Every call goes through the backend gateway, API keys live only on the server, and each real call logs a row of tier, tokens and cost. The coach runs mid-tier and may be downgraded; the assessment runs flagship and never is. DeepSeek by default, Anthropic optional.",
        )}
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════ THE CORE LOOP ════ -->
<section class="section band-paper" id="loop">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "L1 · 克制层", "L1 · the restraint layer")}</div>
      <h2 class="sec-title">
        {t(lang, "一次工具调用，执行者是学生", "A tool call whose executor is a student")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "模型照常发起一次工具调用，只是这一次，执行工具的是学生。她填完的东西按标准信封回到模型手里，同时长成过程树。这句话是整个架构的一句话总结。",
          "The model issues a tool call exactly as it would any other. It's just that this time the executor is the student. What she fills in comes back as a standard envelope — and grows the process tree on the way. That one sentence is the whole architecture.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">restraint-ladder · summon_card · card-runtime</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><RestraintLadder /></div>
        <div class="legend">
          <span><i class="p"></i>{t(lang, "服务端决策", "server-side decision")}</span>
          <span><i class="a"></i>{t(lang, "学生执行", "executed by the student")}</span>
          <span><i class="g"></i>{t(lang, "测量信号", "measurement signal")}</span>
          <span><i></i>{t(lang, "落库结构", "stored structure")}</span>
        </div>
      </div>
    </div>

    <div class="sec-head rv" style="margin-top:80px">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "三层解耦", "Three decoupled layers")}</div>
      <h2 class="sub-title" style="margin-top:14px">
        {t(lang, "决策、接线、运行时、沉淀——四段之间只有窄接口", "Decision, wiring, runtime, sediment — and only narrow seams between them")}
      </h2>
    </div>

    <div class="ribbon four rv-pop" style="margin-top:32px">
      {decoupled.map(([zh, en, wz, we, pz, pe], i) => (
        <div class="rstep">
          <div class="s">{String(i + 1).padStart(2, "0")} · {t(lang, wz, we)}</div>
          <h4>{t(lang, zh, en)}</h4>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════ COURSE · WORKFLOW ════ -->
<section class="section" id="course">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "L3 · 课程侧", "L3 · the course side")}</div>
      <h2 class="sec-title">{t(lang, "生成交给智能体，播放交给状态机", "Generation goes to the agent, playback goes to the state machine")}</h2>
      <p class="lead">
        {t(
          lang,
          "课程生成智能体只需要产出一份能过校验的文档；过了那道门，渲染器一定播得出来。把不确定的部分（生成）和必须确定的部分（播放）彻底分开——这是这套课程运行时唯一重要的设计决定。",
          "The authoring agent only has to emit a document that passes validation. Past that gate, the renderer will play it. Separating the uncertain part (generation) from the part that must be certain (playback) is the one design decision that matters here.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">course-contract · course-runtime · course-renderer</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><CourseWorkflow /></div>
        <div class="legend">
          <span><i class="a"></i>{t(lang, "智能体产出", "agent output")}</span>
          <span><i class="p"></i>{t(lang, "校验与状态", "validation & state")}</span>
          <span><i class="g"></i>{t(lang, "完成与运行时", "completion & runtime")}</span>
        </div>
      </div>
    </div>

    <div class="grid-3" style="margin-top:48px">
      <div class="card rv" style="--i:0">
        <div class="cardic"><Icon name="shield" /></div>
        <h3>{t(lang, "一道门，三层校验", "One gate, three layers")}</h3>
        <p>{t(lang, "结构（schema）→ 引用（每个 id 都解析得到、每个块恰好落在一个槽位）→ 状态机图（起始步与每条转移都指向真实的步）。三关全过才算数。", "Structure (schema) → references (every id resolves, every block sits in exactly one slot) → graph (the initial step and every transition resolve to a real step). All three, or nothing.")}</p>
      </div>
      <div class="card rv" style="--i:1">
        <div class="cardic"><Icon name="loop" /></div>
        <h3>{t(lang, "纯的、可重放的解释器", "A pure, replayable interpreter")}</h3>
        <p>{t(lang, "转移在执行进入动作之前就先武装好，解释器本身没有副作用，整段过程可以从事件日志重放——这就是「过程即数据」在课程侧的实现。", "Transitions are armed before enter-actions run, the interpreter is side-effect free, and the whole session replays from its event log. That's “process is data”, implemented.")}</p>
      </div>
      <div class="card rv" style="--i:2">
        <div class="cardic a"><Icon name="spark" /></div>
