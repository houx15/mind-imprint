---
import Icon from "../Icon.astro";
import CtaBand from "../sections/CtaBand.astro";
import PageBanner from "../sections/PageBanner.astro";
import Pager from "../sections/Pager.astro";
import SystemStack from "../diagrams/SystemStack.astro";
import RestraintLadder from "../diagrams/RestraintLadder.astro";
import CourseWorkflow from "../diagrams/CourseWorkflow.astro";
import AgentTopology from "../diagrams/AgentTopology.astro";
import ContextStack from "../diagrams/ContextStack.astro";
import EvalPipeline from "../diagrams/EvalPipeline.astro";
import { getLang, t } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);

/* The five key algorithms, in the order a student meets them.
   Each carries the claim it was built to serve — the line an educator or an
   investor is actually reading for. */
const keys: [string, string, string, string, string, string, string, string][] = [
  [
    "01",
    "course-workflow",
    "拟人化的课程工作流",
    "Human-like course workflow",
    "一门课不是一段视频加几道题。它按一个老师的节奏推进：放材料、等她看完、就着材料追问、在她卡住的地方递一张工具卡、等她答完，再决定往哪走。她的答案会改变后面的路线。",
    "A course isn't a video with questions bolted on. It paces itself the way a teacher does: show the material, wait, ask about that material, hand over a card where she gets stuck, wait for her answer, then decide where to go. What she answers changes the route ahead.",
    "课程的产出是能力，交付物是几张能带进真实课题的方法卡——一门课上完，学生手上多了工具，不只是多了一段观看时长。",
    "The outcome of a course is capability and the deliverable is a handful of methods she can carry into real coursework — she leaves with tools in hand, not with watch time.",
  ],
  [
    "02",
    "restraint-ladder",
    "教育增强的 AI 智能体",
    "Education-enhanced AI agent",
    "通用助手的本能是把答案给全。这个智能体每一轮先问自己一件事：这一刻，思考应该留给谁。该答的答，该提示的提示，该把思考还回去的时候，它递出一张工具卡——一次只问一个问题。",
    "A general assistant's instinct is to complete the answer. This one asks itself something first, every turn: who should be doing the thinking right now. It answers when answering helps, nudges when a nudge is enough, and hands a thinking card back when the thinking is hers — one question at a time.",
    "这是学校最在意的那条线：AI 全程在场，正文与核心判断始终归学生所有。它由系统守住，不靠师生的自觉。",
    "This is the line schools care about most: the AI is present throughout, and the prose and the core judgment stay hers. The system holds that line, rather than leaving it to everyone's good intentions.",
  ],
  [
    "03",
    "project-spine",
    "多智能体协作",
    "Multi-agent assistance",
    "一个项目要跑几周。主智能体走过立题、阅读、写作、回顾所有工作面，记忆不断线；只有必须吞下长文本的活儿——读一篇论文、评一段过程——才交给上下文隔离的子代理，回来只带结论。",
    "A project runs for weeks. The main agent walks framing, reading, writing and review with an unbroken memory; only work that must swallow a long text — reading a paper, assessing a whole process — goes to a context-isolated sub-agent, which comes back with conclusions only.",
    "它撑得起 EE、IA、课题研究这类跨周的大任务。而恰恰是这类任务，才让判断力有机会显形——短任务里看不出一个人会不会想。",
    "It carries the multi-week work — EE, IA, a research project. And that's exactly the work in which judgment becomes visible: a short task can't show you whether someone can think.",
  ],
  [
    "04",
    "stage-router",
    "分阶段的 AI 支持",
    "Staged AI support",
    "同一句「我帮你看看」，在立题阶段是帮助，在写作阶段就是代劳。所以支持按阶段路由：每个阶段 AI 能做什么、不能做什么，是分别定义的。支持还要会退场——一张卡被召唤得越来越少，才算教会了。",
    "“Let me take a look at that” is help while she's framing a question and ghost-writing once she's drafting. So support is routed by stage: what the AI may and may not do is defined separately for each one. And support has to withdraw — a card has succeeded when it stops being summoned.",
    "教师可以放心把 AI 交到学生手上：边界写在系统里，不靠一遍遍叮嘱维持，也不用老师在旁边盯着。",
    "A teacher can hand the AI to a class without hesitating: the boundary is written into the system, so it doesn't depend on repeated reminders or on somebody standing over them.",
  ],
  [
    "05",
    "evidence-index",
    "过程评估",
    "Process evaluation",
    "最后把整段过程读回来，写成一份报告。数得出来的部分直接从记录里算；需要判断的部分，每一句都必须指回一条真实存在的片段——点开就是当时的那段对话、那张卡、那条来源。",
    "At the end the whole process gets read back into a report. Whatever can be counted computes straight from the record. Whatever takes judgment must point at a fragment that actually exists — click it and there's the conversation, the card, the source.",
    "思维过程第一次成了拿得出来的东西：教师看得见证据、家长看得懂叙述、学生看得到自己的轨迹，学校也终于有了作品之外的第二种依据。",
    "For the first time the thinking itself is something you can produce: teachers see the evidence, families read the narrative, a student sees her own trajectory — and a school finally has a second kind of proof beyond the finished work.",
  ],
];

/* the depth behind the five — what has actually been built */
const depthStats: [number, string, string, string, string][] = [
  [34, "张", "思维工具卡", "thinking cards", ""],
  [9, "个", "学科透镜", "disciplinary lenses", ""],
  [12, "个", "可观察的测量点", "observable measurement points", ""],
  [7, "张", "国际课程评分表（D 轴的来源）", "international mark schemes behind the depth axis", ""],
];

/* 三层解耦 — how a card becomes a tool the student executes */
const decoupled: [string, string, string, string, string, string][] = [
  ["决定", "Decide", "服务端", "server-side", "这一刻该不该把思考还回去，该还哪一张卡。整条克制阶梯都在服务端，前端改不动。", "Whether the thinking should go back to her this turn, and which card to send. The whole restraint ladder lives server-side, out of the client's reach."],
  ["递出", "Hand over", "summon_card", "summon_card", "决策与卡之间只有一个函数：summon_card(卡, 理由, 一句提示)。触发是自动的，打开由学生确认。", "One function connects the decision to the card: summon_card(card, reason, nudge). The trigger is automatic; opening it is her call."],
  ["执行", "Execute", "由学生完成", "by the student", "卡在她手上展开，她自己填。AI 不代填一个字段——这一步的执行者是人。", "The card opens in her hands and she fills it in. The AI completes not one field: the executor of this step is a person."],
  ["回灌", "Feed back", "过程树 + 评估", "tree + assessment", "她填完的内容回到对话里继续被追问，同时长成过程树，成为评估那一刀的地基。", "What she wrote returns to the conversation to be questioned further, grows the process tree, and becomes the floor the assessment stands on."],
];

/* stage-by-stage: what the AI may and may not do */
const stages: [string, string, string, string, string, string][] = [
  ["立题", "Framing", "把模糊的兴趣问回一个能回答的问题；生成检索词；指出范围过大", "Questions a vague interest back into an answerable one, generates search terms, flags an over-broad scope", "不替她定题", "Never picks the question"],
  ["文献与阅读", "Sources & reading", "隔离读完长文只带要点回来；在合适的时刻递 SIFT、CRAAP", "Reads long texts in isolation and returns only takeaways; offers SIFT or CRAAP at the right moment", "不替她判断一条来源能不能用", "Never decides whether a source can be used"],
  ["写作", "Writing", "指出论证断裂、扮演反方、查引用是否支持这句话", "Points at a broken warrant, plays the opposition, checks whether a citation supports the sentence", "不写一个字正文", "Never writes a word of the prose"],
  ["修订", "Revising", "通读草稿给批注，追问「这里改的是论证，还是只是措辞」", "Reads the draft and comments, asking whether a change moved the argument or only the wording", "不替她改", "Never makes the edit for her"],
  ["回顾", "Review", "把整段过程读成一份报告，指出下一步", "Reads the whole process into a report and names a next step", "不替她写反思", "Never writes her reflection"],
];

/* why this is hard */
const hards: [string, string, string, string][] = [
  [
    "克制比聪明难",
    "Holding back is harder than being smart",
    "模型的默认行为是把答案给全。要让它在对的时刻停住，得先让「把思考还回去」变成一个它真的能调用的动作——也就是一张学生愿意填、填了有用的卡。没有这张卡，克制只是一句没人遵守的提示词。",
    "A model's default is to complete the answer. To make it stop at the right moment, handing the thinking back has to become something it can actually invoke — a card a student will fill in and be better for. Without the card, restraint is just a line of prompt nobody obeys.",
  ],
  [
    "支持要随阶段变化，还要肯退场",
    "Support has to change by stage — and then withdraw",
    "同一个动作，换个阶段就从帮助变成代劳。所以每个阶段的边界是分别定义的。更难的一半是退场：脚手架的宿命是拆除，所以我们盯的指标是「这张卡被召唤得越来越少，而它封装的那句追问开始出现在学生自己的提示词里」。",
    "The same move flips from help to ghost-writing when the stage changes, so each stage's boundary is defined separately. The harder half is withdrawal: scaffolding is meant to come down, so the metric we watch is a card being summoned less and less while the question it packaged starts appearing in the student's own prompts.",
  ],
  [
    "评语要能被核对",
    "A comment has to be checkable",
    "「他的论证有进步」这种话，家长和教师没法核对。所以每一句判断都绑着一条真实片段：点开就是当时的对话、那张卡、那条来源。指不到证据的判断，我们宁可不说——报告里因此会出现「本周期证据不足」。",
    "“His argument has improved” is something no parent or teacher can check. So every judgment carries a real fragment: click and there's the conversation, the card, the source. A judgment that can't point at evidence goes unsaid — which is why a report will sometimes read “not enough evidence this cycle”.",
  ],
  [
    "这五件事是互相喂养的",
    "The five feed each other",
    "卡该在什么时刻递出来，判断依据来自真实项目留下的过程记录；量表怎么分层，来自七张国际课程评分表与三十年的实证研究；而报告读的，又正是这些卡留下的痕迹。单独复制其中任何一件都不难，难的是让它们同时成立、并且一起变好。",
    "When a card should be offered is decided from process records left by real projects; how the rubric reads a level comes from seven international mark schemes and three decades of empirical work; and what the report reads is the trail those same cards leave. Any one piece is copyable. Having all of them hold at once — and improve together — is the hard part.",
  ],
];
---

<!-- ═════════════════════════════════════════════════ HERO ════════ -->
<PageBanner
  asset="banner/algorithm-v1.webp"
  eyebrow={["技术", "Technology"]}
  title={[
    ["我们围绕教育场景，", "We build AI around the classroom —"],
    ["构建真正具备教学性的 AI。", "AI that can actually teach."],
  ]}
  lead={[
    "通用大模型擅长把答案给得又快又好，而这恰恰是课堂上最不需要的能力。我们的工程投入在另外五件事上：让课程按教学节奏推进、让教练懂得何时不给答案、让多个智能体协作支撑一个长周期课题、让支持随阶段变化并按时退出，以及让最终评估里的每一句话都能追回原始记录。",
    "A general-purpose model is good at producing answers quickly and well — which is the last thing a classroom needs. Our engineering goes into five other things: pacing a course the way teaching is paced, teaching the coach when to withhold an answer, coordinating several agents across a project that runs for weeks, matching support to the stage and withdrawing it on time, and making every sentence of the final assessment traceable to the record.",
  ]}
>
  <div class="chips rv" style="--i:3; margin-top:32px">
    <a class="chip" href="#course">{t(lang, "课程推进", "Course pacing")}</a>
    <a class="chip" href="#agent">{t(lang, "教练克制", "Coach restraint")}</a>
    <a class="chip" href="#multi">{t(lang, "多智能体协作", "Multi-agent teamwork")}</a>
    <a class="chip" href="#staged">{t(lang, "分阶段支持", "Stage-matched support")}</a>
    <a class="chip" href="#evaluation">{t(lang, "证据可追溯", "Traceable evidence")}</a>
  </div>
</PageBanner>

<!-- ══════════════════════════════════════ THE FIVE ALGORITHMS ═══ -->
<section class="section" id="keys">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "五个关键算法", "Five key algorithms")}</div>
      <h2 class="sec-title">
        {t(lang, "五个围绕教学主张设计的 AI 算法", "Five AI algorithms, each designed around a teaching claim")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "下面五件事，每一件都是先有一个教学上的主张，才有对应的实现。它们按学生遇到的顺序排列：先在课程里学会方法，再带着方法进项目，最后由评估把整段过程读回来。",
          "Each of the five below started as a claim about teaching and only then became an implementation. They're in the order a student meets them: learn the method inside a course, carry it into a project, and have the assessment read the whole thing back at the end.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">course-workflow · restraint-ladder · project-spine · stage-router · evidence-index</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><SystemStack /></div>
        <div class="legend">
          <span><i class="p"></i>{t(lang, "推进学习的算法", "algorithms that move the learning")}</span>
          <span><i class="a"></i>{t(lang, "决定 AI 说到哪为止", "algorithms that decide how far the AI goes")}</span>
          <span><i class="g"></i>{t(lang, "把过程读回来", "reading the process back")}</span>
          <span><i></i>{t(lang, "贯穿五者的工具卡", "the card that runs through all five")}</span>
        </div>
      </div>
    </div>

    <div class="layers rv" style="margin-top:44px">
      {keys.map(([n, id, zh, en, pz, pe, wz, we]) => (
        <div class="layer">
          <div class="lz">{n}</div>
          <div>
            <h4>{t(lang, zh, en)}</h4>
            <div class="lid">{id}</div>
            <p>{t(lang, pz, pe)}</p>
            <span class="lwhy">{t(lang, wz, we)}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="grid-4" style="margin-top:56px">
      {depthStats.map(([n, , zh, en], i) => (
        <div class="stat rv" style={`--i:${i}`}>
          <div class="n tabular"><span data-count={n}>0</span></div>
          <div class="l">{t(lang, zh, en)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════ 01 · COURSE WORKFLOW ══ -->
<section class="section band-paper" id="course">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "01 · 拟人化的课程工作流", "01 · human-like course workflow")}</div>
      <h2 class="sec-title">{t(lang, "一门课按老师的节奏走，不按播放条走", "A course runs on a teacher's pacing, not on a progress bar")}</h2>
      <p class="lead">
        {t(
          lang,
          "视频课的问题是它只会往前播。这里的一节课是一条工作流：每一步都有「等她做完」这件事，她做了什么会改变下一步。课程内容由一个课程智能体生成，播放则完全确定——同一门课，每个学生走到的位置可以不同，但绝不会走进一个断掉的地方。",
          "A video only knows how to keep playing. Here a slice is a workflow: every step includes waiting for her, and what she does changes what comes next. A course-authoring agent writes the content; playback is fully determined — two students can end up in different places, and neither can end up somewhere broken.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">a slice: play · wait · ask · summon a card · branch</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><CourseWorkflow /></div>
        <div class="legend">
          <span><i class="a"></i>{t(lang, "课程智能体产出", "written by the course agent")}</span>
          <span><i class="p"></i>{t(lang, "推进与状态", "pacing & state")}</span>
          <span><i class="g"></i>{t(lang, "完成与产出", "completion & outcome")}</span>
        </div>
      </div>
    </div>

    <div class="grid-3" style="margin-top:48px">
      <div class="card rv" style="--i:0">
        <div class="cardic"><Icon name="clock" /></div>
        <h3>{t(lang, "每一步都会等她", "Every step waits for her")}</h3>
        <p>{t(lang, "看完这段材料、答完这个问题、填完这张卡，课程才往下走。「等」这件事在视频课里做不到，而它恰恰是教学里最要紧的一拍。", "The course moves on after she's watched, answered, filled the card in. Waiting is the one thing a video can't do — and it's the beat that matters most in teaching.")}</p>
      </div>
      <div class="card rv" style="--i:1">
        <div class="cardic"><Icon name="branch" /></div>
        <h3>{t(lang, "她的答案改变路线", "Her answer changes the route")}</h3>
        <p>{t(lang, "答得稳就往前推，答得含糊就换个角度再问一次，卡住就递一张工具卡。这些分支写在课程里，每个学生走出来的路径都是自己的。", "Answer solidly and it moves on; answer vaguely and it comes at the question from another side; get stuck and a card arrives. The branches are written into the course, so the path through it is her own.")}</p>
      </div>
      <div class="card rv" style="--i:2">
        <div class="cardic a"><Icon name="spark" /></div>
        <h3>{t(lang, "开场和收尾是为她现写的", "The opening and the ending are written for her")}</h3>
        <p>{t(lang, "同一门课，对刚做完溯源的学生和刚放弃一条线索的学生，第一句话不该一样。开场与收尾在播放时按这个学生生成，课程本身保持不变。", "The first line shouldn't be the same for a student who just traced a source and one who just abandoned a lead. Opening and closing are generated for this student at play time, while the course itself stays put.")}</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════ 02 · RESTRAINED AGENT ════ -->
<section class="section" id="agent">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "02 · 教育增强的 AI 智能体", "02 · education-enhanced AI agent")}</div>
      <h2 class="sec-title">
        {t(lang, "该学生想的时候，AI 递出一张思维工具卡", "When the thinking is hers, the AI hands over a card")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "这是整套设计里最关键的一句话。智能体照常发起一次工具调用，只是这一次，执行工具的是学生：一张思维工具卡在她手上展开，她自己填。填完的内容回到对话里继续被追问。教学动作与被记录的证据，在这一步是同一件事。",
          "This is the load-bearing sentence of the whole design. The agent issues a tool call as it would any other — except this time the executor is the student: a thinking card opens in her hands and she fills it in, and what she wrote returns to the conversation to be questioned further. Here the teaching move and the evidence of it are the same object.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">answer · nudge · hand the thinking back</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><RestraintLadder /></div>
        <div class="legend">
          <span><i class="p"></i>{t(lang, "智能体的决定", "the agent's decision")}</span>
          <span><i class="a"></i>{t(lang, "学生执行", "executed by the student")}</span>
          <span><i class="g"></i>{t(lang, "教学信号", "teaching signal")}</span>
          <span><i></i>{t(lang, "留下的记录", "the record left behind")}</span>
        </div>
      </div>
    </div>

    <div class="sec-head rv" style="margin-top:80px">
      <h2 class="sub-title">
        {t(lang, "从「决定」到「证据」，只有四步", "Four steps from a decision to a piece of evidence")}
      </h2>
      <p class="body" style="margin-top:14px">
        {t(
          lang,
          "四步之间的接口窄到只剩一个函数，所以教学法可以单独迭代：想改 AI 什么时候该闭嘴，改决策那一层；想加一张新卡，写一份卡的配置就够了。",
          "The seams between the four are narrow enough to be a single function, so the pedagogy can move on its own: change when the AI should stay quiet and you touch the decision layer; add a new card and you write one card's configuration.",
        )}
      </p>
    </div>

    <div class="ribbon four rv-pop" style="margin-top:32px">
      {decoupled.map(([zh, en, wz, we, pz, pe], i) => (
        <div class="rstep">
          <div class="s">{String(i + 1).padStart(2, "0")} · {t(lang, wz, we)}</div>
          <h4>{t(lang, zh, en)}</h4>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <div class="callout yes rv" style="margin-top:32px">
      <div class="cl"><Icon name="hand" />{t(lang, "自动触发，但由她打开", "Triggered automatically, opened by her")}</div>
      <h3>{t(lang, "递卡这个动作，本身就是一条教学信号", "The act of offering a card is itself a teaching signal")}</h3>
      <p>
        {t(
          lang,
          "系统在合适的场景把卡递过去，记「引导」；没人提示、她自己召唤，记「自发」。同一张卡，这一点之差，就是我们判断她是否已经把方法内化的主要依据。",
          "The system offers a card in the right situation: logged as prompted. She summons it with nobody asking: logged as self-initiated. Same card — and that one difference is the main thing we read when asking whether the method has become hers.",
        )}
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════ 03 · MULTI-AGENT ═════ -->
<section class="section band-paper" id="multi">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "03 · 多智能体协作", "03 · multi-agent assistance")}</div>
      <h2 class="sec-title">{t(lang, "一个智能体走完全程，记忆不断线", "One agent for the whole journey, with an unbroken memory")}</h2>
      <p class="lead">
        {t(
          lang,
          "立题、计划、阅读、写作、回顾是同一个「印记」的不同工作面。换房间只是把镜头移过去，它带着整段记忆一起走——所以写到第三周，它还记得她两周前为什么放弃那条线索。子代理只在必要时出场。",
          "Framing, planning, reading, writing and review are surfaces of the same Imprint. Changing rooms moves the camera and carries the whole memory along — so in week three it still knows why she dropped that lead in week one. Sub-agents appear only when they're needed.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">one continuous session · context-isolated sub-agents · the project spine</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><AgentTopology /></div>
        <div class="legend">
          <span><i class="p"></i>{t(lang, "主智能体", "the main agent")}</span>
          <span><i class="a"></i>{t(lang, "阅读子代理（隔离）", "reading sub-agent (isolated)")}</span>
          <span><i class="g"></i>{t(lang, "评估子代理（旗舰）", "assessment sub-agent (flagship)")}</span>
          <span><i></i>{t(lang, "项目脊柱", "the project spine")}</span>
        </div>
      </div>
    </div>

    <div class="grid-2 rv" style="margin-top:40px">
      <div class="card">
        <div class="cardic a"><Icon name="book" /></div>
        <h3>{t(lang, "阅读子代理 · 简报进，要点出", "Reading sub-agent · brief in, takeaways out")}</h3>
        <p>{t(lang, "进去的是项目范围和「为什么读这一篇」，隔离处理的是全文，回来的是五个字段：发现、可信度、关键引句、新线索、对提案的影响。文章正文从未进过主线程——所以读了二十篇之后，对话依然清爽。", "In: the project scope and why this source. Isolated on: the full text. Out: five fields — findings, credibility, key quotes, new leads, impact on the proposal. The article body never enters the main thread, so twenty sources later the conversation is still clean.")}</p>
      </div>
      <div class="card">
        <div class="cardic g"><Icon name="gauge" /></div>
        <h3>{t(lang, "评估子代理 · 用最好的模型，永不降级", "Assessment sub-agent · best model, never downgraded")}</h3>
        <p>{t(lang, "陪练可以用中档模型，反正它一次只问一个问题。评估不行：它要吞下整段过程，吐回双轴读数和一段会被学生、家长、教师反复读的叙述。这是我们唯一不省成本的地方。", "The coach can run mid-tier; it only ever asks one question at a time. The assessment can't: it swallows the whole process and returns the two-axis reading plus prose that students, parents and teachers will read again and again. It's the one place we don't economise.")}</p>
      </div>
    </div>

    <div class="sec-head rv" style="margin-top:80px">
      <h2 class="sub-title">
        {t(lang, "一个项目跑几周，对话不能失忆，也不能无限变长", "A project runs for weeks: the conversation can neither forget nor grow forever")}
      </h2>
      <p class="body" style="margin-top:14px">
        {t(
          lang,
          "办法是把定形的东西沉淀成结构：提案定稿、一篇文献读完、一张卡填完——这些一旦稳定下来就写进项目脊柱，对话里的原始轮次随即退场。每一轮现搭一份紧凑的视图，细节按需再取。",
          "The answer is to let settled things become structure: a proposal finalised, a source read, a card completed — once stable they're written into the project spine and the raw turns step out of the conversation. Each turn assembles a compact view, and detail is fetched when it's actually needed.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:32px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">memory → spine → rolling window · projected per turn</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><ContextStack /></div>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════════ 04 · STAGED SUPPORT ════ -->
<section class="section" id="staged">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "04 · 分阶段的 AI 支持", "04 · staged AI support")}</div>
      <h2 class="sec-title">{t(lang, "同一个帮助，换个阶段就成了代劳", "The same help becomes ghost-writing one stage later")}</h2>
      <p class="lead">
        {t(
          lang,
          "「我帮你看看这段」，在她还在想题目的时候是帮助，在她动笔之后就是替她写。所以边界按阶段分别定义：AI 在每个阶段能做什么、不能做什么，是两张分开的清单。",
          "“Let me look at that paragraph” is help while she's still deciding on a question and ghost-writing once she's drafting. So the boundary is defined stage by stage: what the AI may do and what it may not are two separate lists at every point.",
        )}
      </p>
    </div>

    <div class="tablewrap rv" style="margin-top:44px">
      <table class="dt">
        <thead>
          <tr>
            <th style="width:140px">{t(lang, "阶段", "Stage")}</th>
            <th>{t(lang, "AI 在这里做什么", "What the AI does here")}</th>
            <th style="width:230px">{t(lang, "永远不做", "What it never does")}</th>
          </tr>
        </thead>
        <tbody>
          {stages.map(([sz, se, dz, de, nz, ne]) => (
            <tr>
              <td class="k">{t(lang, sz, se)}</td>
              <td>{t(lang, dz, de)}</td>
              <td>{t(lang, nz, ne)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="grid-2 rv" style="margin-top:32px">
      <div class="callout yes">
        <div class="cl"><Icon name="target" />{t(lang, "什么时候算教会了", "When has it actually been taught")}</div>
        <h3>{t(lang, "一张卡被召唤得越来越少，才算教会了", "A card has worked when it stops being summoned")}</h3>
        <p>
          {t(
            lang,
            "使用量本身说明不了什么。我们盯的是两条同时发生的曲线：这张卡的召唤次数往下走，同时它封装的那句追问，开始出现在学生自己写的提示词和修订理由里。",
            "Usage on its own says nothing. We watch two curves moving together: this card's summons trending down, while the question it packaged starts turning up in the student's own prompts and in her reasons for a revision.",
          )}
        </p>
      </div>
      <div class="callout">
        <div class="cl"><Icon name="route" />{t(lang, "阶段由过程本身决定", "The stage is decided by the work itself")}</div>
        <h3>{t(lang, "她走到哪一步，取决于她做完了什么", "Where she is depends on what she has finished")}</h3>
        <p>
          {t(
            lang,
            "阶段不靠日期推进，也不靠她自己勾选。提案定稿了、文献读到一定数量了、初稿有了——这些真实发生的事推动阶段前进，AI 的边界随之改变。",
            "Stages don't advance on a date, and she doesn't tick a box. A proposal finalised, enough sources read, a first draft in place — real events move the stage forward, and the AI's boundary moves with it.",
          )}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═════════════════════════════════ 05 · PROCESS EVALUATION ════ -->
<section class="section band-cool" id="evaluation">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow"><span class="pip"></span>{t(lang, "05 · 过程评估", "05 · process evaluation")}</div>
      <h2 class="sec-title">{t(lang, "事实由系统算出，判断必须引用证据", "Facts are computed. Every judgment must cite evidence.")}</h2>
      <p class="lead">
        {t(
          lang,
          "报告分成两半。数得出来的那一半——轮次、材料数、字数、批注、修订、时间线——直接从记录里算，一次模型都不用调。需要判断的那一半交给最好的模型，但它只能引用一个事先建好的证据集里的东西；生成之后每一条引用都被逐条回指校验，指不到真实记录的一律摘除。",
          "The report has two halves. Everything countable — turns, materials, words, comments, revisions, the timeline — computes straight from the record without calling a model at all. The half that takes judgment goes to the best model available, but it may only cite from a pre-built set of evidence — and after generation every citation is resolved again, with any that doesn't land on a real record stripped out.",
        )}
      </p>
    </div>

    <div class="stage rv-pop" style="margin-top:48px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">counted facts · evidence index · grounded judgment</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><EvalPipeline /></div>
        <div class="legend">
          <span><i class="p"></i>{t(lang, "数出来的事实", "counted facts")}</span>
          <span><i class="a"></i>{t(lang, "可引用的证据", "citable evidence")}</span>
          <span><i class="g"></i>{t(lang, "模型下的判断", "the model's judgments")}</span>
          <span><i></i>{t(lang, "组装与核对", "assembly & checking")}</span>
        </div>
      </div>
    </div>

    <div class="grid-3" style="margin-top:48px">
      <div class="card rv" style="--i:0">
        <div class="cardic a"><Icon name="link" /></div>
        <h3>{t(lang, "每一句判断都点得开", "Every judgment opens")}</h3>
        <p>{t(lang, "模型能引用的东西被限定在一个索引里：某一条对话、某一次事件、某一张卡、某一个来源。教师点开看到的，就是当时真实发生的那一段。", "What the model may cite is bounded by an index: a conversation, an event, a card, a source. What a teacher opens is the thing that actually happened at the time.")}</p>
      </div>
      <div class="card rv" style="--i:1">
        <div class="cardic g"><Icon name="layers" /></div>
        <h3>{t(lang, "两根轴分开报告", "The two axes stay apart")}</h3>
        <p>{t(lang, "认知深度和智识自主分开测量、分开写，永不合成一个总分。同一段让步段，深度轴问她做得好不好，自主轴问这件事是谁发起的。", "Cognitive depth and intellectual autonomy are measured and written separately, never merged into one score. For the same concession paragraph, one axis asks how well it was done and the other asks who started it.")}</p>
      </div>
      <div class="card rv" style="--i:2">
        <div class="cardic"><Icon name="shield" /></div>
        <h3>{t(lang, "证据不够，就说不够", "Thin evidence gets said out loud")}</h3>
        <p>{t(lang, "这一周期没看到某一维的证据，报告就写「本周期证据不足」，而不是找一句稳妥的话填上去。没看到，只说明证据还在积累。", "If a dimension has no evidence this cycle the report says so, rather than reaching for a safe sentence to fill the gap. Nothing seen means evidence is still accumulating.")}</p>
      </div>
    </div>
  </div>
</section>

