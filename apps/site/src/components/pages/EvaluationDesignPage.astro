---
import Icon from "../Icon.astro";
import CtaBand from "../sections/CtaBand.astro";
import Pager from "../sections/Pager.astro";
import EvalPipeline from "../diagrams/EvalPipeline.astro";
import { getLang, t } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);

/* The four flagship calls. Three run concurrently; the fourth waits for C,
   because the overview has to know how the axes came out. */
const calls: [string, string, string, string, string, string][] = [
  ["A", "提问透镜", "The prompt lens", "只喂学生自己写过的提问。它读的是她怎么用 AI：要成品，还是要反方、要检验。", "Fed only the prompts she wrote herself. It reads how she uses AI: asking for a finished product, or asking for the counter-case and the check."],
  ["B", "风险行为", "Risk behaviour", "只喂风险信号切片。AI 代劳、缺少信源、论证断裂、口径漂移、跑题——有就写，没有就空着。", "Fed only the risk-signal slice. Work handed to the AI, missing sources, a broken warrant, drifting claims, going off-topic — reported when present, left empty when not."],
  ["C", "双轴判层", "The two axes", "喂完整过程摘要，产出 12 条判断：认知深度 D1–D6 各判一层，智识自主 A1–A6 各判一档。", "Fed the full trajectory digest, returning twelve judgments: a level for each of D1–D6, a band for each of A1–A6."],
  ["D", "综述与建议", "Overview & advice", "等 C 跑完才开始——综述要说清这次探究的样子，就得先知道两根轴落在了哪里。", "Starts only once C is done: an overview can't describe the inquiry without knowing where the axes landed."],
];

/* The nine sections of the report, with what each is made of. */
const sections: [string, string, string, string, string][] = [
  ["01", "基本信息", "Basics", "题目、类型、起止时间、里程碑与各项计数。全部数出来。", "Title, type, dates, milestones and every counter. All computed."],
  ["02", "综述", "Overview", "这次探究到底发生了什么，以及下一步的建议、值得上的课。", "What actually happened in this inquiry, what to do next, which courses would help."],
  ["03", "过程时间线", "Timeline", "每一个关键节点：时间、类型、当时的 AI 轮次，点得开对应记录。", "Every key moment: when, what kind, how many AI turns — each opening onto the record."],
  ["04", "材料清单", "Materials", "她找过的每一份材料、什么时候加进来、最后用在了哪里，以及哪些撑不住结论。", "Every material she found, when it arrived, where it ended up — and which ones couldn't carry the claim."],
  ["05", "认知深度 D", "Cognitive depth", "D1–D6 六个维度，各判一层，每层都要指回证据。", "Six dimensions, D1–D6, each given a level, each pointing back at evidence."],
  ["06", "智识自主 A", "Intellectual autonomy", "A1–A6 六个维度，各判一档，同样要指回证据。", "Six dimensions, A1–A6, each given a band, each likewise pointing back at evidence."],
  ["07", "提问透镜", "Prompt lens", "她是怎么向 AI 提问的：挑出几条值得看的提问，连着当时的上下文。", "How she asked: a handful of prompts worth looking at, each with the context it came from."],
  ["08", "工具卡与子代理", "Cards & sub-agents", "哪几张卡在哪个阶段被递出来、为什么，以及她怎么用的。", "Which cards were handed over at which stage and why — and what she did with them."],
  ["09", "风险提示", "Risks", "看到了什么值得留意的行为。没看到，就写没看到。", "Behaviour worth a teacher's attention. When there's none, it says there's none."],
];

const depthDims: [string, string, string, string, string][] = [
  ["D1", "任务理解与问题表述", "Task & question", "她把一个题目收窄成了什么问题，范围与对象说清了没有。", "What question she narrowed the topic into, and whether its scope and object are clear."],
  ["D2", "证据与信源", "Evidence & sources", "来源怎么找、怎么验，一条证据能证明到哪一步。", "How sources were found and checked, and how far a piece of evidence actually reaches."],
  ["D3", "论证结构", "Argument structure", "主张、理据与限定条件之间接不接得住。", "Whether claim, warrant and qualifier hold together."],
  ["D4", "视角与偏见", "Perspective & bias", "认不认得出自己的立场，接不接得住别的视角。", "Whether she can see her own position, and take on another."],
  ["D5", "反馈处理与修订", "Feedback & revision", "拿到反馈之后，改的是论证，还是只是措辞。", "After feedback: did the argument move, or only the wording."],
  ["D6", "反思与元认知", "Reflection", "说不说得出自己是怎么想的、哪一步想错了。", "Whether she can say how the thinking went, and where it went wrong."],
];

const autoDims: [string, string, string, string, string][] = [
  ["A1", "方向自主", "Direction", "往哪走，是谁决定的。", "Who decided where this goes."],
  ["A2", "发起自主", "Initiative", "无人要求时，思考由谁启动。", "When nobody asked: who started the thinking."],
  ["A3", "边界主权", "Boundary", "什么交给 AI、什么留给自己，由她说了算。", "What goes to the AI and what stays hers — and that it's her call."],
  ["A4", "对抗与检验", "Challenge & check", "对 AI 的说法做过检验，也提得出反对。", "Whether the AI's claims got checked, and pushed back on."],
  ["A5", "判断署名", "Ownership", "最后这句判断，她认不认是自己的。", "Whether she'll put her name to the judgment at the end."],
  ["A6", "求真优先", "Truth first", "结论不顺手的时候，选真的还是选省事的。", "When the conclusion is inconvenient: the true one, or the easy one."],
];
---

<!-- ═════════════════════════════════════════════════ HERO ════════ -->
<section class="pagehero">
  <div class="wash">
    <i class="w1" style="width:540px;height:540px;background:var(--green-tint);top:-250px;left:-140px"></i>
    <i class="w2" style="width:460px;height:460px;background:var(--primary-tint);top:-180px;right:-120px"></i>
  </div>
  <div class="grid-bg"></div>
  <div class="pagehero-inner">
    <div class="eyebrow rv"><span class="pip"></span>{t(lang, "技术 · 评估算法设计", "Technology · the assessment design")}</div>
    <h1 class="page-title">
      <span class="rv-line" style="--i:0"><span>{t(lang, "一句评语，必须能被核对。", "A comment has to be checkable.")}</span></span>
      <span class="rv-line" style="--i:1"><span class="soft">{t(lang, "所以事实由系统算出，判断只能引用证据。", "So facts are computed, and judgments may only cite evidence.")}</span></span>
    </h1>
    <p class="lead rv" style="--i:2">
      {t(
        lang,
        "「他的论证有进步」这种话，家长和教师没法核对。难的从来不是记录，是把几周的记录读成一份教师敢用、家长看得懂、学生不觉得冤的报告。下面是这份报告怎么生成的。",
        "“His argument has improved” is something no parent or teacher can check. The hard part was never the recording — it's reading weeks of record into a report a teacher will stand behind, a family can follow, and a student won't feel wronged by.",
      )}
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════ TWO HALVES ═══════ -->
<section class="section tight">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">{t(lang, "报告分成两半，两半的规矩完全不同", "The report has two halves, under two different rules")}</h2>
    </div>

    <div class="grid-2" style="margin-top:44px">
      <div class="callout rv">
        <div class="cl"><Icon name="chip" />{t(lang, "确定性半区", "The computed half")}</div>
        <h3>{t(lang, "数出来的事实，不是模型说的", "Facts that are counted, not asserted")}</h3>
        <p>
          {t(
            lang,
            "AI 轮次、材料数、正文字数、批注数、修订次数、里程碑、时间线、工具卡使用——全部直接从记录里算出来，这一半一次模型都不调。它每次跑出来的结果都一样，也永远不会编。",
            "AI turns, materials, word count, comments, revisions, milestones, the timeline, card usage — all computed straight from the record. This half never calls a model at all. It returns the same answer every time, and it cannot make anything up.",
          )}
        </p>
      </div>
      <div class="callout yes rv">
        <div class="cl"><Icon name="spark" />{t(lang, "模型半区", "The judged half")}</div>
        <h3>{t(lang, "要判断的部分，交给旗舰模型且永不降级", "Judgment goes to a flagship model, never downgraded")}</h3>
        <p>
          {t(
            lang,
            "陪练日常对话可以走中档模型，评估这一刀不行。四次调用全部走旗舰档，三路并发；每一条判断都必须引用一个事先建好的证据集里的东西。",
            "Day-to-day coaching may run on a mid-tier model; this cut may not. All four calls run on the flagship tier, three of them concurrently — and every judgment must cite something from a pre-built evidence set.",
          )}
        </p>
      </div>
    </div>

    <div class="stage rv-pop" style="margin-top:44px">
      <div class="stage-bar">
        <span class="dots"><b></b><b></b><b></b></span>
        <span class="t">counted facts · evidence index · grounded judgment</span>
      </div>
      <div class="stage-body">
        <div class="dhint">{t(lang, "← 左右滑动查看完整图 →", "← swipe to pan the diagram →")}</div>
        <div class="dscroll"><EvalPipeline /></div>
        <div class="legend">
          <span><i class="p"></i>{t(lang, "数出来的事实", "counted facts")}</span>
          <span><i class="a"></i>{t(lang, "可引用的证据", "citable evidence")}</span>
          <span><i class="g"></i>{t(lang, "模型下的判断", "the model's judgments")}</span>
          <span><i></i>{t(lang, "组装与核对", "assembly & checking")}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════ FOUR CALLS ══════ -->
<section class="section band-paper">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">{t(lang, "四次调用，各看各的那一部分", "Four calls, each looking at its own slice")}</h2>
      <p class="lead">
        {t(
          lang,
          "把整段过程一次性丢给一个模型，它会写得四平八稳，什么也不敢说。所以拆成四路：每一路只喂它该看的材料，判断因此更锋利，也更容易被反驳。",
          "Hand the whole process to one model and it writes something evenly bland that commits to nothing. So it's split four ways: each call is fed only what it needs, which makes the judgments sharper — and easier to argue with.",
        )}
      </p>
    </div>

    <div class="ribbon four rv-pop" style="margin-top:44px">
      {calls.map(([k, zh, en, pz, pe]) => (
        <div class="rstep">
          <div class="s">CALL {k}</div>
          <h4>{t(lang, zh, en)}</h4>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <p class="small rv" style="margin-top:18px">
      {t(
        lang,
        "A、B、C 三路并发，D 等 C。任何一路失败只会让对应板块变薄，报告仍然出得来——数出来的那一半始终在。",
        "A, B and C run concurrently; D waits for C. A failure in any one thins that section only — the report still comes out, because the computed half is always there.",
      )}
    </p>
  </div>
</section>

<!-- ═══════════════════════════════════════════════ TWO AXES ═════ -->
<section class="section">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">{t(lang, "两根轴分开测量，分开报告，永不合成总分", "Two axes, measured apart, reported apart, never merged")}</h2>
      <p class="lead">
        {t(
          lang,
          "缺深度的自主，产出的是自信的垃圾；缺自主的深度，是一台租给任何提示者的好引擎。把两者加权成一个数字，等于把这句话里最要紧的信息扔掉。",
          "Autonomy without depth produces confident garbage. Depth without autonomy is a good engine rented to whoever prompts it. Averaging the two into one number throws away the only part that mattered.",
        )}
      </p>
    </div>

    <div class="axes rv-pop" style="margin-top:44px">
      <div class="axis d">
        <div class="ah">
          <span class="ai"><Icon name="layers" /></span>
          <div>
            <div class="an">{t(lang, "认知深度", "Cognitive depth")}</div>
            <div class="ak">D-AXIS · D1–D6 · L1–L4</div>
            <p class="aq">{t(lang, "思考到达了第几层。深度决定判断的质量上限。", "How many layers down the thinking got. Depth sets the ceiling on quality.")}</p>
          </div>
        </div>
        {depthDims.map(([c, zh, en, pz, pe]) => (
          <div class="dim">
            <span class="dc">{c}</span>
            <div>
              <div class="dn">{t(lang, zh, en)}</div>
              <div class="df">{t(lang, pz, pe)}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="axis a">
        <div class="ah">
          <span class="ai"><Icon name="compass" /></span>
          <div>
            <div class="an">{t(lang, "智识自主", "Intellectual autonomy")}</div>
            <div class="ak">A-AXIS · A1–A6 · BAND 0–5</div>
            <p class="aq">{t(lang, "无人要求时，思考由谁启动、判断归谁所有。", "When nobody asked: who started the thinking, and whose judgment is it.")}</p>
          </div>
        </div>
        {autoDims.map(([c, zh, en, pz, pe]) => (
          <div class="dim">
            <span class="dc">{c}</span>
            <div>
              <div class="dn">{t(lang, zh, en)}</div>
              <div class="df">{t(lang, pz, pe)}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <p class="small rv" style="margin-top:20px">
      {t(
        lang,
        "D 轴的分层来自七张国际课程评分表——IGCSE GP、A Level GPR、EPQ、AP Seminar、AP Research、IB TOK、IB EE；剥掉各家术语，它们考的是同一条路。A 轴来自九十年代以来批判性思维「倾向」的实证研究。",
        "The depth levels come from seven international mark schemes — IGCSE GP, A Level GPR, EPQ, AP Seminar, AP Research, IB TOK, IB EE. Strip the vocabulary and they test one path. The autonomy axis comes from three decades of empirical work on critical-thinking dispositions.",
      )}
    </p>
  </div>
</section>

<!-- ══════════════════════════════════════ NINE SECTIONS ═════════ -->
<section class="section band-cool">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">{t(lang, "报告的九个板块", "The nine sections of the report")}</h2>
      <p class="lead">
        {t(
          lang,
          "一份报告 = 一个学生 + 一个项目。九个板块从「发生了什么」一路走到「值得留意什么」，教师、家长、学生看到的是同一份内容的不同投影。",
          "One report is one student on one project. Nine sections run from what happened to what deserves attention; teachers, families and the student each see a projection of the same thing.",
        )}
      </p>
    </div>

    <div class="tablewrap rv" style="margin-top:40px">
      <table class="dt">
        <thead>
          <tr>
            <th style="width:64px">#</th>
            <th style="width:200px">{t(lang, "板块", "Section")}</th>
            <th>{t(lang, "里面是什么", "What's in it")}</th>
          </tr>
        </thead>
        <tbody>
          {sections.map(([n, zh, en, pz, pe]) => (
            <tr>
              <td class="k">{n}</td>
              <td class="k">{t(lang, zh, en)}</td>
              <td>{t(lang, pz, pe)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════ EVIDENCE + REDLINES ══════ -->
<section class="section">
  <div class="container">
    <div class="grid-2" style="gap:64px; align-items:start">
      <div class="rv">
        <h2 class="sec-title">{t(lang, "证据索引：模型唯一被允许引用的东西", "The evidence index: the only thing a model may cite")}</h2>
        <p class="lead" style="margin-top:22px">
          {t(
            lang,
            "生成之前，系统先从记录里建一个索引：某一条消息、某一次事件、某一张卡、某一个来源，每一项都有 id。模型写判断时只能从这个集合里引用。",
            "Before generation, an index is built from the record: a message, an event, a card, a source — each with an id. When the model writes a judgment, it may cite only from that set.",
          )}
        </p>
        <p class="body" style="margin-top:18px">
          {t(
            lang,
            "生成之后再逐条回指校验一遍：指不到真实记录的引用一律摘除。所以教师在报告里点开的每一个证据链接，打开的都是当时真实发生的那一段——报告里不会出现一个点不开的链接。",
            "After generation every citation is resolved again, and any that doesn't land on a real record is stripped. So every evidence link a teacher opens in the report opens onto something that actually happened — there are no dead links in it.",
          )}
        </p>
      </div>

      <div class="stack rv">
        <div class="redline">
          <span class="rn">01</span>
          <div>
            <h4>{t(lang, "永不合成总分", "Never a composite score")}</h4>
            <p>{t(lang, "两根轴分开报告。不加权、不平均、不折算成一个数字。", "The two axes are reported apart. No weighting, no averaging, no single number.")}</p>
          </div>
        </div>
        <div class="redline">
          <span class="rn">02</span>
          <div>
            <h4>{t(lang, "永不用于筛选与排名", "Never used to select or rank")}</h4>
            <p>{t(lang, "不用于入学筛选、学生排名、纪律惩戒或教师绩效；不出售，不做商业画像。", "Never for admissions, ranking, discipline or staff appraisal. Never sold, never turned into a commercial profile.")}</p>
          </div>
        </div>
        <div class="redline">
          <span class="rn">03</span>
          <div>
            <h4>{t(lang, "证据不够时，就说不够", "When the evidence is thin, we say so")}</h4>
            <p>{t(lang, "没看到证据，只说明证据还在积累，并不代表这个学生没有能力。宁可不说，也不硬贴标签。", "No evidence seen only means evidence is still accumulating; it says nothing about the student's ability. We'd rather say nothing than pin on a label.")}</p>
          </div>
        </div>
        <div class="redline">
          <span class="rn">04</span>
          <div>
            <h4>{t(lang, "不给预测分", "No predicted grades")}</h4>
            <p>{t(lang, "照作品的那一侧只说该体系的官方语言，给出的是「离官方描述语还差哪几块证据」的就绪度。", "On the work's side we speak only that system's official language, and report readiness — which pieces of evidence are still missing.")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<CtaBand />

<Pager
  links={[
    {
      href: "/algorithm/multi-agent",
      kicker: ["另一个关键算法", "The other key algorithm"],
      title: ["多智能体教练系统", "The multi-agent coach"],
      body: ["一条会话走完全程，重活交给隔离的子代理", "One conversation throughout; heavy work goes to isolated sub-agents"],
    },
    {
      href: "/algorithm",
      kicker: ["返回", "Back"],
      title: ["技术总览 · 五层系统", "Technology · the five layers"],
      body: ["克制、卡运行时、编排、记录、评估", "Restraint, card runtime, orchestration, record, evaluation"],
    },
  ]}
/>
