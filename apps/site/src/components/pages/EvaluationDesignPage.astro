---
import Icon from "../Icon.astro";
import Figure from "../Figure.astro";
import CtaBand from "../sections/CtaBand.astro";
import Pager from "../sections/Pager.astro";
import PageBanner from "../sections/PageBanner.astro";
import DualAxis from "../diagrams/DualAxis.astro";
import { getLang, t, localePath } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);
const L = (p: string) => localePath(lang, p);

/* How the two axes were arrived at. Not invented — converted, from a consensus
   that has been standing since the Delphi Report. */
const derivation: [string, string, string, string, string][] = [
  [
    "1990",
    "德尔菲报告：能力与倾向是两件事",
    "The Delphi Report: skills and dispositions are two things",
    "Facione 主持的专家共识明确写下：理想的批判性思考者，兼具思维技能（skills）与思维倾向（dispositions）。此后形成两套并立的经典量表 —— CCTST 测技能，CCTDI 测倾向。两套工具并立这件事本身，就说明它们不能混成一个分。",
    "The expert consensus Facione convened states it plainly: the ideal critical thinker has both skills and dispositions. Two classic instruments followed — CCTST for skills, CCTDI for dispositions. That they stand side by side is itself the argument for never averaging them.",
  ],
  [
    "GAP",
    "清单不是量表",
    "A list is not a scale",
    "德尔菲交出的是两份清单。六项技能各打一个分、七种倾向各发一份问卷，得到的是十三个碎片。要把共识变成能运行的量规，必须为每一类因子找到它的「可测形态」。",
    "What Delphi produced were two lists. Score six skills, survey seven dispositions, and you have thirteen fragments. To turn a consensus into a working rubric, each family of factors needs a form in which it can actually be measured.",
  ],
  [
    "D",
    "技能需要一把共同的刻度",
    "Skills needed one shared ruler",
    "同样是「分析」，可以停在给部分命名，也可以进到部件之间的关系，再进到整个框架赖以成立的假设。贯穿全部六项技能、决定其表现高下的，是同一个纵向量：加工所到达的结构层级。技能回答「测哪些动作」，深度回答「动作做到了第几层」。",
    "“Analysis” can stop at naming the parts, or reach the relations between them, or reach the assumptions the whole frame rests on. Running through all six skills, and deciding how well each is done, is one vertical quantity: the structural level the processing reached. Skills say which moves to measure; depth says how far down the move went.",
  ],
  [
    "A",
    "倾向需要一个共同的观测面",
    "Dispositions needed one shared surface",
    "好奇是自发地提问，求真是自发地核查，开放是自发地修正，自信与成熟判断是敢于为结论署名 —— 逐项拆开，每一项都在描述同一件事：认知活动由谁驱动、判断归谁所有。学界为它保留了一个专名：智识自主。",
    "Curiosity is asking unprompted; truth-seeking is checking unprompted; open-mindedness is revising unprompted; confidence and maturity are being willing to sign the conclusion. Taken apart, each describes one thing: who drives the cognitive activity, and whose the judgment is. The literature has a name for it — intellectual autonomy.",
  ],
];

/* The depth ladder. Levels are judged RELATIVE to how open the task is, which
   is why a closed task cannot reach the top two. */
const rungs: [string, string, string, string, string, string][] = [
  ["L1", "单点", "One point", "抓住一个相关点就停下：复述一条事实、给一个标签。", "One relevant point and stop: restating a fact, applying a label.", ],
  ["L2", "多点", "Several points", "找齐了几个点，但彼此之间没有关系 —— 并列的清单，不是论证。", "Several points gathered, but unrelated to each other: a list, not an argument."],
  ["L3", "关联", "Related", "点与点之间接起来了：一个概念收编若干具体事实，并解释它们为什么性质不同。", "The points connect: a concept absorbs several specific facts and explains why they differ in kind."],
  ["L4", "拓展抽象", "Extended abstract", "把框架本身当作分析对象：这套判据在什么条件下失效？谁从这种框定中受益？", "The frame itself becomes the object: under what conditions do these criteria fail, and who benefits from this framing?"],
];

/* Who sees what. Straight out of the white paper's governance table. */
const visibility: [string, string, string, string, string, string][] = [
  ["学生本人", "The student", "自己的成长语言版报告：轨迹、亮点时刻、下一步；以及自己的对话明细。", "Her own report in growth language: trajectory, standout moments, next step — plus her own conversation detail.", "内部路由标签；与他人的任何比较。", "Internal routing labels; any comparison with anyone else."],
  ["家长", "The family", "周期报告的成长叙事与就绪度。", "The period report's growth narrative and readiness.", "档位代号、象限标签、任何横向排名；对话明细（除非学生授权）。", "Band codes, quadrant labels, any ranking; conversation detail (unless the student grants it)."],
  ["教师", "The teacher", "判定与证据链接（可点开原始片段），并可一键改判。", "Judgments with evidence links that open the original fragment — and a one-click override.", "与教学无关的内容明细。", "Content detail with no bearing on teaching."],
  ["学校管理者", "School administration", "班级层的聚合读数。", "Class-level aggregates.", "任何个人对话明细。", "Any individual's conversation detail."],
];

/* What the measurement refuses to do. */
const honesty: [string, string, string, string, string][] = [
  ["01", "永不合成一个总分", "Never one composite score", "两根轴学理上是两个因子，测量上是两种形态，干预上指向相反的处方。加权平均掉，等于把最要紧的那条信息扔了。", "The axes are two factors in theory, two forms in measurement, and opposite prescriptions in practice. Averaging them throws away the one thing that mattered."],
  ["02", "不给预测分，不押题，不保分", "No predicted grades", "照作品的一侧只说该体系的官方语言，给出的是「离官方描述语还差哪几块证据」的就绪度。", "On the work's side we speak only that system's official language, and report readiness — which pieces of evidence are still missing."],
  ["03", "单次不判档，轨迹优先于快照", "Trajectory over snapshot", "一切表述使用「本周期观察到」的情境化语言，不做特质断言 —— 标签对发展中的孩子有自我实现的力量。", "Everything is phrased as “observed this period”, never as a trait. Labels have a self-fulfilling force on a person who is still forming."],
  ["04", "证据不够，就说不够", "Thin evidence says so", "没看到证据，只说明证据还在积累，不代表这个学生没有能力。「证据不足」这个显示态本身就是一项伦理设计。", "No evidence seen means evidence is still accumulating — it says nothing about ability. The “insufficient evidence” state is itself an ethical design decision."],
];
---

<PageBanner
  asset="banner/evaluation-design-v1.webp"
  eyebrow={["技术 · 评估设计", "Technology · the assessment design"]}
  title={[
    ["两根轴线，十二个维度，", "Two axes, twelve dimensions —"],
    ["一套有学理依据的评估框架。", "an assessment framework with a research lineage."],
  ]}
  lead={[
    "评估框架不是我们凭经验设计的：它来自批判性思维领域三十余年的实证共识——能力与倾向必须分开测量。我们把这条共识落成两根可观察、可追溯的轴线：认知深度看思考到达的层级，智识自主看无人要求时是谁在推动思考。",
    "This framework isn't drawn from our own intuition. It comes from three decades of empirical consensus in critical-thinking research — that ability and disposition have to be measured separately. We turn that consensus into two axes that can be observed and traced: cognitive depth reads the level the thinking reached, intellectual autonomy reads who is driving it when nobody asked.",
  ]}
  tone="g"
/>

<!-- ══════════════════════════════════════ WHY TWO AXES ══════════ -->
<section class="section">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">
        {t(lang, "这两根轴线的学理来历", "Where the two axes come from")}
      </h2>
      <p class="lead">
        {t(
          lang,
          "我们没有在学界共识之外另起炉灶，只是把三十多年的共识翻译成了可测量的坐标。",
          "We didn't start something new alongside the research consensus. We translated three decades of it into coordinates that can be measured.",
        )}
      </p>
    </div>

    <div class="rail" data-sequence data-step="150" style="margin-top:46px">
      {derivation.map(([k, zh, en, pz, pe]) => (
        <div class="rail-node" data-seq-item>
          <div class="k">{k}</div>
          <h4>{t(lang, zh, en)}</h4>
          <p>{t(lang, pz, pe)}</p>
        </div>
      ))}
    </div>

    <div class="grid-2" style="margin-top:52px">
      <div class="callout rv">
        <div class="cl"><Icon name="layers" />{t(lang, "认知深度 · Cognitive Depth", "Cognitive depth")}</div>
        <h3>{t(lang, "思考到达了第几层", "How far down the thinking got")}</h3>
        <p>
          {t(
            lang,
            "它不是技能之外的新构念，而是技能因子的测量形态 —— 把六项技能的表现放到同一把结构性标尺上读数，读出的那个量。",
            "Not a new construct alongside the skills, but the form in which those skills become measurable: the quantity you read when all six are placed against one structural ruler.",
          )}
        </p>
      </div>
      <div class="callout yes rv">
        <div class="cl"><Icon name="compass" />{t(lang, "智识自主 · Intellectual Autonomy", "Intellectual autonomy")}</div>
        <h3>{t(lang, "无人要求时，是谁在想", "Who is thinking when nobody asked")}</h3>
        <p>
          {t(
            lang,
            "也是唯一能在真实交互过程中被直接观察的那一面 —— 问卷测的是一个人对自己的描述，行为测的是他在无人注视时的选择。",
            "And the only face of them observable directly inside a real interaction: a questionnaire measures how someone describes himself; behaviour measures what he chooses when nobody is watching.",
          )}
        </p>
      </div>
    </div>

    <div class="pull rv" style="margin-top:52px; max-width:960px">
      {t(
        lang,
        "缺深度的自主，产出的是自信的垃圾；缺自主的深度，是一台租给任何提示者的好引擎。两样都要，而这正是它们不能合成一个分的理由。",
        "Autonomy without depth produces confident garbage. Depth without autonomy is a good engine rented to whoever prompts it. You need both — which is exactly why they cannot be scored as one.",
      )}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ THE D AXIS ════════ -->
<section class="section band-paper">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow" style="margin-bottom:16px"><span class="pip"></span>D-AXIS</div>
      <h2 class="sec-title">{t(lang, "认知深度：四个层级，和中间那个转折点", "Cognitive depth: four levels, and the turn in the middle")}</h2>
      <p class="lead">
        {t(
          lang,
          "它不是知识量，也不是答案的对错，而是思考本身的结构。进阶有一个可辨认的转折点 —— 反身性转向：先理解一个观点，再把「理解本身」作为分析对象。不仅问「这个观点是什么」，还继续问：它建立在哪些前提上？忽略了什么？谁从这种框定中受益？我为什么倾向于相信它？",
          "Not how much is known, nor whether the answer is right, but the structure of the thinking itself. The climb has one recognisable turn — the reflexive turn: first understand a claim, then make the understanding itself the object of analysis. Not only “what is this claim”, but: what does it rest on, what does it leave out, who benefits from this framing, and why am I inclined to believe it?",
        )}
      </p>
    </div>

    <div class="ladder rv" style="margin-top:44px">
      {rungs.slice(0, 2).map(([lv, zh, en, pz, pe]) => (
        <div class="rung">
          <div class="lv">{lv}<small>{t(lang, zh, en)}</small></div>
          <div>
            <h4>{t(lang, zh, en)}</h4>
            <p>{t(lang, pz, pe)}</p>
          </div>
        </div>
      ))}
      <div class="turn">
        <span class="tl"></span>
        <span class="tt">{t(lang, "反身性转向 · the reflexive turn", "the reflexive turn")}</span>
        <span class="tl"></span>
      </div>
      {rungs.slice(2).map(([lv, zh, en, pz, pe]) => (
        <div class="rung">
          <div class="lv">{lv}<small>{t(lang, zh, en)}</small></div>
          <div>
            <h4>{t(lang, zh, en)}</h4>
            <p>{t(lang, pz, pe)}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="grid-2" style="margin-top:44px; gap:22px">
      <div class="callout rv">
        <div class="cl"><Icon name="target" />{t(lang, "层级怎么判", "How a level is judged")}</div>
        <h3>{t(lang, "层级永远相对任务的开放度而判", "Always relative to how open the task is")}</h3>
        <p>
          {t(
            lang,
            "封闭任务封顶于「多点」—— 一道只有一个正确答案的题，本来就不给关联和反身留位置。所以低读数不一定是学生浅，也可能是任务没给机会。",
            "A closed task is capped at “several points”: a question with one right answer leaves no room for relating or reflexivity. So a low reading may not mean the student is shallow — it may mean the task never offered the chance.",
          )}
        </p>
      </div>
      <div class="callout rv">
        <div class="cl"><Icon name="spark" />{t(lang, "题目决定了上限", "The task sets the ceiling")}</div>
        <h3>{t(lang, "封闭的题目，读不出深的思考", "A closed task cannot show deep thinking")}</h3>
        <p>
          {t(
            lang,
            "所以教师那一侧的第一件事不是判读，而是设计机会：题目够不够开放、材料有没有冲突、反方有没有被放进房间里。读数是教师设计的回声。",
            "Which is why the teacher's first job is not reading the result but designing the opportunity: how open the task is, whether the material conflicts, whether the counter-case is in the room. The reading is an echo of the design.",
          )}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ THE A AXIS ════════ -->
<section class="section">
  <div class="container">
    <div class="sec-head rv">
      <div class="eyebrow" style="margin-bottom:16px"><span class="pip"></span>A-AXIS</div>
      <h2 class="sec-title">{t(lang, "智识自主：为什么课堂量不出它", "Intellectual autonomy: why a classroom can't measure it")}</h2>
      <p class="lead">
        {t(
          lang,
          "我们习惯把这些当作自主的证据：敢不敢质疑老师、会不会反驳权威、是否主动发言。但用测量学的语言说，这些信号被构念无关方差严重污染 —— 课堂上观测到的那个值，其实是四样东西的乘积。",
          "We are used to treating these as evidence of autonomy: challenging the teacher, arguing back at authority, speaking up. In measurement terms those signals are badly contaminated by construct-irrelevant variance — what a classroom observes is really the product of four things.",
        )}
      </p>
    </div>

    <div class="noiseq rv-pop" style="margin-top:44px">
      <div class="nt want">
        <b>{t(lang, "智识自主", "autonomy")}</b>
        <i>{t(lang, "想测的", "the construct")}</i>
      </div>
      <span class="op">×</span>
      <div class="nt"><b>{t(lang, "性格内外向", "extraversion")}</b><i>{t(lang, "噪声", "noise")}</i></div>
      <span class="op">×</span>
      <div class="nt"><b>{t(lang, "课堂文化规范", "classroom norms")}</b><i>{t(lang, "噪声", "noise")}</i></div>
      <span class="op">×</span>
      <div class="nt"><b>{t(lang, "语言表达自信", "verbal confidence")}</b><i>{t(lang, "噪声", "noise")}</i></div>
      <span class="op">=</span>
      <div class="nt"><b>{t(lang, "课堂行为", "classroom behaviour")}</b><i>{t(lang, "看得见的", "what's visible")}</i></div>
    </div>

    <div class="grid-2" style="margin-top:44px">
      <div class="rv">
        <h3 class="sub-title">{t(lang, "在东亚课堂，这一点格外尖锐", "In an East Asian classroom this bites harder")}</h3>
        <p class="body" style="margin-top:16px">
          {t(
            lang,
            "秩序、尊师与避免公开冲突是默认规范，公开质疑教师因此是一种高成本行为 —— 而高成本行为的缺席，不构成低自主的证据。反过来，爱发言、会反驳，也可能只是外向、表达好、喜欢赢过别人。会说不等于会判断，敢说也不等于有理由。",
            "Order, deference and avoiding open conflict are the default norms, which makes challenging a teacher publicly an expensive act — and the absence of an expensive act is not evidence of low autonomy. In reverse: a student who talks and argues a lot may simply be extraverted, articulate, or fond of winning. Speaking well is not judging well; speaking up is not having a reason.",
          )}
        </p>
      </div>
      <div class="rv">
        <h3 class="sub-title">{t(lang, "AI 交互是一个干净得多的观察场", "An AI conversation is a far cleaner site")}</h3>
        <p class="body" style="margin-top:16px">
          {t(
            lang,
            "对着 AI 提出质疑不需要勇气，邀请一个对手也不需要 —— 权威压力、课堂文化、公开表达的成本都被卸掉了，剩下的只有想不想较真本身。读数形式因此是行为信号分级（能力锚定 / 频率）加上「自发 / 引导」标记，并且只与学生自己的历史基线比较，从不与同班比较。",
            "Challenging an AI takes no courage, and neither does inviting an opponent: authority pressure, classroom culture and the cost of speaking publicly all fall away, and what's left is whether she wants to get it right. So the reading is a graded behavioural signal — ability-anchored or frequency-based — carrying a self-initiated / prompted marker, and it is only ever compared with the student's own history, never with her classmates.",
          )}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════ THE TWELVE POINTS ════════ -->
<section class="section band-cool">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">{t(lang, "十二个测量点", "The twelve measurement points")}</h2>
      <p class="lead">
        {t(
          lang,
          "D 轴看六类证据，A 轴看六个信号族。每一个测量点都配一句「它看什么」和一个「可观察的样子」—— 没有可观察的样子，就不是一个能测的东西。",
          "Six families of evidence on the depth axis, six families of signal on the autonomy axis. Each carries what it looks at and what it looks like when it happens — anything with no observable form is not something we can measure.",
        )}
      </p>
    </div>

    <div class="rv-pop" style="margin-top:44px">
      <DualAxis />
    </div>

    <div class="callout rv" style="margin-top:44px">
      <div class="cl"><Icon name="link" />{t(lang, "两根轴会同时记录", "Both axes record it")}</div>
      <h3>{t(lang, "同一件事，深度轴和自主轴各记一笔", "One event, written down once by each axis")}</h3>
      <p>
        {t(
          lang,
          "D2 与 A2 都涉及「核查」，但深度轴问的是核查得好不好，自主轴问的是核查由谁发起 —— 同一动作，两个读数，这是设计而非疏漏。一段让步段也一样：它既是 D3 / D4 的结构证据，也是 A6 的求真信号。",
          "D2 and A2 both involve checking, but the depth axis asks how well it was done and the autonomy axis asks who started it — one action, two readings, by design rather than by oversight. A concession works the same way: structural evidence for D3 and D4, and a truth-seeking signal for A6.",
        )}
      </p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ THE HONESTY ═══════ -->
<section class="section">
  <div class="container">
    <div class="grid-2" style="gap:64px; align-items:start">
      <div class="rv">
        <h2 class="sec-title">{t(lang, "我们明确不做的四件事", "Four things this measurement will not do")}</h2>
        <p class="lead" style="margin-top:22px">
          {t(
            lang,
            "一份论证判断力的产品，必须自己先经得起判断。所以有些事我们明确不做，并且把它写进系统权限，而不只是写进隐私政策。",
            "A product that makes claims about judgment has to survive being judged. So some things we explicitly don't do — and they're written into system permissions, not only into a privacy policy.",
          )}
        </p>
        <p class="body" style="margin-top:18px">
          {t(
            lang,
            "还有一条边界在人那里：任何可能影响学生重大利益的判断，都不由算法自动作出。判层以锚点样本库为准绳、以基准集定期回测；教师可以一键改判，改判数据回流用于纠错；学生与家长对任何评估结果都有异议通道。",
            "One boundary sits with people: no judgment that could affect a student's material interests is made automatically. Levels are held against an anchor sample library and re-tested on a benchmark set; a teacher can override in one click, and those overrides flow back as corrections. Students and families can contest any result.",
          )}
        </p>
      </div>

      <div class="stack rv">
        {honesty.map(([n, zh, en, pz, pe]) => (
          <div class="redline">
            <span class="rn">{n}</span>
            <div>
              <h4>{t(lang, zh, en)}</h4>
              <p>{t(lang, pz, pe)}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════ WHO SEES WHAT ════════ -->
<section class="section band-paper">
  <div class="container">
    <div class="sec-head rv">
      <h2 class="sec-title">{t(lang, "谁能看到什么", "Who is allowed to see what")}</h2>
      <p class="lead">
        {t(
          lang,
          "观测的唯一目的是教学引导与成长反馈：测量为学生的学习服务，不为对学生的筛选服务。双轴数据永不用于入学筛选、学生排名、纪律惩戒或教师绩效考核，也不出售、不用于任何形式的商业画像。",
          "The only purpose of observing is teaching and growth feedback: the measurement serves the student's learning, never a selection process. Axis data is never used for admissions, ranking, discipline or staff appraisal — and never sold or turned into a commercial profile.",
        )}
      </p>
    </div>

    <div class="tablewrap rv" style="margin-top:40px">
      <table class="dt">
        <thead>
          <tr>
            <th style="width:150px">{t(lang, "角色", "Role")}</th>
            <th>{t(lang, "看到什么", "Sees")}</th>
            <th>{t(lang, "永远看不到什么", "Never sees")}</th>
          </tr>
        </thead>
        <tbody>
          {visibility.map(([rz, re, sz, se, nz, ne]) => (
            <tr>
              <td class="k">{t(lang, rz, re)}</td>
              <td>{t(lang, sz, se)}</td>
              <td>{t(lang, nz, ne)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="small rv" style="margin-top:18px">
      {t(
        lang,
        "并且，测量对学生本人透明：他知道平台在观测什么、为什么观测。观测不是暗中进行的 —— 让孩子知道「什么值得被看」，本身就是元认知教育的一部分。",
        "And the measurement is transparent to the student: she knows what is being observed and why. None of it happens covertly — letting a young person know what is worth looking at is itself part of teaching metacognition.",
      )}
    </p>
  </div>
</section>

