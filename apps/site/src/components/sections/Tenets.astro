---
import Icon from "../Icon.astro";
import { getLang, t } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);

const tenets = [
  {
    icon: "leaf",
    zh: ["AI 会克制，不替学生下结论", "比起直接给答案，AI 更愿意在关键的时刻停下来，把问题交回给学生自己想。这份克制，是我们最在意的设计。"],
    en: ["The AI holds back — it won't conclude for the student", "Rather than hand over an answer, it would rather pause at the key moment and give the question back to the student. That restraint is the design we care about most."],
  },
  {
    icon: "anchor",
    zh: ["不操纵，也不让人上瘾", "我们想教会学生不被 AI 俘获，所以自己首先就不用连胜、排行榜、推送这些让人上瘾的把戏。工具卡什么时候出现由 AI 判断，但要不要打开，永远是学生说了算。"],
    en: ["No manipulation, no addiction", "We want students not to be captured by AI, so we refuse streaks, leaderboards and push notifications ourselves. The AI decides when a card appears, but whether to open it is always the student's call."],
  },
  {
    icon: "target",
    zh: ["一次只问一个问题", "陪练说话很简短，一次只抛一个问题——既更省成本，也守住学生自己的思考节奏。"],
    en: ["One question at a time", "The coach speaks briefly and asks just one thing at a time — cheaper to run, and it protects the student's own thinking rhythm."],
  },
  {
    icon: "activity",
    zh: ["每一步思考都值得被看见", "哪怕学生跳过工具卡、直接让 AI 回答，这个选择也会被记录下来。我们不会抹掉这些「犹豫」，反而把它们当作理解学生的线索。"],
    en: ["Every step of thinking is worth seeing", "Even skipping a card or letting AI answer directly gets recorded. We don't erase this hesitation — we treat it as a clue to how the student thinks."],
  },
];
---
<section class="section">
  <div class="container center">
    <div class="sec-label reveal">{t(lang, "我们坚持的四件事", "Four things we won't compromise on")}</div>
    <h2 class="sec-title reveal">{t(lang, "让我们和别的 AI 工具不一样的四件事", "What sets us apart from every other AI tool")}</h2>
    <p class="sec-sub reveal">{t(lang, "正是这几件事，让我们和那些「帮你更快交作业」的工具，走上了完全不同的路。", "These are exactly what put us on a different path from tools that just help you finish faster.")}</p>

    <div class="tenets">
      {tenets.map((it) => (
        <div class="tenet reveal">
          <div class="ti"><Icon name={it.icon} /></div>
          <div>
            <h4>{lang === "zh" ? it.zh[0] : it.en[0]}</h4>
            <p>{lang === "zh" ? it.zh[1] : it.en[1]}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
