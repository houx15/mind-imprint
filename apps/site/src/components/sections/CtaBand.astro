---
import { getLang, t } from "../../i18n/utils";
import { demoUrl, loginUrl } from "../../config";
const lang = getLang(Astro.currentLocale);
---
<section class="section tight">
  <div class="container">
    <div class="ctaband reveal">
      <h2>{t(lang, "亲眼看看，AI 怎么把问题交回给学生自己想", "See how the AI gives the question back to the student")}</h2>
      <p>{t(lang, "无需注册，以示例学生 Phoebe 的身份走一遍完整流程——收到工具卡、被一步步引导，最后拿到属于自己的思维印记。", "No sign-up. Walk the whole flow as our sample student Phoebe — receive a card, get guided step by step, and end with a mind imprint of your own.")}</p>
      <div class="cta-row">
        <a class="btn btn-lg btn-light" href={demoUrl}>{t(lang, "体验 Demo", "Try the demo")}</a>
        <a class="btn btn-lg btn-clear" href={loginUrl}>{t(lang, "登录", "Log in")}</a>
      </div>
    </div>
  </div>
</section>
