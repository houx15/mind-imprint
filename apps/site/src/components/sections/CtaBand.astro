---
import { getLang, t } from "../../i18n/utils";
import { demoUrl } from "../../config";
import { localePath } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);

interface Props {
  heading?: string;
  body?: string;
}
const { heading, body } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="ctaband rv-pop">
      <h2>{heading ?? t(lang, "即刻申请试用，开启 AI 原生人才培养之旅。", "Request a trial, and start growing AI-native learners.")}</h2>
      <p>
        {body ??
          t(
            lang,
            "Demo 里是一份真实素材：一条没有出处的推文，一路溯源到 NASA 与 Nature Sustainability。你会看到工具卡在什么时刻被递出来，也会看到最后的报告怎么写。",
            "The demo runs on real material: an unsourced post, traced all the way back to NASA and Nature Sustainability. You'll see when a card gets handed over — and what the final report says.",
          )}
      </p>
      <div class="cta-row center">
        <a class="btn btn-lg btn-light" href={demoUrl}>{t(lang, "体验 Demo", "Try the demo")}</a>
        <a class="btn btn-lg btn-clear" href={localePath(lang, "/about") + "#schools"}>
          {t(lang, "为学校接入", "For schools")}
        </a>
      </div>
    </div>
  </div>
</section>
