---
import Icon from "./Icon.astro";
import { getLang, t, localePath, switchLocaleUrl } from "../i18n/utils";
import { loginUrl, demoUrl } from "../config";

const lang = getLang(Astro.currentLocale);
const path = Astro.url.pathname;
const other = switchLocaleUrl(path, lang);
const key = path.replace(/^\/en(\/|$)/, "/").replace(/\/$/, "") || "/";
const active = (p: string) => (key === p ? "page" : undefined);

/**
 * Each product surface is its own page, so the dropdown is a real index of
 * them — no tab strip to discover after landing.
 */
type Sub = { href: string; zh: string; en: string; dzh: string; den: string };
type Link = { href: string; zh: string; en: string; items?: Sub[] };

const links: Link[] = [
  { href: "/", zh: "首页", en: "Home" },
  {
    href: "/product",
    zh: "解决方案",
    en: "Solution",
    items: [
      {
        href: "/product",
        zh: "完整案例",
        en: "The full case",
        dzh: "一个学生，一篇课题，从头走到尾",
        den: "One student, one piece of coursework, end to end",
      },
      {
        href: "/product/courses",
        zh: "AI 互动课程",
        en: "AI courses",
        dzh: "真实情境带练，习得思维工具",
        den: "Coached practice in real situations",
      },
      {
        href: "/product/projects",
        zh: "AI 写作教练",
        en: "AI writing coach",
        dzh: "AI 全过程支持，但从不代笔",
        den: "Supported end to end, never ghost-written",
      },
      {
        href: "/product/evaluation",
        zh: "过程评估报告",
        en: "Process assessment",
        dzh: "九大板块，认知深度与智识自主两轴",
        den: "Nine sections, and the two axes",
      },
      {
        href: "/product/teacher",
        zh: "教师端",
        en: "Teacher console",
        dzh: "全过程数据，可视化、可回溯",
        den: "The whole process, visible and reviewable",
      },
    ],
  },
  {
    href: "/algorithm",
    zh: "技术",
    en: "Technology",
    items: [
      {
        href: "/algorithm",
        zh: "技术总览",
        en: "Overview",
        dzh: "五层系统，从克制到评估",
        den: "Five layers, from restraint to assessment",
      },
      {
        href: "/algorithm/evaluation",
        zh: "评估算法设计",
        en: "The assessment design",
        dzh: "事实由系统算出，判断只能引用证据",
        den: "Facts computed, judgments bound to evidence",
      },
      {
        href: "/algorithm/multi-agent",
        zh: "多智能体教练系统",
        en: "The multi-agent coach",
        dzh: "一条会话走完全程，重活交给子代理",
        den: "One conversation throughout, heavy work isolated",
      },
    ],
  },
  { href: "/about", zh: "关于我们", en: "About" },
];
---

<nav class="site-nav">
  <a class="brand" href={localePath(lang, "/")}>
    <span class="mk"><Icon name="mark" /></span>{t(lang, "思维印记", "The Mark of Thinking")}
  </a>

  <div class="navlinks">
    {
      links.map((l) =>
        l.items ? (
          <div class="navitem">
            <a href={localePath(lang, l.href)} aria-current={active(l.href)}>
              {t(lang, l.zh, l.en)}
              <Icon name="arrow" class="ncaret" />
            </a>
            {/* Opened by hover and by keyboard focus alike — see :focus-within. */}
            <div class="navmenu">
              <div class="navmenu-in">
                {l.items.map((s) => (
                  <a href={localePath(lang, s.href)}>
                    <b>{t(lang, s.zh, s.en)}</b>
                    <span>{t(lang, s.dzh, s.den)}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={localePath(lang, l.href)} aria-current={active(l.href)}>
            {t(lang, l.zh, l.en)}
          </a>
        ),
      )
    }
  </div>

  <div class="navright">
    <a class="lang" href={other} aria-label="Switch language">
      {lang === "zh" ? <span><b>中</b> / EN</span> : <span>中 / <b>EN</b></span>}
    </a>
    <a class="btn btn-ghost" href={loginUrl}>{t(lang, "登录", "Log in")}</a>
    <a class="btn btn-primary" href={demoUrl}>{t(lang, "体验 Demo", "Try demo")}</a>
    <button class="navtoggle" data-navtoggle aria-expanded="false" aria-label={t(lang, "打开菜单", "Open menu")}>
      <Icon name="menu" />
    </button>
  </div>
</nav>

<div class="mobile-menu" data-mobilemenu>
  {
    links.map((l) => (
      <Fragment>
        <a href={localePath(lang, l.href)}>{t(lang, l.zh, l.en)}</a>
        {l.items && (
          <div class="mm-sub">
            {l.items.map((s) => (
              <a href={localePath(lang, s.href)}>{t(lang, s.zh, s.en)}</a>
            ))}
          </div>
        )}
      </Fragment>
    ))
  }
  <a href={other}>{t(lang, "English", "中文")}</a>
  <div class="cta-row">
    <a class="btn btn-lg btn-outline" href={loginUrl}>{t(lang, "登录", "Log in")}</a>
    <a class="btn btn-lg btn-primary" href={demoUrl}>{t(lang, "体验 Demo", "Try demo")}</a>
  </div>
</div>
