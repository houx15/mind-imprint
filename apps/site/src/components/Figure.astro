---
import Icon from "./Icon.astro";
import { assetUrl } from "../config";

/**
 * An image slot that is deliberately EMPTY until the real asset arrives.
 *
 * Two ways to fill it:
 *   asset="home/course-player.png"   → resolved through the site's CDN
 *                                      (or public/media/ in local dev)
 *   src="/media/whatever.png"        → a literal path, escape hatch
 *
 * Until one is given it renders a labelled placeholder, so the page composes
 * correctly and it is obvious which asset belongs where.
 */
interface Props {
  /** Stable slug for the asset, e.g. "course-player-cue". Shown in the empty state. */
  name: string;
  /** Media key served from the site's asset CDN, e.g. "home/course-player.png". */
  asset?: string;
  /** Literal URL/path, when the file is not in object storage. */
  src?: string;
  /** What the picture should show — a brief for whoever prepares it. */
  desc?: string;
  /** Aspect ratio class suffix: "16-9" | "4-3" | "3-2" | "1-1" | "21-9". */
  ratio?: "16-9" | "4-3" | "3-2" | "1-1" | "21-9";
  /** Caption rendered under the frame (visible in both states). */
  caption?: string;
  alt?: string;
  /** Extra classes on the frame (e.g. "rv-pop"). */
  class?: string;
}

const {
  name,
  asset,
  src,
  desc,
  ratio = "16-9",
  caption,
  alt,
  class: extra = "",
} = Astro.props;

const resolved = src ?? (asset ? assetUrl(asset) : undefined);
---

<figure class={`figure-block ${extra}`}>
  <div class={`figure ratio-${ratio}`} data-asset={name}>
    {resolved ? (
      <img
        src={resolved}
        alt={alt ?? caption ?? name}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="fslot">
        <div class="ficon"><Icon name="image" /></div>
        <div class="fname">{name}</div>
        {desc && <div class="fdesc">{desc}</div>}
      </div>
    )}
  </div>
  {caption && <figcaption class="figcaption">{caption}</figcaption>}
</figure>
