---
import Icon from "./Icon.astro";
import { getLang, t, localePath } from "../i18n/utils";
import { loginUrl, demoUrl } from "../config";

const lang = getLang(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="brand" href={localePath(lang, "/")}>
        <span class="mk"><Icon name="mark" /></span>{t(lang, "思维印记", "Mind Imprint")}
      </a>
      <p>
        {t(
          lang,
          "给中学生的 AI 学习空间。AI 时代稀缺的是判断——我们把判断发生的过程，第一次变成可看见、可追溯、可干预的证据。",
          "An AI workspace for secondary students. In the age of AI the scarce skill is judgment — we turn the process where judgment happens into evidence you can see, trace and act on.",
        )}
      </p>
    </div>

    <div class="foot-col">
      <h5>{t(lang, "了解", "Explore")}</h5>
      <a href={localePath(lang, "/product")}>{t(lang, "完整案例", "The full case")}</a>
      <a href={localePath(lang, "/algorithm")}>{t(lang, "技术 · 五层系统", "Technology · the five layers")}</a>
      <a href={localePath(lang, "/algorithm/evaluation")}>{t(lang, "评估算法设计", "The assessment design")}</a>
      <a href={localePath(lang, "/algorithm/multi-agent")}>{t(lang, "多智能体教练系统", "The multi-agent coach")}</a>
      <a href={localePath(lang, "/about")}>{t(lang, "关于我们", "About us")}</a>
    </div>

    <div class="foot-col">
      <h5>{t(lang, "解决方案", "Solution")}</h5>
      <a href={localePath(lang, "/product/courses")}>{t(lang, "课程与工具卡", "Courses & thinking cards")}</a>
      <a href={localePath(lang, "/product/projects")}>{t(lang, "探究性写作空间", "Inquiry writing space")}</a>
      <a href={localePath(lang, "/product/evaluation")}>{t(lang, "过程性评估报告", "Process assessment")}</a>
      <a href={localePath(lang, "/product/teacher")}>{t(lang, "教师端", "Teacher console")}</a>
    </div>

    <div class="foot-col">
      <h5>{t(lang, "开始", "Get started")}</h5>
      <a href={demoUrl}>{t(lang, "体验 Demo", "Try the demo")}</a>
      <a href={loginUrl}>{t(lang, "登录", "Log in")}</a>
      <a href={localePath(lang, "/about") + "#schools"}>{t(lang, "为学校接入", "For schools")}</a>
    </div>
  </div>

  <div class="foot-bottom">
    <span>© {year} {t(lang, "思维印记 Mind Imprint", "Mind Imprint")}</span>
    <span>
      {t(
        lang,
        "双轴分开测量 · 永不合成总分 · 不押题 · 不保分",
        "Two axes measured apart · never merged into one score · no predictions",
      )}
    </span>
  </div>
</footer>
