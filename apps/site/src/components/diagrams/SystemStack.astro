---
import { getLang, t } from "../../i18n/utils";
const lang = getLang(Astro.currentLocale);

// The five key algorithms, in the order a student meets them: a course that
// paces itself like a teacher, an agent trained to hold back, several agents
// sharing one project, support that changes with the stage, and an assessment
// that reads the whole thing back.
const bands: {
  y: number;
  cls: string;
  n: string;
  id: string;
  name: [string, string];
  desc: [string, string];
}[] = [
  {
    y: 52,
    cls: "box-p",
    n: "01",
    id: "course-workflow",
    name: ["拟人化的课程工作流", "Human-like course workflow"],
    desc: [
      "课程像老师那样推进：放材料、等她看完、追问、递一张卡、等她答完，再往下走。",
      "A course paces itself the way a teacher does: show the material, wait, ask, hand over a card, wait for the answer, move on.",
    ],
  },
  {
    y: 142,
    cls: "box-a",
    n: "02",
    id: "restraint-ladder",
    name: ["教育增强的 AI 智能体", "Education-enhanced AI agent"],
    desc: [
      "一次只问一个。该答的答，该提示的提示，该把思考还回去的时候，递出一张工具卡。",
      "One question at a time. It answers when answering helps, nudges when a nudge is enough, and hands a thinking card back when the thinking belongs to her.",
    ],
  },
  {
    y: 232,
    cls: "box-p",
    n: "03",
    id: "project-spine",
    name: ["多智能体协作", "Multi-agent assistance"],
    desc: [
      "一个智能体走过所有工作面，记忆不断线；需要吞下长文本时，才切给一个隔离的子代理。",
      "One agent walks every surface with an unbroken memory; work that must swallow a long text goes to an isolated sub-agent.",
    ],
  },
  {
    y: 322,
    cls: "box-a",
    n: "04",
    id: "stage-router",
    name: ["分阶段的 AI 支持", "Staged AI support"],
    desc: [
      "立题、阅读、写作、修订、回顾——每个阶段 AI 能做什么、不能做什么，都不一样。",
      "Framing, reading, writing, revising, review — what the AI may and may not do is different at every stage.",
    ],
  },
  {
    y: 412,
    cls: "box-g",
    n: "05",
    id: "evidence-index",
    name: ["过程评估", "Process evaluation"],
    desc: [
      "事实从记录里直接算出来，判断必须引用得到一条真实存在的证据。",
      "The facts compute straight from the record, and every judgment has to cite a fragment that actually exists.",
    ],
  },
];
---

<svg
  class="diagram"
  viewBox="0 0 980 570"
  role="img"
  aria-label={t(lang, "思维印记五个关键算法示意图", "The five key algorithms behind Mind Imprint")}
>
  <defs>
    <marker id="ss-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 1L9 5L0 9z" fill="#9aa2b2" />
    </marker>
    <marker id="ss-ar-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 1L9 5L0 9z" fill="#d98263" />
    </marker>
  </defs>

  <!-- the student's work moves down the left -->
  <text class="dm" x="66" y="38" text-anchor="middle">{t(lang, "她在学的东西", "her work")}</text>
  <path class="edge edge-hot draw" style="--len:500" d="M66 50 V536" marker-end="url(#ss-ar-a)" />
  <circle class="flow" r="4" style="offset-path:path('M66 50 V536'); --d:400" />

  <!-- what she leaves behind rises back up the right -->
  <text class="dm" x="906" y="38" text-anchor="middle">{t(lang, "留下的证据", "what she leaves")}</text>
  <path class="edge draw" style="--len:500; --d:500" d="M906 536 V50" marker-end="url(#ss-ar)" />
  <circle class="flow" r="4" style="offset-path:path('M906 536 V50'); --d:1400; fill:#4c9a82" />

  {bands.map((b, i) => (
    <Fragment>
      <rect class={`box ${b.cls}`} x="110" y={b.y} width="700" height="80" rx="16" />
      <text class="dm" x="134" y={b.y + 26}>{b.n}</text>
      <text class="dm" x="786" y={b.y + 26} text-anchor="end" style="font-size:9px; text-transform:none">{b.id}</text>
      <text class="dt" x="134" y={b.y + 52}>{t(lang, b.name[0], b.name[1])}</text>
      <text class="ds" x="134" y={b.y + 71}>{t(lang, b.desc[0], b.desc[1])}</text>
      {i < bands.length - 1 && (
        <path class="edge edge-d draw" style={`--len:12; --d:${600 + i * 120}`} d={`M460 ${b.y + 80} V${b.y + 90}`} />
      )}
    </Fragment>
  ))}

  <!-- what holds all five together -->
  <rect class="box box-n" x="110" y="504" width="700" height="46" rx="14" />
  <text class="dm" x="134" y="524">{t(lang, "贯穿五者的一条线", "THE THREAD THROUGH ALL FIVE")}</text>
  <text class="ds" x="134" y="541">
    {t(
      lang,
      "思维工具卡：一次由学生执行的工具调用 —— 它既是教学动作，也是被记录下来的那条证据",
      "The thinking card: a tool call whose executor is the student — at once the teaching move and the evidence of it",
    )}
  </text>
</svg>
