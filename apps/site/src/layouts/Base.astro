---
import "../styles/global.css";
// Loaded after global.css so the immersive hero wins on the cascade.
import "../styles/hero-immersive.css";
import IconSprite from "../components/IconSprite.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getLang, localePath } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  /**
   * Full-screen opening: the page owns the top of the viewport, so the nav
   * starts hidden and floats in once the reader has passed the hero.
   */
  immersive?: boolean;
}
const { title, description, immersive = false } = Astro.props;
const lang = getLang(Astro.currentLocale);

// hreflang alternates for the same page in both languages
const path = Astro.url.pathname;
const key = path.replace(/^\/en(\/|$)/, "/").replace(/\/$/, "") || "/";
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const zhHref = site + localePath("zh", key);
const enHref = site + localePath("en", key);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" hreflang="zh" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={immersive ? "immersive" : undefined}>
    <IconSprite />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // ---------------------------------------------------------------------
      // Scroll engine. Everything here is progressive enhancement: without JS
      // the page renders fully visible (reveal styles are scoped to html.js).
      // ---------------------------------------------------------------------
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // 1. Reveals — one observer for every entrance variant.
      const revealables = document.querySelectorAll<HTMLElement>(
        ".rv, .rv-line, .rv-pop",
      );
      const revealIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("in");
            revealIO.unobserve(e.target);
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );
      revealables.forEach((el) => revealIO.observe(el));

      // 2. Sequenced groups — children light up one after another.
      //    <div data-sequence data-step="140"> with .cn / .rail-node children.
      const seqIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const group = e.target as HTMLElement;
            const gap = Number(group.dataset.step || 150);
            const kids = group.querySelectorAll<HTMLElement>("[data-seq-item]");
            kids.forEach((kid, i) => {
              window.setTimeout(() => kid.classList.add("on"), reduced ? 0 : i * gap);
            });
            seqIO.unobserve(group);
          });
        },
        { threshold: 0.3 },
      );
      document
        .querySelectorAll<HTMLElement>("[data-sequence]")
        .forEach((el) => seqIO.observe(el));

      // 3. Scrub sections — the pinned-visual / stepped-copy pattern.
      //    The active step index is mirrored onto the .scrub container as
      //    data-active, which the sticky visual styles off.
      document.querySelectorAll<HTMLElement>(".scrub").forEach((scrub) => {
        const steps = Array.from(
          scrub.querySelectorAll<HTMLElement>(".scrub-step"),
        );
        if (!steps.length) return;
        const setActive = (idx: number) => {
          if (scrub.dataset.active === String(idx)) return;
          scrub.dataset.active = String(idx);
          steps.forEach((s, i) => s.classList.toggle("on", i === idx));
        };
        setActive(0);
        const stepIO = new IntersectionObserver(
          (entries) => {
            // Pick the entry with the most presence in the middle band.
            let bestIndex = -1;
            let bestRatio = -1;
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const i = steps.indexOf(e.target as HTMLElement);
              if (i < 0) return;
              if (e.intersectionRatio > bestRatio) {
                bestRatio = e.intersectionRatio;
                bestIndex = i;
              }
            });
            if (bestIndex >= 0) setActive(bestIndex);
          },
          { rootMargin: "-42% 0px -42% 0px", threshold: [0, 0.5, 1] },
        );
        steps.forEach((s) => stepIO.observe(s));
      });

      // 4. Nav gets a hairline once the page has scrolled.
      const nav = document.querySelector<HTMLElement>("nav.site-nav");
      if (nav) {
        // Visibility on immersive pages belongs to the hero script; this only
        // ever owns the hairline.
        const onScroll = () => nav.classList.toggle("stuck", window.scrollY > 12);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      // 5. Mobile menu.
      const toggle = document.querySelector<HTMLElement>("[data-navtoggle]");
      const menu = document.querySelector<HTMLElement>("[data-mobilemenu]");
      if (toggle && menu) {
        toggle.addEventListener("click", () => {
          const open = menu.classList.toggle("open");
          toggle.setAttribute("aria-expanded", String(open));
        });
        menu.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            menu.classList.remove("open");
            toggle.setAttribute("aria-expanded", "false");
          }),
        );
      }

      // 6. Count-up numbers on [data-count].
      const countIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            const target = Number(el.dataset.count || 0);
            countIO.unobserve(el);
            if (reduced) {
              el.textContent = String(target);
              return;
            }
            const dur = 1100;
            const t0 = performance.now();
            const tick = (now: number) => {
              const p = Math.min(1, (now - t0) / dur);
              // easeOutExpo
              const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
              el.textContent = String(Math.round(target * eased));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.6 },
      );
      document
        .querySelectorAll<HTMLElement>("[data-count]")
        .forEach((el) => countIO.observe(el));

      // 7. The two-axis explorer: pick a dimension, read what it looks at.
      //    Without JS the chips never render (CSS hides them) and the panel
      //    simply lists all twelve, so nothing here is load-bearing.
      document.querySelectorAll<HTMLElement>("[data-axisx]").forEach((root) => {
        const chips = Array.from(root.querySelectorAll<HTMLElement>(".axchip"));
        const dets = Array.from(root.querySelectorAll<HTMLElement>(".axdet"));
        const pick = (key: string) => {
          chips.forEach((c) => c.classList.toggle("on", c.dataset.k === key));
          dets.forEach((d) => d.classList.toggle("on", d.dataset.k === key));
        };
        chips.forEach((c) => {
          const go = () => pick(c.dataset.k || "");
          c.addEventListener("click", go);
          // Hovering reads the same as clicking; on touch only the click fires.
          c.addEventListener("mouseenter", go);
        });
      });

      // 8. Banner parallax — the artwork drifts slower than the page.
      //    .pb-media is inset beyond the frame, so this never exposes an edge.
      if (!reduced) {
        const layers = Array.from(
          document.querySelectorAll<HTMLElement>("[data-parallax]"),
        );
        if (layers.length) {
          let ticking = false;
          const place = () => {
            ticking = false;
            layers.forEach((l) => {
              const r = l.getBoundingClientRect();
              if (r.bottom < 0 || r.top > window.innerHeight) return;
              // 0 at the top of its travel, 1 once it has fully passed.
              const p = -r.top / (r.height + window.innerHeight);
              l.style.transform = `translate3d(0, ${(p * 64).toFixed(2)}px, 0)`;
            });
          };
          const onMove = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(place);
          };
          place();
          window.addEventListener("scroll", onMove, { passive: true });
          window.addEventListener("resize", onMove, { passive: true });
        }
      }

      // 9. Course catalogue filter. Cards carry their own tags, so filtering
      //     is a hidden flag — no re-render, no layout thrash.
      document.querySelectorAll<HTMLElement>("[data-catalog]").forEach((root) => {
        const btns = Array.from(root.querySelectorAll<HTMLElement>(".catbtn"));
        const cards = Array.from(root.querySelectorAll<HTMLElement>(".catcard"));
        const count = root.querySelector<HTMLElement>("[data-catcount]");
        const apply = (tag: string) => {
          let shown = 0;
          cards.forEach((c) => {
            const on = tag === "*" || (c.dataset.tags || "").split(" ").includes(tag);
            c.hidden = !on;
            if (on) shown++;
          });
          btns.forEach((b) =>
            b.setAttribute("aria-pressed", String(b.dataset.tag === tag)),
          );
          if (count) count.textContent = (count.dataset.catcountTpl || "{n}").replace("{n}", String(shown));
        };
        btns.forEach((b) =>
          b.addEventListener("click", () => apply(b.dataset.tag || "*")),
        );
        apply("*");
      });
    </script>
  </body>
</html>
