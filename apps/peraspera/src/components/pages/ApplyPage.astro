---
import LeadForm from "../LeadForm.astro";
import { getLang, t } from "../../i18n/utils";
import { hero, funnelIntro, funnel, formIntro } from "../../content/apply";

const lang = getLang(Astro.currentLocale);
---

<!-- ═══ Page hero ═══ -->
<header class="pagehero">
  <div class="container">
    <p class="eyebrow">{t(lang, hero.eyebrow.zh, hero.eyebrow.en)}</p>
    <h1>{t(lang, hero.title.zh, hero.title.en)}</h1>
    <p class="lead">{t(lang, hero.sub.zh, hero.sub.en)}</p>
  </div>
</header>

<!-- ═══ Funnel: 留资 → 说明会 → 一对一面谈 ═══ -->
<section class="section tight">
  <div class="container">
    <div class="center reveal">
      <p class="eyebrow" style="justify-content:center">{t(lang, funnelIntro.eyebrow.zh, funnelIntro.eyebrow.en)}</p>
      <h2 class="sec-title">{t(lang, funnelIntro.title.zh, funnelIntro.title.en)}</h2>
    </div>
    <ol class="funnel reveal">
      {funnel.map((step, i) => (
        <li class="funnel-step">
          <span class="funnel-num">{i + 1}</span>
          <h3>{t(lang, step.title.zh, step.title.en)}</h3>
          <p>{t(lang, step.body.zh, step.body.en)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═══ Form ═══ -->
<section class="section alt">
  <div class="container">
    <div class="center reveal">
      <p class="eyebrow" style="justify-content:center">{t(lang, formIntro.eyebrow.zh, formIntro.eyebrow.en)}</p>
      <h2 class="sec-title">{t(lang, formIntro.title.zh, formIntro.title.en)}</h2>
    </div>
    <div class="reveal" style="margin-top:44px">
      <LeadForm lang={lang} />
    </div>
  </div>
</section>

<style>
  /* Funnel steps: three numbered cards, the same visual family as the home
     page's pillars but with a circular step index instead of an arrow-link
     footer (no matching hook in global.css). */
  .funnel {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .funnel-step {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 32px 28px;
  }
  .funnel-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--primary-tint);
    border: 1px solid var(--primary-line);
    color: var(--primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .funnel-step h3 { margin: 18px 0 10px; }
  .funnel-step p { color: var(--ink-2); font-size: 0.98rem; }

  @media (max-width: 900px) {
    .funnel { grid-template-columns: 1fr; }
  }
</style>
