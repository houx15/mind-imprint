---
import { getLang, t, localePath } from "../../i18n/utils";
import {
  hero,
  mission,
  product,
  offerIntro,
  offers,
  beliefsIntro,
  beliefs,
  team,
  faqIntro,
  faqs,
  faqMore,
} from "../../content/home";

const lang = getLang(Astro.currentLocale);

// Split the headline around its accented fragment so we can wrap it in .em.
const headline = t(lang, hero.headline.zh, hero.headline.en);
const em = t(lang, hero.headlineEm.zh, hero.headlineEm.en);
const emIdx = headline.indexOf(em);
const headBefore = emIdx >= 0 ? headline.slice(0, emIdx) : headline;
const headAfter = emIdx >= 0 ? headline.slice(emIdx + em.length) : "";

// Same split for the product-screen heading (accented product name).
const prodHead = t(lang, product.heading.zh, product.heading.en);
const prodEm = t(lang, product.headingEm.zh, product.headingEm.en);
const prodIdx = prodHead.indexOf(prodEm);
const prodBefore = prodIdx >= 0 ? prodHead.slice(0, prodIdx) : prodHead;
const prodAfter = prodIdx >= 0 ? prodHead.slice(prodIdx + prodEm.length) : "";
---

<div class="home">
  <!-- ═══ 1 · Hero ═══ -->
  <section class="screen hero-screen">
    <div class="container">
      <p class="motto">{hero.motto}</p>
      <h1 class="hero-head">
        {headBefore}<span class="em">{em}</span>{headAfter}
      </h1>
      <p class="hero-lead">{t(lang, hero.sub.zh, hero.sub.en)}</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={localePath(lang, hero.ctaPrimary.href)}>
          {t(lang, hero.ctaPrimary.label.zh, hero.ctaPrimary.label.en)}
        </a>
        <a class="btn btn-outline btn-lg" href={localePath(lang, hero.ctaSecondary.href)}>
          {t(lang, hero.ctaSecondary.label.zh, hero.ctaSecondary.label.en)}
        </a>
      </div>
    </div>
    <a class="scroll-hint" href="#mission" aria-hidden="true">✦</a>
  </section>

  <!-- ═══ 2 · Mission ═══ -->
  <section id="mission" class="screen mission-screen">
    <div class="container reveal">
      <p class="sec-label">{mission.label}</p>
      <h2 class="mission-head">{t(lang, mission.heading.zh, mission.heading.en)}</h2>
      <p class="mission-body">{t(lang, mission.body.zh, mission.body.en)}</p>
    </div>
  </section>

  <!-- ═══ 3 · Our core product (思维印记) ═══ -->
  <section class="screen product-screen">
    <div class="container reveal">
      <p class="eyebrow">{t(lang, product.label.zh, product.label.en)}</p>
      <h2 class="sec-title product-head">
        {prodBefore}<span class="em">{prodEm}</span>{prodAfter}
      </h2>
      <p class="product-body">{t(lang, product.body.zh, product.body.en)}</p>
      <ol class="product-parts">
        {product.parts.map((p, i) => (
          <li class="product-part">
            <span class="part-num">{i + 1}</span>
            <div>
              <h3>{t(lang, p.name.zh, p.name.en)}</h3>
              <p>{t(lang, p.body.zh, p.body.en)}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="btn-ghost product-link" href={localePath(lang, product.href)}>
        {t(lang, product.cta.zh, product.cta.en)} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ═══ 4 · Three services built on the product ═══ -->
  <section class="screen offer-screen">
    <div class="container">
      <div class="reveal">
        <p class="eyebrow">{t(lang, offerIntro.label.zh, offerIntro.label.en)}</p>
        <h2 class="sec-title">{t(lang, offerIntro.heading.zh, offerIntro.heading.en)}</h2>
      </div>
      <div class="offer-grid reveal">
        {offers.map((o) => (
          <article class="offer-card">
            <h3>{t(lang, o.name.zh, o.name.en)}</h3>
            <p>{t(lang, o.body.zh, o.body.en)}</p>
            <a class="btn-ghost offer-link" href={localePath(lang, o.href)}>
              {t(lang, o.cta.zh, o.cta.en)}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 5 · What we believe (single language) ═══ -->
  <section class="screen belief-screen">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow" style="justify-content:center">{t(lang, beliefsIntro.label.zh, beliefsIntro.label.en)}</p>
        <h2 class="sec-title">{t(lang, beliefsIntro.heading.zh, beliefsIntro.heading.en)}</h2>
      </div>
      <div class="beliefs belief-grid reveal">
        {beliefs.map((b) => (
          <article class="belief-card">
            <span class="b-idx">{t(lang, b.tag.zh, b.tag.en)}</span>
            <h3>{t(lang, b.head.zh, b.head.en)}</h3>
            {b.body && <p>{t(lang, b.body.zh, b.body.en)}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 6 · Who we are ═══ -->
  <section class="screen team-screen">
    <div class="container reveal">
      <p class="eyebrow">{t(lang, team.label.zh, team.label.en)}</p>
      <h2 class="sec-title">{t(lang, team.heading.zh, team.heading.en)}</h2>
      <p class="team-intro">{t(lang, team.intro.zh, team.intro.en)}</p>
      <div class="team-grid">
        {team.members.map((m) => (
          <div class="member">
            <p class="member-name">{t(lang, m.name.zh, m.name.en)}</p>
            <p class="member-role">{t(lang, m.role.zh, m.role.en)}</p>
          </div>
        ))}
      </div>
      <a class="btn-ghost team-link" href={localePath(lang, team.href)}>
        {t(lang, team.cta.zh, team.cta.en)}
      </a>
    </div>
  </section>

  <!-- ═══ 7 · Questions ═══ -->
  <section class="screen faq-screen">
    <div class="container">
      <div class="reveal">
        <p class="eyebrow">{t(lang, faqIntro.label.zh, faqIntro.label.en)}</p>
        <h2 class="sec-title">{t(lang, faqIntro.heading.zh, faqIntro.heading.en)}</h2>
      </div>
      <div class="faq reveal">
        {faqs.map((f) => (
          <details>
            <summary>{t(lang, f.q.zh, f.q.en)}</summary>
            <div class="faq-body"><p>{t(lang, f.a.zh, f.a.en)}</p></div>
          </details>
        ))}
      </div>
      <div class="faq-foot reveal">
        <a class="link" href={`${localePath(lang, "/about")}#faq`}>
          {t(lang, faqMore.label.zh, faqMore.label.en)} <span class="star">→</span>
        </a>
        <a class="btn btn-primary" href={localePath(lang, "/contact")}>
          {t(lang, faqMore.contactLabel.zh, faqMore.contactLabel.en)}
        </a>
      </div>
    </div>
  </section>
</div>

<!-- Homepage-only document-level scroll snapping. The `.snap` utility in
     global.css only takes effect on a scroll container; the page's scroller is
     the document, so we enable snapping on `html` here (this component only ever
     renders on / and /en/). Gated exactly like `.snap`: desktop width + fine
     pointer + no reduced-motion — on phones/short windows it's off and screens
     flow naturally. `scroll-padding-top` keeps anchored screens clear of the
     sticky nav. -->
<style is:global>
  @media (min-width: 900px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    html { scroll-snap-type: y proximity; scroll-padding-top: 72px; }
    .home > .screen { scroll-snap-align: start; }
  }
</style>

<style>
  /* Every screen keeps its content clear of the sticky nav when jumped to. */
  .screen { scroll-margin-top: 72px; }
  .screen > .container { width: 100%; }

  /* 1 · Hero — big, left-aligned, confident. */
  .hero-screen { position: relative; }
  .hero-screen .motto { margin-bottom: 26px; }
  .hero-head {
    font-size: clamp(2.5rem, 5.4vw + 0.5rem, 4.75rem);
    letter-spacing: -0.03em;
    max-width: 18ch;
  }
  .hero-head .em { color: var(--primary); }
  .hero-lead {
    margin-top: 30px;
    max-width: 54ch;
    font-size: clamp(1.15rem, 1vw + 0.9rem, 1.45rem);
    color: var(--ink-2);
  }
  .scroll-hint {
    position: absolute; left: 50%; bottom: 34px; transform: translateX(-50%);
    color: var(--primary); font-size: 0.9rem; opacity: 0.7;
    animation: hint-float 2.4s ease-in-out infinite;
  }
  .scroll-hint:hover { opacity: 1; }
  @keyframes hint-float {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 7px); }
  }

  /* 2 · Mission — one large paragraph, generous measure. */
  .mission-screen { background: var(--paper-2); border-block: 1px solid var(--line); }
  .mission-head { margin-top: 18px; max-width: 20ch; }
  .mission-body {
    margin-top: 30px;
    max-width: 58ch;
    font-size: clamp(1.2rem, 0.9vw + 1rem, 1.6rem);
    line-height: 1.55;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  /* 3 · Core product — 思维印记, with its three parts. */
  .product-head { margin-top: 18px; max-width: 22ch; }
  .product-head .em { color: var(--primary); }
  .product-body {
    margin-top: 22px; max-width: 52ch;
    font-size: 1.15rem; color: var(--ink-2);
  }
  .product-parts {
    list-style: none; margin: 40px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }
  .product-part {
    display: flex; gap: 16px; align-items: flex-start;
    padding: 26px 24px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .product-part .part-num {
    flex: none;
    width: 30px; height: 30px; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;
    color: var(--primary);
    border: 1px solid var(--primary-line);
  }
  .product-part h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .product-part p { color: var(--ink-2); font-size: 0.98rem; line-height: 1.5; }
  .product-link { margin-top: 34px; display: inline-flex; }

  /* 4 · Offer — three navigational cards. */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 52px;
  }
  .offer-card {
    display: flex; flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--primary);
    border-radius: var(--r-lg);
    padding: 34px 30px;
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }
  .offer-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
    border-color: var(--primary-line);
    border-top-color: var(--primary);
  }
  .offer-card h3 { margin-bottom: 14px; }
  .offer-card p { color: var(--ink-2); font-size: 1rem; flex: 1; }
  .offer-card .offer-link { margin-top: 24px; align-self: flex-start; }

  /* 4 · Beliefs — 2×2, single language. */
  .belief-grid { grid-template-columns: repeat(2, 1fr); margin-top: 52px; }

  /* 5 · Who we are. */
  .team-intro { margin-top: 22px; max-width: 56ch; font-size: 1.15rem; color: var(--ink-2); }
  .team-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 22px; margin-top: 40px; max-width: 760px;
  }
  .member {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 26px 28px;
  }
  .member-name {
    font-family: var(--font-display); font-weight: 700; font-size: 1.35rem;
    color: var(--ink); letter-spacing: -0.01em;
  }
  .member-role { margin-top: 8px; font-size: 0.95rem; color: var(--muted); }
  .team-link { margin-top: 34px; display: inline-flex; }

  /* 6 · Questions. */
  .faq { margin-top: 44px; }
  .faq-foot {
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    justify-content: center; margin-top: 40px;
  }
  .faq-foot .star { font-style: normal; }

  @media (max-width: 900px) {
    .offer-grid, .belief-grid, .team-grid, .product-parts { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    /* On phones there is no snapping; keep vertical breathing room so short
       screens don't feel cramped and tall ones never clip. */
    .screen { padding-block: 88px; }
    .hero-screen { padding-block: 96px 72px; }
    .scroll-hint { display: none; }
  }
</style>
