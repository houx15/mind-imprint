---
import { getLang, t, localePath } from "../../i18n/utils";
import {
  hero,
  philosophy,
  solutionsIntro,
  solutions,
  miSummary,
  courseSystem,
  teacherTraining,
  closingCta,
} from "../../content/partnership";

const lang = getLang(Astro.currentLocale);
---

<!-- ═══ Page hero ═══ -->
<header class="pagehero">
  <div class="container">
    <p class="eyebrow">{t(lang, hero.eyebrow.zh, hero.eyebrow.en)}</p>
    <h1>{t(lang, hero.title.zh, hero.title.en)}</h1>
    <p class="lead">{t(lang, hero.sub.zh, hero.sub.en)}</p>
  </div>
</header>

<!-- ═══ 1 · philosophy ═══ -->
<section class="section tight" id="philosophy">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t(lang, philosophy.eyebrow.zh, philosophy.eyebrow.en)}</p>
      <h2 class="sec-title" style="max-width:22ch">{t(lang, philosophy.title.zh, philosophy.title.en)}</h2>
    </div>
    <div class="prose reveal">
      {philosophy.body.map((p) => <p>{t(lang, p.zh, p.en)}</p>)}
    </div>
    <div class="beliefs reveal">
      {philosophy.beliefs.map((b) => (
        <div class="belief-card">
          <span class="star">✦</span>
          <h4>{t(lang, b.title.zh, b.title.en)}</h4>
          <p>{t(lang, b.body.zh, b.body.en)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 2 · solution overview ═══ -->
<section class="section alt" id="solutions">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t(lang, solutionsIntro.eyebrow.zh, solutionsIntro.eyebrow.en)}</p>
      <h2 class="sec-title" style="max-width:none">{t(lang, solutionsIntro.title.zh, solutionsIntro.title.en)}</h2>
      <p class="sec-lead reveal">{t(lang, solutionsIntro.sub.zh, solutionsIntro.sub.en)}</p>
    </div>
    <div class="solutions">
      {solutions.map((s) => (
        <article class="solution-card reveal">
          <span class="solution-tag">{s.tag}</span>
          <h3>{t(lang, s.title.zh, s.title.en)}</h3>
          <p class="solution-body">{t(lang, s.body.zh, s.body.en)}</p>
          {s.items.length > 0 && (
            <div class="solution-items">
              {s.items.map((item) => (
                <div class="solution-item">
                  <h4>{t(lang, item.title.zh, item.title.en)}</h4>
                  <p>{t(lang, item.body.zh, item.body.en)}</p>
                </div>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══ 3a · detail: mind imprint summary + link to product page ═══ -->
<section class="section" id="mind-imprint">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t(lang, miSummary.eyebrow.zh, miSummary.eyebrow.en)}</p>
      <h2 class="sec-title" style="max-width:24ch">{t(lang, miSummary.title.zh, miSummary.title.en)}</h2>
    </div>
    <div class="prose reveal">
      {miSummary.body.map((p) => <p>{t(lang, p.zh, p.en)}</p>)}
      <p class="mi-pilot">{t(lang, miSummary.pilot.zh, miSummary.pilot.en)}</p>
    </div>
    <a class="mi-link reveal" href={localePath(lang, miSummary.linkHref)}>
      {t(lang, miSummary.linkLabel.zh, miSummary.linkLabel.en)}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<!-- ═══ 3b · detail: course system ═══ -->
<section class="section alt" id="course-system">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t(lang, courseSystem.eyebrow.zh, courseSystem.eyebrow.en)}</p>
      <h2 class="sec-title" style="max-width:none">{t(lang, courseSystem.title.zh, courseSystem.title.en)}</h2>
    </div>
    <div class="prose reveal">
      {courseSystem.body.map((p) => <p>{t(lang, p.zh, p.en)}</p>)}
    </div>
    <div class="modules reveal">
      {courseSystem.modules.map((m) => (
        <div class="module-card">
          <span class="module-code">{m.code}</span>
          <h4>{t(lang, m.name.zh, m.name.en)}</h4>
          <p>{t(lang, m.body.zh, m.body.en)}</p>
        </div>
      ))}
    </div>
    <p class="detail-closing reveal">{t(lang, courseSystem.closing.zh, courseSystem.closing.en)}</p>
  </div>
</section>

<!-- ═══ 3c · detail: teacher training ═══ -->
<section class="section" id="teacher-training">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">{t(lang, teacherTraining.eyebrow.zh, teacherTraining.eyebrow.en)}</p>
      <h2 class="sec-title" style="max-width:none">{t(lang, teacherTraining.title.zh, teacherTraining.title.en)}</h2>
    </div>
    <div class="prose reveal">
      {teacherTraining.body.map((p) => <p>{t(lang, p.zh, p.en)}</p>)}
    </div>
    <div class="training reveal">
      {teacherTraining.items.map((it, i) => (
        <div class="training-card">
          <span class="training-code">{String(i + 1).padStart(2, "0")}</span>
          <h4>{t(lang, it.title.zh, it.title.en)}</h4>
          <p>{t(lang, it.body.zh, it.body.en)}</p>
        </div>
      ))}
    </div>
    <p class="detail-closing reveal">{t(lang, teacherTraining.closing.zh, teacherTraining.closing.en)}</p>
  </div>
</section>

<!-- ═══ 4 · Closing CTA ═══ -->
<section class="section alt" id="contact">
  <div class="container">
    <div class="cta reveal">
      <h2>{t(lang, closingCta.title.zh, closingCta.title.en)}</h2>
      <p>{t(lang, closingCta.sub.zh, closingCta.sub.en)}</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={localePath(lang, closingCta.ctaHref)}>
          {t(lang, closingCta.ctaLabel.zh, closingCta.ctaLabel.en)}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* shared prose / lead */
  .prose {
    margin-top: 34px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 72ch;
  }
  .prose p { font-size: 1.0625rem; color: var(--ink-2); }
  .sec-lead { margin-top: 16px; color: var(--ink-2); font-size: 1.075rem; max-width: 60ch; }

  /* ---- 1 · philosophy beliefs -------------------------------------------- */
  .beliefs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }
  .belief-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 26px 24px;
  }
  .belief-card .star { font-size: 0.95rem; }
  .belief-card h4 { margin-top: 12px; color: var(--ink); }
  .belief-card p { margin-top: 10px; color: var(--ink-2); font-size: 0.95rem; max-width: none; }

  /* ---- 2 · two solution cards -------------------------------------------- */
  .solutions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 44px;
    align-items: start;
  }
  .solution-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 2px solid var(--primary-line);
    border-radius: var(--r-lg);
    padding: 34px 30px;
  }
  .solution-tag {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--primary);
  }
  .solution-card h3 { margin-top: 10px; margin-bottom: 14px; }
  .solution-body { color: var(--ink-2); font-size: 1rem; max-width: none; }
  .solution-items {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .solution-item h4 { color: var(--ink); }
  .solution-item p { margin-top: 5px; color: var(--ink-2); font-size: 0.92rem; max-width: none; }

  /* ---- 3a · mind-imprint summary + link to product page ----------------- */
  .mi-pilot { color: var(--muted); font-size: 0.98rem; }
  .mi-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 30px;
    font-weight: 600;
    font-size: 1.0125rem;
    color: var(--primary);
  }
  .mi-link span { transition: transform 0.2s ease; }
  .mi-link:hover span { transform: translateX(3px); }

  /* ---- 3b · course modules ----------------------------------------------- */
  .modules { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
  .module-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 26px 24px;
  }
  .module-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--primary);
    letter-spacing: 0.06em;
  }
  .module-card h4 { margin-top: 10px; color: var(--ink); }
  .module-card p { margin-top: 10px; color: var(--ink-2); font-size: 0.92rem; max-width: none; }

  /* ---- 3c · teacher training --------------------------------------------- */
  .training { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px; }
  .training-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 2px solid var(--primary-line);
    border-radius: var(--r-lg);
    padding: 28px 26px;
  }
  .training-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--primary);
    letter-spacing: 0.06em;
  }
  .training-card h4 { margin-top: 10px; color: var(--ink); }
  .training-card p { margin-top: 10px; color: var(--ink-2); font-size: 0.94rem; max-width: none; }

  .detail-closing {
    margin-top: 34px;
    font-size: 1.0125rem;
    color: var(--ink-2);
    max-width: 70ch;
  }

  /* ---- responsive -------------------------------------------------------- */
  @media (max-width: 900px) {
    .beliefs, .solutions, .modules, .training { grid-template-columns: 1fr; }
  }
</style>
