---
import { getLang, t, localePath } from "../../i18n/utils";
import {
  hero,
  mindImprintIntro,
  oneLiner,
  howItWorksIntro,
  howItWorks,
  redLinesIntro,
  redLines,
  demoCta,
  originIntro,
  origin,
  researchIntro,
  researchCards,
  stanceIntro,
  stance,
} from "../../content/institute";

const lang = getLang(Astro.currentLocale);
---

<!-- ═══ Page hero ═══ -->
<header class="pagehero">
  <div class="container">
    <p class="eyebrow">{t(lang, hero.eyebrow.zh, hero.eyebrow.en)}</p>
    <h1>{t(lang, hero.title.zh, hero.title.en)}</h1>
    <p class="lead">{t(lang, hero.sub.zh, hero.sub.en)}</p>
  </div>
</header>

<!-- ═══ Mind Imprint ═══ -->
<section class="section" id="mind-imprint">
  <div class="container">
    <div class="center reveal">
      <p class="eyebrow" style="justify-content:center">{t(lang, mindImprintIntro.eyebrow.zh, mindImprintIntro.eyebrow.en)}</p>
      <h2 class="sec-title">{t(lang, mindImprintIntro.title.zh, mindImprintIntro.title.en)}</h2>
    </div>

    <!-- one-liner -->
    <div class="imprint-oneliner reveal">
      <p class="oneliner-head">{t(lang, oneLiner.headline.zh, oneLiner.headline.en)}</p>
      <p class="oneliner-body">{t(lang, oneLiner.body.zh, oneLiner.body.en)}</p>
    </div>

    <!-- four-step how-it-works -->
    <div class="reveal" style="margin-top:76px">
      <p class="eyebrow">{t(lang, howItWorksIntro.eyebrow.zh, howItWorksIntro.eyebrow.en)}</p>
      <h3 class="sec-title" style="max-width:none">{t(lang, howItWorksIntro.title.zh, howItWorksIntro.title.en)}</h3>
    </div>
    <div class="steps reveal">
      {howItWorks.map((s) => (
        <article class="step">
          <span class="step-num">{s.step}</span>
          <h4>{t(lang, s.title.zh, s.title.en)}</h4>
          <p>{t(lang, s.desc.zh, s.desc.en)}</p>
        </article>
      ))}
    </div>

    <!-- three design red lines -->
    <div class="reveal" style="margin-top:76px">
      <p class="eyebrow">{t(lang, redLinesIntro.eyebrow.zh, redLinesIntro.eyebrow.en)}</p>
      <h3 class="sec-title" style="max-width:none">{t(lang, redLinesIntro.title.zh, redLinesIntro.title.en)}</h3>
    </div>
    <div class="redlines reveal">
      {redLines.map((r) => (
        <article class="belief-card redline-card">
          <h3>{t(lang, r.title.zh, r.title.en)}</h3>
          <p>{t(lang, r.desc.zh, r.desc.en)}</p>
        </article>
      ))}
    </div>

    <!-- demo CTA -->
    <div class="demo-cta reveal">
      <p class="eyebrow" style="justify-content:center">{t(lang, demoCta.eyebrow.zh, demoCta.eyebrow.en)}</p>
      <h3>{t(lang, demoCta.title.zh, demoCta.title.en)}</h3>
      <p>{t(lang, demoCta.body.zh, demoCta.body.en)}</p>
      <a class="btn btn-primary btn-lg" href={localePath(lang, demoCta.href)}>
        {t(lang, demoCta.label.zh, demoCta.label.en)}
      </a>
    </div>

    <!-- origin -->
    <div class="reveal" style="margin-top:76px">
      <p class="eyebrow" style="justify-content:center">{t(lang, originIntro.eyebrow.zh, originIntro.eyebrow.en)}</p>
      <h3 class="sec-title center-title">{t(lang, originIntro.title.zh, originIntro.title.en)}</h3>
    </div>
    <p class="origin-body reveal">{t(lang, origin.zh, origin.en)}</p>
  </div>
</section>

<!-- ═══ Public research ═══ -->
<section class="section alt" id="research">
  <div class="container">
    <div class="center reveal">
      <p class="eyebrow" style="justify-content:center">{t(lang, researchIntro.eyebrow.zh, researchIntro.eyebrow.en)}</p>
      <h2 class="sec-title">{t(lang, researchIntro.title.zh, researchIntro.title.en)}</h2>
      <p class="sec-lead">{t(lang, researchIntro.body.zh, researchIntro.body.en)}</p>
    </div>

    <div class="research-cards reveal">
      {researchCards.map((c) => (
        <a class="research-card" href={localePath(lang, c.href)}>
          <h3>{t(lang, c.title.zh, c.title.en)}</h3>
          <p>{t(lang, c.blurb.zh, c.blurb.en)}</p>
          <span class="research-card-link">{t(lang, "阅读完整研究", "Read the full research")} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>

    <!-- stance -->
    <div class="stance reveal">
      <p class="eyebrow" style="justify-content:center">{t(lang, stanceIntro.eyebrow.zh, stanceIntro.eyebrow.en)}</p>
      <h3 class="sec-title center-title">{t(lang, stanceIntro.title.zh, stanceIntro.title.en)}</h3>
      <p class="stance-body">{t(lang, stance.zh, stance.en)}</p>
    </div>
  </div>
</section>

<style>
  /* One-liner: the flagship claim, set big — echoes .pullquote's editorial
     weight but centered and without the accent border, since it isn't a
     quotation. */
  .imprint-oneliner {
    max-width: 720px;
    margin: 44px auto 0;
    text-align: center;
  }
  .oneliner-head {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw + 0.6rem, 2.4rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: none;
  }
  .oneliner-body {
    margin-top: 20px;
    font-size: 1.0625rem;
    color: var(--ink-2);
    max-width: none;
  }

  /* Four-step how-it-works: numbered cards, distinct from the belief-card
     grid by a large tabular-numeral badge in place of the b-idx pip. */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 36px;
  }
  .step {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 26px 22px;
  }
  .step-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--primary-line);
    font-variant-numeric: tabular-nums;
    margin-bottom: 14px;
  }
  .step h4 { margin-bottom: 8px; }
  .step p { font-size: 0.92rem; color: var(--ink-2); }

  /* Red lines: reuse .belief-card, no numbering — these are trust
     guarantees, not a sequence. */
  .redlines {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 36px;
  }
  .redline-card h3 { font-size: 1.15rem; }

  /* Demo CTA: a quiet bordered box (not the dark .cta band — this isn't the
     page's closing call, just one section's action). */
  .demo-cta {
    margin-top: 56px;
    text-align: center;
    background: var(--primary-tint);
    border: 1px solid var(--primary-line);
    border-radius: var(--r-lg);
    padding: clamp(36px, 5vw, 52px);
  }
  .demo-cta h3 { margin-top: 4px; }
  .demo-cta p {
    margin: 14px auto 26px;
    max-width: 52ch;
    color: var(--ink-2);
  }

  .center-title { margin-left: auto; margin-right: auto; }
  .origin-body {
    max-width: 680px;
    margin: 28px auto 0;
    text-align: center;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink-2);
  }

  /* Research preview cards: navigational, like the home page's pillars, but
     the whole card is the link (no separate ghost-link row). */
  .research-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 52px;
  }
  .research-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 32px 30px;
    border-top: 3px solid var(--primary);
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }
  .research-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
    border-color: var(--primary-line);
    border-top-color: var(--primary);
  }
  .research-card h3 { margin-bottom: 12px; }
  .research-card p { color: var(--ink-2); font-size: 1rem; flex: 1; }
  .research-card-link {
    margin-top: 22px;
    align-self: flex-start;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--primary);
  }

  .stance {
    margin-top: 76px;
    text-align: center;
  }
  .stance-body {
    max-width: 720px;
    margin: 28px auto 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .redlines { grid-template-columns: 1fr; }
    .research-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
