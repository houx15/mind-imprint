# HTTP listen port
PORT=8080

# Postgres DSN, e.g. postgres://user:pass@localhost:5432/mindimprint?sslmode=disable
DATABASE_URL=

# Comma-separated list of allowed SPA origins, e.g. http://localhost:5173
CORS_ORIGINS=

# LLM provider keys (server-side only; never sent to the browser)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Voice (Volcano Engine TTS/ASR; server-side only). Both VOICE_APP_ID and
# VOICE_ACCESS_KEY must be set or the /voice/* routes return 503. From a Volcano
# voice app: VOICE_APP_ID = the app's App ID, VOICE_ACCESS_KEY = its Access Token.
# VOICE_TTS_VOICE must be a 音色 (speaker) activated on the app for the seed-tts-2.0
# resource — e.g. zh_female_vv_uranus_bigtts. The two RESOURCE_ID vars default to
# seed-tts-2.0 / volc.bigasr.sauc.duration and rarely need overriding.
VOICE_APP_ID=
VOICE_ACCESS_KEY=
VOICE_TTS_VOICE=
# VOICE_TTS_RESOURCE_ID=seed-tts-2.0
# VOICE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# OSS (Aliyun object storage; server-side only). All five OSS_ACCESS/ENDPOINT
# vars must be set or the /oss/* routes return 503. The AccessKey pair authorizes
# presigned uploads/reads; it never reaches the browser. OSS_ADMIN_KEY is a
# separate static bearer secret authorizing the admin upload route used by
# backend scripts — empty disables that route (503).
OSS_ENDPOINT=mind-imprint.oss-cn-beijing.aliyuncs.com
OSS_BUCKET=mind-imprint
OSS_CDN_DOMAIN=mind-oss.uni-robot.cn
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ADMIN_KEY=

# CDN URL鉴权 (Aliyun CDN "Type A" URL signing; server-side only). Signs course
# asset URLs so the CDN-fronted bucket can be private (no anonymous read from
# OSS origin). Empty disables signing (CDN falls back to whatever origin ACL
# is configured — set the bucket to private-read + configure this key before
# relying on it). Window is the signature's validity in seconds; the host
# refreshes signed URLs before they expire.
OSS_CDN_AUTH_KEY=
OSS_CDN_AUTH_WINDOW=7200
