    {
      "stepId": "step_04",
      "provider": "manual",
      "model": "json-published-cache",
      "updatedAt": "2026-07-31T09:48:11.306Z",
      "content": {
        "title": "独立评估：专家 Dr Rogelj（You do）",
        "subtitle": "学生基本独立完成CRRAAB评估，AI退到只反馈。这是收尾，检验学生是否真正掌握。",
        "segments": [
          {
            "kind": "teaching",
            "flow_block_id": "block_01",
            "text": "现在进入独立评估。Dr. Rogelj 是气候科学家，我们要判断的不是“专家一定可信”，而是他的话为什么值得相信、又有哪些边界。",
            "asset_ids": [],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_02",
            "text": "先独立看他的表达：他是否给出证据来源，是否说明概率和不确定性，是否把复杂问题说成绝对结论。",
            "asset_ids": [],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_03",
            "text": "完成第一轮判断后，把注意力放到“专家如何表达不确定性”。可信专家不会把风险说成百分百确定，而会说明模型、区间和证据限制。",
            "asset_ids": [],
            "items": []
          },
          {
            "kind": "structure",
            "flow_block_id": "block_04",
            "text": "所以，评估专家信源时，不能因为有头衔就直接采信；要看他的专业位置、证据来源、审查机制，以及是否诚实呈现不确定性。",
            "asset_ids": [],
            "items": [
              {
                "label": "专业位置",
                "text": "他是否在相关领域有真实研究经验"
              },
              {
                "label": "证据机制",
                "text": "他说法是否连接数据、模型或公开研究"
              },
              {
                "label": "边界意识",
                "text": "他是否说明不确定性，而不是把判断说满"
              }
            ]
          }
        ],
        "interactions": [
          {
            "id": "indep_q1",
            "type": "multiple_choice",
            "prompt": "判断 Dr. Rogelj 的权威性时，哪些线索值得保留？",
            "options": [
              {
                "id": "A",
                "text": "他是否是相关领域研究者"
              },
              {
                "id": "B",
                "text": "他说法是否连接研究、模型或数据"
              },
              {
                "id": "C",
                "text": "他是否承认预测中的不确定性"
              },
              {
                "id": "D",
                "text": "只要出现博士头衔，就不需要继续判断"
              }
            ],
            "correct_answer": [
              "A",
              "B",
              "C"
            ],
            "explanation": "专家可信度来自专业位置、证据连接和边界意识，不是单靠头衔。",
            "remediation_questions": []
          },
          {
            "id": "indep_q2",
            "type": "multiple_choice",
            "prompt": "专家表达中哪些特征会提高可信度？",
            "options": [
              {
                "id": "A",
                "text": "公开说明概率、范围或不确定性"
              },
              {
                "id": "B",
                "text": "把判断说得绝对，不留任何余地"
              },
              {
                "id": "C",
                "text": "说明结论来自哪些证据或研究机制"
              },
