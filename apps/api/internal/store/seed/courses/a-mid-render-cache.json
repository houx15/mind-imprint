      "provider": "manual",
      "model": "json-published-cache",
      "updatedAt": "2026-07-31T09:48:11.304Z",
      "content": {
        "title": "AI示范：评估《经济学人》机构（I do）",
        "subtitle": "给学生一个完整的CRRAAB评估范例，展示如何将六维框架应用于出版机构信源，建立“好评估长什么样”的样板。",
        "segments": [
          {
            "kind": "teaching",
            "flow_block_id": "block_01",
            "text": "现在进入机构信源示范。我们看《经济学人》的背景资料：它是历史悠久的国际新闻周刊，有编辑传统、读者定位和明确立场。评估机构时，不是只问它有名没名，而是看它怎样生产信息、怎样承担声誉成本。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_02",
            "text": "先看时效性。创刊时间很早不代表内容陈旧，关键是它现在是否持续更新、是否能回应正在发生的问题。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_03",
            "text": "《经济学人》是周刊，内容持续更新，所以时效性通常可以接受。这里要区分“机构历史久”和“信息过时”这两件事。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_04",
            "text": "再看相关性。它覆盖政治、经济、科技和社会议题，但相关性不能泛泛而谈，仍要回到具体文章和具体任务。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_05",
            "text": "如果研究问题与公共议题、经济政策或国际新闻有关，它往往有相关性；如果任务要求原始研究数据，它就不能替代论文或一手资料。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_06",
            "text": "接着看信誉。机构说错话会损失读者、订阅、公共声誉和专业信任，这些代价会倒逼它建立编辑标准。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_07",
            "text": "信誉不是“名气大所以可信”，而是它是否长期接受公开检验，是否有纠错和编辑机制，是否承担说错的成本。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_08",
            "text": "权威性要看机构在相关领域是否有持续报道能力、编辑网络和专业积累。匿名写作形成的是机构声音，这能增强一致性，也会让具体作者责任不那么清楚。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_09",
            "text": "准确性要继续追问证据来源。事实核查传统能提高可信度，但课堂判断不能停在“它看起来专业”，还要看文章有没有引用数据、专家或原始材料。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "teaching",
            "flow_block_id": "block_10",
            "text": "最后看偏见。它有自己的读者群、编辑立场和价值倾向，因此可信机构也可能选择性强调某些角度。可靠不等于中立无偏。",
            "asset_ids": [
              "doc_img_06"
            ],
            "items": []
          },
          {
            "kind": "structure",
            "flow_block_id": "block_11",
            "text": "所以，机构信源的价值在于稳定的编辑标准和声誉约束；它的限制在于立场、受众和选题角度。评估时要同时看到这两面。",
            "asset_ids": [],
            "items": [
              {
                "label": "机制",
                "text": "是否有持续发布和编辑标准"
              },
              {
                "label": "代价",
                "text": "说错是否会损失声誉和信任"
              },
              {
                "label": "立场",
                "text": "可靠机构仍可能有选择性角度"
              }
            ]
          }
        ],
        "interactions": [
          {
            "id": "demo_predict_C",
            "type": "single_choice",
            "prompt": "判断机构时效性时，哪种说法更合理？",
            "options": [
              {
                "id": "A",
                "text": "创刊年代早，所以内容一定过时"
              },
              {
                "id": "B",
                "text": "看它是否持续更新并回应当前问题"
              },
              {
                "id": "C",
                "text": "只看网站设计是否现代"
              },
              {
                "id": "D",
                "text": "只看机构是否有名"
              }
            ],
            "correct_answer": [
              "B"
            ],
            "explanation": "时效性看信息是否及时更新、是否适合当前任务，不是看机构年龄。",
            "remediation_questions": []
          },
          {
            "id": "demo_predict_R",
            "type": "single_choice",
            "prompt": "判断相关性时，哪一步最关键？",
            "options": [
              {
                "id": "A",
                "text": "把机构内容和自己的具体研究任务对应起来"
              },
              {
                "id": "B",
                "text": "只要是大媒体就默认相关"
              },
              {
                "id": "C",
                "text": "只看标题里有没有同一个关键词"
              },
              {
                "id": "D",
                "text": "跳过任务，先看文章长短"
              }
            ],
            "correct_answer": [
              "A"
            ],
            "explanation": "相关性必须回到具体任务：这条材料能不能回答我要判断的问题。",
            "remediation_questions": []
          },
          {
            "id": "demo_predict_R2",
            "type": "single_choice",
            "prompt": "机构的信誉主要来自哪里？",
            "options": [
              {
                "id": "A",
                "text": "版面看起来专业"
              },
              {
                "id": "B",
                "text": "长期公开发布、接受读者和同行检验，并承担说错的声誉成本"
              },
              {
                "id": "C",
                "text": "文章语气很肯定"
              },
              {
                "id": "D",
                "text": "名字听起来像权威机构"
              }
            ],
            "correct_answer": [
              "B"
            ],
            "explanation": "信誉来自可被检验的发布机制和声誉成本，而不是表面包装。",
            "remediation_questions": []
          }
        ],
        "student_question": "",
        "expected_response": "",
        "board": []
      },
