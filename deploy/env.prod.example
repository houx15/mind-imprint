# Copy to deploy/.env.prod (git-ignored) on the server and fill in real values.
# Used for docker compose variable substitution AND passed into the api container:
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build
#
# The secret values are the same ones in apps/api/.env.local.

# --- Postgres (containerized; internal to the compose network only) ---
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- CORS: SPA origin(s) allowed to call the API with credentials (comma-sep) ---
CORS_ORIGINS=https://mind-web.uni-robot.cn

# --- Public origin of the API, baked into the web bundle at build time ---
VITE_API_BASE_URL=https://mind-api.uni-robot.cn

# --- LLM provider key (server-side only; same value as apps/api/.env.local) ---
DEEPSEEK_API_KEY=
# Optional second provider
ANTHROPIC_API_KEY=

# --- Voice (Volcano Engine) — optional; blank disables voice (routes 503) ---
VOICE_APP_ID=
VOICE_ACCESS_KEY=
VOICE_TTS_VOICE=zh_female_vv_uranus_bigtts
