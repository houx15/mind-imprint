# Copy to deploy/.env.prod (git-ignored) on the server and fill in real values.
# Used for docker compose variable substitution AND passed into the api container:
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build
#
# The secret values are the same ones in apps/api/.env.local.

# --- Postgres (containerized; internal to the compose network only) ---
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- CORS: SPA origin(s) allowed to call the API with credentials (comma-sep) ---
CORS_ORIGINS=https://mind-web.uni-robot.cn

# --- Public origin of the API, baked into the web bundle at build time ---
VITE_API_BASE_URL=https://mind-api.uni-robot.cn

# --- LLM provider keys (server-side only; same values as apps/api/.env.local) ---
# PAI is the aggregator the lanes bind to by default (one key: Qwen / DeepSeek /
# GLM / Kimi). With it blank the lanes fall back to the direct vendor endpoints
# below, so adding this key is what actually moves traffic onto PAI.
PAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional second provider
ANTHROPIC_API_KEY=

# --- Per-lane model overrides (blank = the models.json binding) ---
# e.g. MODEL_CHAT=pai/qwen3.8-max. `api --print-models` shows the catalog.
MODEL_CHAT=
MODEL_FAST_CHAT=
MODEL_EVAL=

# --- Voice (Volcano Engine) — optional; blank disables voice (routes 503) ---
VOICE_APP_ID=
VOICE_ACCESS_KEY=
VOICE_TTS_VOICE=zh_female_vv_uranus_bigtts

# --- OSS (Aliyun object storage) — optional; blank AccessKey disables /oss/* (503) ---
OSS_ENDPOINT=mind-imprint.oss-cn-beijing.aliyuncs.com
OSS_BUCKET=mind-imprint
OSS_CDN_DOMAIN=mind-oss.uni-robot.cn
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Static bearer secret for the admin upload route (backend scripts). Blank → 503.
OSS_ADMIN_KEY=
