    "id": "guided-opcvl",
    "title": "带练：拉斯·卡萨斯与日志相互校正",
    "slices": [
     {
      "id": "las-casas-contrast",
      "title": "一次只问一维",
      "blocks": [
       {
        "id": "las-casas-images",
        "type": "images",
        "items": [
