# Marketing-site object storage — copy to .deploy-local/site-oss.env (git-ignored)
# and fill in the real values.
#
#   cp deploy/site-oss.env.example .deploy-local/site-oss.env
#
# This is the SITE's bucket only. The student platform uses a different bucket,
# a different CDN host and a different key pair (deploy/.env.prod, consumed by
# the Go API). Keep them apart — nothing here should ever be pointed at course
# material, and these keys must never appear in deploy/.env.prod.
#
# Used ONLY by deploy/upload-site-assets.sh, which runs from a developer
# machine. Nothing in this file is needed to build or serve the site: the
# bucket is private, but the CDN is authorised to read it, so visitors fetch
# plain URLs and the container holds no credential.

# Bucket + endpoint. The Aliyun console shows the endpoint with the bucket
# already prefixed; either form works.
OSS_BUCKET=mind-open
OSS_ENDPOINT=mind-open.oss-cn-beijing.aliyuncs.com

# Upload credentials. Prefer a RAM user scoped to PutObject on this bucket only.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Public CDN origin for the same bucket. This value (and only this one) is also
# passed to the site build as PUBLIC_ASSET_BASE_URL — it is public by design.
ASSET_BASE_URL=https://mind-assets.uni-robot.cn

# Cache-Control written onto uploaded objects. Filenames are not content-hashed,
# so keep this modest and version a changed image by key (hero-v2.png) rather
# than overwriting and waiting out the CDN.
# ASSET_CACHE_CONTROL=public, max-age=86400
